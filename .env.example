# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgres://apivo:apivo@localhost:5432/apivo?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=dev
LOG_LEVEL=info
# JWT verification for the editorial endpoints. JWKS_URL is not a secret: it
# names where the auth provider publishes its PUBLIC keys. Leave it unset to
# run without the editorial endpoints — they are not mounted, every
# /api/v1/editorial/ route answers 404, the api logs an ERROR line saying so
# at startup, and the reader endpoints keep serving. JWT_AUDIENCE is optional
# and only meaningful alongside JWKS_URL (setting it alone fails startup).
# Both values below are placeholders — replace the project reference.
#JWKS_URL=https://PLACEHOLDER_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
#JWT_AUDIENCE=authenticated

# web/ (Astro server): where the reader pages find the Go API. Leave unset
# to preview the reader screens from built-in fixtures (until T023/T024).
#API_BASE_URL=http://localhost:8080
