# Copy to .env for local development. Never commit real credentials.
# sslmode=disable belongs to THIS file and nowhere else: it describes the
# compose Postgres on a loopback address. With APP_ENV=prod the binary
# refuses to start on a URL that permits an unencrypted session - use
# sslmode=verify-full against a managed database (docs/RELEASING.md).
DATABASE_URL=postgres://apivo:apivo@localhost:5432/apivo?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=dev
LOG_LEVEL=info
# JWT verification for the editorial endpoints. JWKS_URL is not a secret: it
# names where the auth provider publishes its PUBLIC keys. Left EMPTY the
# editorial endpoints are not mounted — every /api/v1/editorial/ route answers
# 404, the api logs an ERROR line saying so at startup, and the reader
# endpoints keep serving. Set it to enable them, e.g.
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json
JWKS_URL=
# Optional, and only alongside a non-empty JWKS_URL (an audience without a
# verification endpoint fails startup). Supabase tokens: authenticated
JWT_AUDIENCE=

# How often the api polls the licensed feeds, as a Go duration (e.g. 15m,
# 1h). Left EMPTY the binary uses its documented 15m default; POLL_INTERVAL=0
# disables the poll loop entirely and is the ONLY disable switch (there is no
# POLL_ENABLED). With replicated api processes a Postgres advisory lock keeps
# exactly one poller active per cycle.
POLL_INTERVAL=

# Machine translation (T018). NO DEFAULTS on purpose: every key below except
# the interval must be set deliberately, or the translation pipeline stays
# OFF and the api logs one line saying so - the provider and the budget are
# a founder decision, and nothing picks either by accident. All empty is the
# documented off state; setting only some of them is a mistake the api names
# at startup (ERROR, listing the missing keys).
#
# TRANSLATION_BASE_URL is any OpenAI-compatible chat-completions root, e.g.
# https://<host>/v1; TRANSLATION_MODEL is the model as that host names it.
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
# The provider credential. A REAL SECRET - never commit it. Optional even
# when everything else is set: a self-hosted server started without a key
# expects none.
TRANSLATION_API_KEY=
# The host's published prices in USD per million tokens (e.g. 0.05). They
# turn reported token usage into the cost recorded with every translation
# (FR-006). A zero price is rejected: a host that charges nothing is
# declared with TRANSLATION_FREE_OF_CHARGE=true, never with a price line a
# forgotten value could imitate.
TRANSLATION_INPUT_USD_PER_MTOK=
TRANSLATION_OUTPUT_USD_PER_MTOK=
TRANSLATION_FREE_OF_CHARGE=
# The FR-006 budget, in micro-USD (1e6 = $1). The alpha's working numbers
# are 20000 ($0.02 per article) and 25000000 ($25 per month); the pipeline
# refuses a costlier article and halts the month at the cap. Zero is
# rejected - to keep the pipeline off, leave the keys unset.
TRANSLATION_ARTICLE_CEILING_MICROUSD=
TRANSLATION_MONTHLY_CAP_MICROUSD=
# Pipeline cadence, exactly like POLL_INTERVAL: empty means the binary's
# 15m default, "0" disables the pipeline and is the only disable switch.
TRANSLATION_INTERVAL=

# ===========================================================================
# Cashback (ADR-0002, ADR-0003)
#
# The values below are the DOCKER-FREE local path, and they are the defaults
# on purpose. Docker Desktop is unavailable on the founder's machine, so the
# configuration most likely to be copied out of this file has to be the one
# that works without a container: an in-memory ledger and a fixture affiliate
# network. Flip CASHBACK_ENABLED to true and the catalogue, click-out, entry
# state machine, wallet and payout orchestration all run with nothing else
# installed.
#
# What does NOT run on that path: the Blnk conformance suite, the
# cross-schema zero-sum check, and every DATABASE_URL-keyed invariant test.
# Those are expected skips. Do not chase them locally - CI is the
# verification of record and says so in every pull request.
# ===========================================================================

# Whether the cashback product exists in this process at all. The flag
# controls route MOUNTING, not navigation: with it false the cashback routes
# do not exist and answer 404, exactly as the editorial routes do without
# JWKS_URL. There is no half-on state and no per-route switch.
CASHBACK_ENABLED=false

# Which implementation of the ledger port backs the wallet. Three exist and
# all three are kept working, which is what makes the ledger swappable in
# under five engineer-days rather than only claimed to be (ADR-0002):
#
#   memory    in-process, no Postgres, no container. THE LOCAL DEFAULT, and
#             the only driver that runs with Docker unavailable.
#   blnk      the adopted Blnk service, started by `make cashback-up`. Needs
#             BLNK_URL and REDIS_URL below. Refused under APP_ENV=prod
#             without BLNK_SECRET_KEY.
#   postgres  the documented exit route, kept working so the adoption
#             decision stays reversible in days rather than months.
#
# A member-facing number is NEVER computed anywhere but from ledger postings,
# whichever of the three is selected. That is invariant C-1, and it is the one
# invariant that lives outside our own schema - see ADR-0002 for the trade,
# stated plainly rather than discovered later.
LEDGER_DRIVER=memory

# The two house accounts the cashback design names: where the sub-minor-unit
# remainder of a percent earning accrues (D6 - so every split still sums to
# zero and the rounding is never lost), and where a loss absorbed after a
# post-payout reversal is recorded (Q3 - the member is never chased). In
# production - every deployed environment runs APP_ENV=prod - both are
# REQUIRED once CASHBACK_ENABLED=true and the api refuses to start without
# them; locally the no-Docker loop runs with neither. They must differ
# everywhere: one account carrying both purposes would merge two figures the
# design keeps separate, and the api refuses to start on a shared name.
#
# Set them once and leave them alone - renaming a house account later strands
# whatever balance had accrued under the old name.
HOUSE_ACCOUNT_ROUNDING=rounding-remainder
HOUSE_ACCOUNT_CLAWBACK=clawback-loss

# And where an earning is paid OUT of: the account holding the commission a
# network has reported (FR-040). The member's share moves out of it, the
# sub-minor-unit rounding moves to the account above, and what stays is
# Apivo's own cut - so there is no separate revenue account to reconcile
# against a balance that already answers the same question.
#
# Required in production on the same terms as the other two, distinct from
# both, and set once: renaming it strands whatever commission had accrued.
HOUSE_ACCOUNT_NETWORK_RECEIVABLE=network-receivable

# The confirmed balance a member must reach before they may ask to be paid
# (FR-050). Q5 left the figure to configuration because it is a commercial
# decision that changes without a deploy.
#
# Two keys for one value, and the api refuses to start on one without the
# other. A threshold is money, and an amount with no currency is a number
# somebody compares a balance against - right until the day a second currency
# is published (C-6). Minor units, so 2000 EUR is twenty euros.
#
# Zero is legitimate and means any confirmed balance may be withdrawn, which
# is why the pair is what says whether a threshold was configured rather than
# the number being non-zero. REQUIRED in production, on the same terms as the
# house accounts above; locally the no-Docker loop runs without one.
PAYOUT_THRESHOLD_MINOR=2000
PAYOUT_THRESHOLD_CURRENCY=EUR

# Which affiliate network adapter the poller uses.
#
#   fixture   a scripted click -> pending -> approved -> reversed lifecycle
#             served from recorded responses. Needs no credentials, which is
#             what lets the whole money path be built and demonstrated before
#             a publisher account is approved (ADR-0003). THE LOCAL DEFAULT,
#             and the safe default everywhere while founder question Q1 -
#             which networks to join - is open.
#   awin      the live Awin adapter. Requires the credentials below.
#
# Polling is the ONLY thing that creates a credit. A webhook may shorten
# latency by triggering a targeted poll; it never moves money on its own.
NETWORK_DRIVER=fixture

# The header your edge sets to carry the real client address, for the
# privacy-minimised context digest a click records (FR-022) and for the
# per-device half of the click rule (US7 scenario 1).
#
# Empty locally, and it should stay empty: nothing is in front of the api
# here, so the digest is the caller's own address, which is already the
# right one. Set it only where a proxy sets the header itself AND strips any
# inbound copy - a header a client can set is a context a client can choose.
# Empty leaves the per-device half of the rule off; the per-member half
# always applies.
#CLICK_CONTEXT_HEADER=

# Where the Blnk ledger and its Redis are, when LEDGER_DRIVER=blnk. Both are
# ignored on the memory and postgres drivers.
#
# BOTH ARE COMMENTED OUT, and that is the point: LEDGER_DRIVER above is
# `memory`, and the api REFUSES TO START with BLNK_URL set beside a ledger
# that is not Blnk -
#
#   "config: BLNK_URL is set but LEDGER_DRIVER is \"memory\", so no posting
#    would ever reach that ledger; select \"blnk\" or unset BLNK_URL"
#
# That rule is well-formedness, not completeness, so it applies even with
# CASHBACK_ENABLED=false. An earlier revision of this file stated the rule in
# this very comment and then shipped the value that breaks it, so copying
# .env.example to .env - the documented first step for a new contributor -
# crashed the api at startup. An example that does not work as written is
# worse than no example.
#
# Uncomment both when switching to the Blnk ledger, together with
# LEDGER_DRIVER=blnk and `make cashback-up`.
#
# On a deployed environment neither is an operator's choice: the Hetzner
# compose overlay and the Kubernetes cashback ConfigMap set them from the
# container and Service names they chose. Two answers to "where is the
# ledger" would disagree the first time one was edited in a hurry.
#BLNK_URL=http://localhost:5001
#REDIS_URL=redis://localhost:6379

# What the api presents to the ledger on every call. A REAL SECRET.
#
# Optional locally and in CI, where the ledger sits on a loopback address and
# runs unauthenticated. NOT optional on any deployed environment: they all run
# APP_ENV=prod, and the api refuses to start with cashback enabled and this
# unset - "a ledger reachable without a credential is a ledger anybody on that
# network can post to, and postings are money".
#
# It must equal the ledger's own BLNK_SERVER_SECRET_KEY. Two halves of one
# setting: that one makes the ledger demand a credential, this one makes the
# api present it.
BLNK_SECRET_KEY=

# Affiliate network credentials. ONE set, named for the role each value plays
# rather than for a particular network: the adapter selected by NETWORK_DRIVER
# reads them and decides what they mean. REAL SECRETS - never commit them.
#
# These are the keys the binary reads (internal/platform/config/cashback.go).
# NETWORK_ACCOUNT_ID is not itself a credential and is logged in clear; the
# other two are wrapped in a Secret, so a log line prints whether each is set
# and never what it is (ADR-0003).
#
# Empty is the documented state for the two credentials: with
# NETWORK_DRIVER=fixture nothing reads them. Select a live adapter without
# NETWORK_ACCOUNT_ID and NETWORK_API_KEY and the api refuses to start, naming
# what is missing - cashback moves members' money, so it starts fully
# configured or not at all.
#
# NETWORK_ACCOUNT_ID is different from the other two, and it is the key that
# turns INGESTION on. Setting it is what makes the api poll: it names a row of
# cashback.network_account, which owns the two durable cursors, and the
# fixture adapter needs it as much as a live one does - an adapter that needs
# no credential still polls on behalf of somebody. Leave it empty and the api
# serves normally and says at ERROR that no network is being polled.
#
# Two things have to exist in the database before a poll does anything, and
# neither is configuration:
#
#   insert into cashback.network_account
#       (network_id, external_publisher_id, credential_ref, active, backfill_from)
#   values ('fixture', 'publisher-1', 'config:networks.fixture.credential',
#           true, '2026-06-01T00:00:00Z');
#
# `active` is false by default, so a half-configured account cannot start
# fetching; `backfill_from` is where an account nobody has polled starts
# reading, and nothing invents it - too recent silently skips history, too old
# asks a network for years of it. Every sweep refuses by name until both are
# set, and both are fixed with one UPDATE and no restart.
#
# Turning ingestion on also needs a BIGGER CONNECTION POOL. The scheduler
# holds one connection per running job and one for its work, plus two in
# reserve, so three jobs need eight - and pgx defaults to four. Add
# ?pool_max_conns=8 to DATABASE_URL, or the api refuses to start with the
# numbers in the error.
NETWORK_ACCOUNT_ID=
NETWORK_API_KEY=
NETWORK_API_SECRET=

# web/ (Astro server): where the reader pages find the Go API. Leave unset
# to preview the reader screens from built-in fixtures (until T023/T024).
#API_BASE_URL=http://localhost:8080

# web/ (Astro server): Supabase Auth for the editorial sign-in. The anon key
# is public by design — it identifies the project and grants nothing on its
# own — so neither of these is a credential. Left EMPTY the sign-in page says
# the deployment has no auth configured, and the editorial screens keep their
# fixture preview; the api's JWKS_URL above is the matching half.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
