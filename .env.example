# Copy to .env for local development. Never commit real credentials.
# sslmode=disable belongs to THIS file and nowhere else: it describes the
# compose Postgres on a loopback address. With APP_ENV=prod the binary
# refuses to start on a URL that permits an unencrypted session - use
# sslmode=verify-full against a managed database (docs/RELEASING.md).
DATABASE_URL=postgres://apivo:apivo@localhost:5432/apivo?sslmode=disable
HTTP_ADDR=:8080
APP_ENV=dev
LOG_LEVEL=info
# JWT verification for the editorial endpoints. JWKS_URL is not a secret: it
# names where the auth provider publishes its PUBLIC keys. Left EMPTY the
# editorial endpoints are not mounted — every /api/v1/editorial/ route answers
# 404, the api logs an ERROR line saying so at startup, and the reader
# endpoints keep serving. Set it to enable them, e.g.
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json
JWKS_URL=
# Optional, and only alongside a non-empty JWKS_URL (an audience without a
# verification endpoint fails startup). Supabase tokens: authenticated
JWT_AUDIENCE=

# How often the api polls the licensed feeds, as a Go duration (e.g. 15m,
# 1h). Left EMPTY the binary uses its documented 15m default; POLL_INTERVAL=0
# disables the poll loop entirely and is the ONLY disable switch (there is no
# POLL_ENABLED). With replicated api processes a Postgres advisory lock keeps
# exactly one poller active per cycle.
POLL_INTERVAL=

# Machine translation (T018). NO DEFAULTS on purpose: every key below except
# the interval must be set deliberately, or the translation pipeline stays
# OFF and the api logs one line saying so - the provider and the budget are
# a founder decision, and nothing picks either by accident. All empty is the
# documented off state; setting only some of them is a mistake the api names
# at startup (ERROR, listing the missing keys).
#
# TRANSLATION_BASE_URL is any OpenAI-compatible chat-completions root, e.g.
# https://<host>/v1; TRANSLATION_MODEL is the model as that host names it.
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
# The provider credential. A REAL SECRET - never commit it. Optional even
# when everything else is set: a self-hosted server started without a key
# expects none.
TRANSLATION_API_KEY=
# The host's published prices in USD per million tokens (e.g. 0.05). They
# turn reported token usage into the cost recorded with every translation
# (FR-006). A zero price is rejected: a host that charges nothing is
# declared with TRANSLATION_FREE_OF_CHARGE=true, never with a price line a
# forgotten value could imitate.
TRANSLATION_INPUT_USD_PER_MTOK=
TRANSLATION_OUTPUT_USD_PER_MTOK=
TRANSLATION_FREE_OF_CHARGE=
# The FR-006 budget, in micro-USD (1e6 = $1). The alpha's working numbers
# are 20000 ($0.02 per article) and 25000000 ($25 per month); the pipeline
# refuses a costlier article and halts the month at the cap. Zero is
# rejected - to keep the pipeline off, leave the keys unset.
TRANSLATION_ARTICLE_CEILING_MICROUSD=
TRANSLATION_MONTHLY_CAP_MICROUSD=
# Pipeline cadence, exactly like POLL_INTERVAL: empty means the binary's
# 15m default, "0" disables the pipeline and is the only disable switch.
TRANSLATION_INTERVAL=

# ===========================================================================
# Cashback (ADR-0002, ADR-0003)
#
# The values below are the DOCKER-FREE local path, and they are the defaults
# on purpose. Docker Desktop is unavailable on the founder's machine, so the
# configuration most likely to be copied out of this file has to be the one
# that works without a container: an in-memory ledger and a fixture affiliate
# network. Flip CASHBACK_ENABLED to true and the catalogue, click-out, entry
# state machine, wallet and payout orchestration all run with nothing else
# installed.
#
# What does NOT run on that path: the Blnk conformance suite, the
# cross-schema zero-sum check, and every DATABASE_URL-keyed invariant test.
# Those are expected skips. Do not chase them locally - CI is the
# verification of record and says so in every pull request.
# ===========================================================================

# Whether the cashback product exists in this process at all. The flag
# controls route MOUNTING, not navigation: with it false the cashback routes
# do not exist and answer 404, exactly as the editorial routes do without
# JWKS_URL. There is no half-on state and no per-route switch.
CASHBACK_ENABLED=false

# Which implementation of the ledger port backs the wallet. Three exist and
# all three are kept working, which is what makes the ledger swappable in
# under five engineer-days rather than only claimed to be (ADR-0002):
#
#   memory    in-process, no Postgres, no container. THE LOCAL DEFAULT, and
#             at present the only driver that runs locally at all.
#   blnk      the adopted Blnk service. NOT AVAILABLE LOCALLY YET: nothing in
#             docker-compose.yml starts a Blnk or a Redis until issue #149
#             lands, so `make cashback-up` fails with a message saying so and
#             this driver has nothing to point at. Needs BLNK_URL and
#             REDIS_URL below once it does.
#   postgres  the documented exit route, kept working so the adoption
#             decision stays reversible in days rather than months.
#
# A member-facing number is NEVER computed anywhere but from ledger postings,
# whichever of the three is selected. That is invariant C-1, and it is the one
# invariant that lives outside our own schema - see ADR-0002 for the trade,
# stated plainly rather than discovered later.
LEDGER_DRIVER=memory

# Which affiliate network adapter the poller uses.
#
#   fixture   a scripted click -> pending -> approved -> reversed lifecycle
#             served from recorded responses. Needs no credentials, which is
#             what lets the whole money path be built and demonstrated before
#             a publisher account is approved (ADR-0003). THE LOCAL DEFAULT,
#             and the safe default everywhere while founder question Q1 -
#             which networks to join - is open.
#   awin      the live Awin adapter. Requires the credentials below.
#
# Polling is the ONLY thing that creates a credit. A webhook may shorten
# latency by triggering a targeted poll; it never moves money on its own.
NETWORK_DRIVER=fixture

# Where the Blnk ledger and its Redis are, when LEDGER_DRIVER=blnk. Both are
# ignored on the memory and postgres drivers - which is every driver that
# runs locally today, so nothing reads either of these yet. The containers
# they address arrive with issue #149; `make cashback-up` starts them once it
# does, and fails with a message naming that issue until then.
#
# On a deployed environment neither of these is an operator's choice: the
# Hetzner compose overlay and the Kubernetes cashback ConfigMap set them from
# the container and Service names they chose. Two answers to "where is the
# ledger" would disagree the first time one was edited in a hurry.
BLNK_URL=http://localhost:5001
REDIS_URL=redis://localhost:6379

# Affiliate network credentials, one set per network account, named
# NETWORK_<NETWORK>_<KEY>. REAL SECRETS - never commit them. They never enter
# the database or the repository, and the logging package redacts them
# (ADR-0003).
#
# Awin appears because ADR-0003 takes it as the reference network, not because
# it has been chosen. Empty is the documented state: with NETWORK_DRIVER=
# fixture nothing reads them, and naming a live adapter without them is a
# configuration error the api reports at startup rather than a poller that
# silently fetches nothing.
NETWORK_AWIN_PUBLISHER_ID=
NETWORK_AWIN_API_TOKEN=

# web/ (Astro server): where the reader pages find the Go API. Leave unset
# to preview the reader screens from built-in fixtures (until T023/T024).
#API_BASE_URL=http://localhost:8080

# web/ (Astro server): Supabase Auth for the editorial sign-in. The anon key
# is public by design — it identifies the project and grants nothing on its
# own — so neither of these is a credential. Left EMPTY the sign-in page says
# the deployment has no auth configured, and the editorial screens keep their
# fixture preview; the api's JWKS_URL above is the matching half.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
