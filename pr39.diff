+++ b/deploy/k8s/api-service.yaml
@@ -0,0 +1,19 @@
+# ClusterIP only — the api is never publicly routable (contract topology).
+# No Ingress references this Service, and the type must stay ClusterIP
+# (never NodePort or LoadBalancer).
+apiVersion: v1
+kind: Service
+metadata:
+  name: api
+  labels:
+    app.kubernetes.io/name: api
+    app.kubernetes.io/part-of: apivo-news
+spec:
+  type: ClusterIP
+  selector:
+    app.kubernetes.io/name: api
+    app.kubernetes.io/part-of: apivo-news
+  ports:
+    - name: http
+      port: 8080
+      targetPort: http
