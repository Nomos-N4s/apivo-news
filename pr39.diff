+++ b/deploy/k8s/configmap.yaml
@@ -0,0 +1,19 @@
+# Non-secret runtime configuration for the Go api.
+#
+# Parity with local development (.env.example / docker-compose.yml):
+#   HTTP_ADDR  — same key as .env.example; the api listens on :8080 here too.
+#   APP_ENV    — .env.example uses "dev"; the cluster runs "production".
+#   LOG_LEVEL  — same default as .env.example.
+#   DATABASE_URL is deliberately absent: it is a credential and lives in the
+#   Secret (see secret.yaml).
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: apivo-config
+  labels:
+    app.kubernetes.io/name: apivo-config
+    app.kubernetes.io/part-of: apivo-news
+data:
+  HTTP_ADDR: ":8080"
+  APP_ENV: "production"
+  LOG_LEVEL: "info"
diff --git a/deploy/k8s/secret.yaml b/deploy/k8s/secret.yaml
new file mode 100644
index 0000000..c0cb0ca
--- /dev/null
+++ b/deploy/k8s/secret.yaml
@@ -0,0 +1,21 @@
+# STRUCTURE-ONLY STUB — never put a real credential in this file.
+#
+# The value below is a placeholder so the manifest set is self-describing and
+# validates. In a real cluster this Secret is created out of band (see
+# README.md) with the Supabase (EU) connection string:
+#
+#   kubectl -n apivo create secret generic apivo-secrets \
+#     --from-literal=DATABASE_URL='<real connection string>'
+#
+# Parity with local development: DATABASE_URL is the same key the binary reads
+# from .env.example, where it points at the docker-compose Postgres.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: apivo-secrets
+  labels:
+    app.kubernetes.io/name: apivo-secrets
+    app.kubernetes.io/part-of: apivo-news
+type: Opaque
+stringData:
+  DATABASE_URL: "postgres://PLACEHOLDER_USER:PLACEHOLDER_PASSWORD@PLACEHOLDER_HOST:5432/apivo?sslmode=require" # CHANGE-ME placeholder, not a credential
diff --git a/deploy/k8s/web-deployment.yaml b/deploy/k8s/web-deployment.yaml
new file mode 100644
index 0000000..66fe721
--- /dev/null
+++ b/deploy/k8s/web-deployment.yaml
@@ -0,0 +1,73 @@
+# Astro frontend (Node adapter, standalone mode) — the only public HTTP
+# surface, reached through web-service.yaml and web-ingress.yaml.
+#
+# `spec.replicas` is intentionally omitted: the HPA (web-hpa.yaml) owns the
+# replica count.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: web
+  labels:
+    app.kubernetes.io/name: web
+    app.kubernetes.io/part-of: apivo-news
+spec:
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: web
+      app.kubernetes.io/part-of: apivo-news
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: web
+        app.kubernetes.io/part-of: apivo-news
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 10001
+        runAsGroup: 10001
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: web
+          # Placeholder until the container publish pipeline lands; real
+          # deployments pin an image digest.
+          image: ghcr.io/nomos-n4s/apivo-news/web:latest
+          ports:
+            - name: http
+              containerPort: 4321
+          env:
+            # The @astrojs/node standalone server reads HOST/PORT; HOST must
+            # be 0.0.0.0 to bind the pod interface (the default binds
+            # localhost only). Kept inline rather than in the ConfigMap
+            # because these are adapter mechanics, not app configuration.
+            - name: HOST
+              value: "0.0.0.0"
+            - name: PORT
+              value: "4321"
+          resources:
+            requests:
+              cpu: 100m
+              memory: 128Mi
+            limits:
+              cpu: 500m
+              memory: 512Mi
+          # The web has no dedicated health route yet, so both probes hit /.
+          # Point them at a dedicated route when one lands.
+          livenessProbe:
+            httpGet:
+              path: /
+              port: http
+            initialDelaySeconds: 5
+            periodSeconds: 10
+          readinessProbe:
+            httpGet:
+              path: /
+              port: http
+            initialDelaySeconds: 5
+            periodSeconds: 10
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
