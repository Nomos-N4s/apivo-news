      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          const target = tab.getAttribute('data-target');

          domainSections.forEach((sec) => {
            const domain = sec.getAttribute('data-domain');
            if (target === 'all' || target === domain) {
              sec.style.display = 'flex';
            } else {
              sec.style.display = 'none';
            }
          });
        });
      });

      // Interactive Steppers
      function setupStepper(stepperId: string) {
        const stepper = document.getElementById(stepperId);
        if (!stepper) return;
        const steps = stepper.querySelectorAll<HTMLElement>('.step');

        steps.forEach((step) => {
          step.addEventListener('click', () => {
            steps.forEach((s) => s.classList.remove('active'));
            step.classList.add('active');
          });
        });
      }

      setupStepper('news-stepper');
      setupStepper('cashback-stepper');

