---
// Executive Vision Board & Project Status Dashboard for Co-Founders
// Modular architecture orchestrated across 4 executive workstreams:
// 1. Executive Vision & Strategic Domains
// 2. Engineering Execution & GitHub Telemetry Radar
// 3. System Architecture & Sprint Hardening Status
// 4. Interactive Operations Playbook & Financial Simulators

import VisionHeader from '../components/vision/VisionHeader.astro';
import ExecutiveDomains from '../components/vision/ExecutiveDomains.astro';
import VelocityRadar from '../components/vision/VelocityRadar.astro';
import ArchitectureFlow from '../components/vision/ArchitectureFlow.astro';
import SprintStatus from '../components/vision/SprintStatus.astro';
import OperationsPlaybook from '../components/vision/OperationsPlaybook.astro';
import VisionFooter from '../components/vision/VisionFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Apivo — Executive Vision &amp; State Dashboard</title>
    <meta name="description" content="Interactive founder vision board detailing current architecture, operational readiness, and roadmap for News and Cashback domains." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-main: rgb(6, 9, 19);
        --bg-surface: rgb(12, 18, 34);
        --bg-card: rgb(19, 28, 49);
        --bg-card-hover: rgb(25, 37, 64);
        --border-subtle: rgb(30, 45, 77);
        --border-bright: rgb(45, 65, 109);
        --text-primary: rgb(248, 250, 252);
        --text-secondary: rgb(148, 163, 184);
        --text-muted: rgb(100, 116, 139);
        --accent-news: rgb(0, 210, 180);
        --accent-news-glow: rgba(0, 210, 180, 0.15);
        --accent-cashback: rgb(245, 158, 11);
        --accent-cashback-glow: rgba(245, 158, 11, 0.15);
        --accent-platform: rgb(139, 92, 246);
        --status-live: rgb(16, 185, 129);
        --status-warn: rgb(245, 158, 11);
        --status-info: rgb(56, 189, 248);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-main);
        color: var(--text-primary);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.5;
        min-height: 100vh;
        overflow-x: hidden;
      }

      .bg-glow {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 1000px;
        height: 400px;
        background: radial-gradient(circle, rgba(0, 163, 255, 0.08) 0%, rgba(16, 185, 129, 0.04) 50%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
        position: relative;
        z-index: 1;
      }

      /* Executive Module Panel Switching */
      .executive-module-panel {
        display: none;
        animation: fadeIn 0.3s ease-in-out;
      }

      .executive-module-panel.active {
        display: block;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <div class="bg-glow"></div>
    <main class="container">
      <VisionHeader />

      <!-- Module 1: Executive Vision & Domains -->
      <section class="executive-module-panel active" id="module-executive" role="tabpanel" aria-labelledby="mod-tab-executive">
        <ExecutiveDomains />
      </section>

      <!-- Module 2: Engineering & GitHub Velocity Radar -->
      <section class="executive-module-panel" id="module-engineering" role="tabpanel" aria-labelledby="mod-tab-engineering">
        <VelocityRadar />
      </section>

      <!-- Module 3: System Architecture & Sprint Status -->
      <section class="executive-module-panel" id="module-architecture" role="tabpanel" aria-labelledby="mod-tab-architecture">
        <ArchitectureFlow />
        <SprintStatus />
      </section>

      <!-- Module 4: Operations Playbook & Simulators -->
      <section class="executive-module-panel" id="module-playbook" role="tabpanel" aria-labelledby="mod-tab-playbook">
        <OperationsPlaybook />
      </section>

      <VisionFooter />
    </main>

    <script>
      // Executive Module Switcher Orchestrator
      const moduleNavBtns = document.querySelectorAll<HTMLButtonElement>('.module-nav-btn');
      const modulePanels = document.querySelectorAll<HTMLElement>('.executive-module-panel');

      function switchModule(targetModule: string) {
        moduleNavBtns.forEach((btn) => {
          if (btn.getAttribute('data-module') === targetModule) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        modulePanels.forEach((panel) => {
          if (panel.id === `module-${targetModule}`) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });

        if (history.replaceState) {
          history.replaceState(null, '', `#${targetModule}`);
        }
      }

      moduleNavBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-module');
          if (target) switchModule(target);
        });
      });

      // Deep linking support on load & on hash change
      function checkHashRoute() {
        const hash = window.location.hash.replace('#', '');
        if (['executive', 'engineering', 'architecture', 'playbook'].includes(hash)) {
          switchModule(hash);
        } else if (hash === 'engineering-velocity') {
          switchModule('engineering');
        } else if (hash === 'sprint-status' || hash === 'architecture-diagrams') {
          switchModule('architecture');
        } else if (hash === 'how-to-playbook') {
          switchModule('playbook');
        }
      }

      window.addEventListener('DOMContentLoaded', checkHashRoute);
      window.addEventListener('hashchange', checkHashRoute);
    </script>
  </body>
</html>
