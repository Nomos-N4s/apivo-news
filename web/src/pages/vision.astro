        transition: r 0.2s ease, fill 0.2s ease, stroke 0.2s ease;
      }

      .chart-dot-target:hover {
        r: 6.5;
        stroke: rgb(255, 255, 255);
      }

      .loc-split-layout {
        display: grid;
        grid-template-columns: 200px 1fr;
