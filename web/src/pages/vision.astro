  <body>
    <div class="bg-glow"></div>

    <main class="container">
      <!-- Header -->
      <header>
        <div class="header-meta">
          <div class="brand-pill">
            <span class="pulse-dot"></span>
            Apivo Executive Status
          </div>
          <div class="env-badge">QA Channel: ra1ze.com • Monolith v1.0.0-alpha</div>
        </div>

        <div class="header-title-row">
          <div>
            <h1>The Co-Founder Vision Board</h1>
            <p class="subtitle">
              Unified digital platform for European diaspora communities. Independent language and place axes for local journalism, tied to a localized cashback shopping economy.
            </p>
          </div>
        </div>
      </header>

      <!-- KPI Ribbon -->
      <section class="metrics-grid">
        <div class="metric-card">
          <div class="metric-label">Core Architecture</div>
          <div class="metric-value">Go + Astro</div>
          <div class="metric-note">Modular monolith with strict interface decoupling</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Quality Gates (CI)</div>
          <div class="metric-value metric-green">20 / 20 Green</div>
          <div class="metric-note">100% passing tests, race detector, & 90% coverage gate</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Legal Invariants</div>
          <div class="metric-value metric-cyan">I-1 to I-5</div>
          <div class="metric-note">Hard-enforced by Postgres triggers & schema constraints</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Cashback Rail State</div>
          <div class="metric-value metric-amber">Manual Payout</div>
          <div class="metric-note">C-4 & C-5 invariants enforced; operator bank transfers</div>
        </div>
      </section>

      <!-- Domain Navigation Filter -->
      <nav class="tabs-bar" role="tablist">
        <button class="tab-btn active" data-target="all" role="tab" id="tab-all">
          <span>🌐</span> Unified Ecosystem
        </button>
        <button class="tab-btn" data-target="news" role="tab" id="tab-news">
          <span>📰</span> Domain 1: News Platform
        </button>
        <button class="tab-btn" data-target="cashback" role="tab" id="tab-cashback">
          <span>💳</span> Domain 2: Cashback & Commerce
        </button>
      </nav>

      <!-- 2-Column Domain Grid -->
      <div class="domain-grid">
        <!-- DOMAIN 1: NEWS -->
        <section class="domain-column" data-domain="news">
          <div class="domain-header news">
            <h2 class="domain-title">
              <span class="news-accent-icon">📰</span>
              News & Editorial Engine
            </h2>
            <span class="domain-tag news">News</span>
          </div>

          <!-- Card 1: Reader Dual-Axis -->
          <article class="card news-card">
            <div class="card-header">
              <h3 class="card-title">Dual-Axis Reader Experience</h3>
              <span class="card-badge badge-green">Production Ready</span>
            </div>
            <p class="card-desc">
              "Language and place are independent axes." A Greek speaker in Munich reads Munich local news in Greek without being forced into Greek national news.
            </p>
            <div class="spec-list">
              <div class="spec-item">
                <span class="spec-icon">⚡</span>
                <span>Flagship matrix: <span class="spec-code">/el/munich+greece</span> and <span class="spec-code">/de/munich+greece</span></span>
              </div>
              <div class="spec-item">
                <span class="spec-icon">🔒</span>
                <span>Instant SSR rendering with zero client-side tracking or telemetry overhead.</span>
              </div>
            </div>
          </article>

          <!-- Card 2: Legal Invariants (I-1 to I-5) -->
          <article class="card news-card">
            <div class="card-header">
              <h3 class="card-title">Database Legal Invariants</h3>
              <span class="card-badge badge-green">Postgres Enforced</span>
            </div>
            <p class="card-desc">
              Licensing carries real copyright liability. Legal protections are guaranteed by database schema triggers, not application code.
            </p>
            <div class="spec-list">
              <div class="spec-item">
                <span class="spec-icon">🛡️</span>
                <span><strong>I-1:</strong> No article exists without named human approver (<span class="spec-code">approved_by NOT NULL</span>).</span>
