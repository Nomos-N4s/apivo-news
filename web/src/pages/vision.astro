      const cashbackDiagram = document.getElementById('cashback-diagram');

      diagramTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          diagramTabs.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const targetDiagram = btn.getAttribute('data-diagram');
          if (targetDiagram === 'news-diagram') {
            if (newsDiagram) newsDiagram.style.display = 'grid';
            if (cashbackDiagram) cashbackDiagram.style.display = 'none';
            const first = document.querySelector<HTMLElement>('#news-diagram .flow-node');
            first?.click();
          } else {
            if (newsDiagram) newsDiagram.style.display = 'none';
            if (cashbackDiagram) cashbackDiagram.style.display = 'grid';
            const first = document.querySelector<HTMLElement>('#cashback-diagram .flow-node');
            first?.click();
          }
        });
