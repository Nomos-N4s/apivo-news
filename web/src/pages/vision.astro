      // Flow Node Click Handler
      const flowNodes = document.querySelectorAll<HTMLElement>('.flow-node');
      const panelTitleText = document.getElementById('panel-title-text');
      const panelInvariantBadge = document.getElementById('panel-invariant-badge');
      const panelSummaryText = document.getElementById('panel-summary-text');
      const panelTechText = document.getElementById('panel-tech-text');
      const panelDbText = document.getElementById('panel-db-text');
      const panelGuardText = document.getElementById('panel-guard-text');
      const panelSafetyText = document.getElementById('panel-safety-text');

      flowNodes.forEach((node) => {
        node.addEventListener('click', () => {
          flowNodes.forEach((n) => n.classList.remove('selected'));
          node.classList.add('selected');

          const nodeId = node.getAttribute('data-node');
          if (!nodeId || !nodeData[nodeId]) return;

          const data = nodeData[nodeId];
          if (panelTitleText) panelTitleText.textContent = data.title;
          if (panelInvariantBadge) {
            panelInvariantBadge.textContent = data.badge;
            panelInvariantBadge.className = 'node-invariant ' + data.badgeClass;
          }
          if (panelSummaryText) panelSummaryText.textContent = data.summary;
          if (panelTechText) panelTechText.textContent = data.tech;
          if (panelDbText) panelDbText.textContent = data.db;
          if (panelGuardText) panelGuardText.textContent = data.guard;
          if (panelSafetyText) panelSafetyText.textContent = data.safety;
        });
      });

      // Merchant Filter
      const mFilterBtns = document.querySelectorAll<HTMLButtonElement>('.m-filter-btn');
      const merchantRows = document.querySelectorAll<HTMLElement>('.merchant-row');

      mFilterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          mFilterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          const filter = btn.getAttribute('data-filter');
          merchantRows.forEach((row) => {
            const status = row.getAttribute('data-merchant-status');
            if (filter === 'all' || filter === status) {
              row.style.display = 'flex';
            } else {
              row.style.display = 'none';
            }
          });
        });
      });

      // Playbook Tabs
      const playbookBtns = document.querySelectorAll<HTMLButtonElement>('.playbook-nav-btn');
      const playbookPanels = document.querySelectorAll<HTMLElement>('.playbook-tab-panel');

      playbookBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          playbookBtns.forEach((b) => b.classList.remove('active'));
          playbookPanels.forEach((p) => p.classList.remove('active'));

          btn.classList.add('active');
          const tabId = btn.getAttribute('data-tab');
          if (tabId) {
            const targetPanel = document.getElementById(tabId);
            if (targetPanel) targetPanel.classList.add('active');
          }
        });
      });

      // Live Feed Intake Simulator
      const btnRunIntake = document.getElementById('btn-run-intake-sim');
      const intakeLog = document.getElementById('intake-log-output');
      const feedSelect = document.getElementById('feed-preset-select') as HTMLSelectElement | null;

      btnRunIntake?.addEventListener('click', () => {
        if (!intakeLog) return;
        const sourceName = feedSelect?.options[feedSelect.selectedIndex]?.text || 'Selected Feed';
        intakeLog.innerHTML = '<div style="color: rgb(56, 189, 248);">[Initiating intake cycle for: ' + sourceName + '...]</div>';

        setTimeout(() => {
          intakeLog.innerHTML += '<div>[1] Fetching robots.txt & headers... OK (crawl-delay: 2s respected)</div>';
        }, 300);

        setTimeout(() => {
          intakeLog.innerHTML += '<div>[2] Parsing XML feed payload... Found 18 articles (valid schema)</div>';
        }, 700);

        setTimeout(() => {
          intakeLog.innerHTML += '<div>[3] Validating bounded extract (&lt; 280 chars) & license... Verified</div>';
        }, 1100);

        setTimeout(() => {
          intakeLog.innerHTML += '<div style="color: rgb(52, 211, 153);">[4] Legal snapshot captured in source_item (I-2 / I-3 immutable)</div>';
        }, 1500);

        setTimeout(() => {
          intakeLog.innerHTML += '<div>[5] AI translation queued with prompt hash sha256:7f4a9b...</div>';
          intakeLog.innerHTML += '<div style="color: rgb(251, 191, 36); font-weight: 700;">[6] Pushed to /el/editor/signin queue &mdash; Awaiting named human signoff (I-1)</div>';
        }, 1900);
