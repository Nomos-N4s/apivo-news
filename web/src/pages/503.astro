---
import Masthead from '../components/Masthead.astro';
import ReaderLayout from '../layouts/ReaderLayout.astro';
import { DEFAULT_FRONT_PAGE } from '../lib/reader/axes';
import { uiStrings } from '../lib/reader/strings';

// The calm service-unavailable page: the reader API is away, the site is
// not. Pages rewrite here when a fetch fails outside a context that can
// degrade inline. Language-neutral like the 404 — Greek first.
Astro.response.status = 503;
Astro.response.headers.set('Retry-After', '60');

const el = uiStrings('el');
const de = uiStrings('de');
---

<ReaderLayout lang="el" title="epiloYES — 503" description={el.tagline}>
  <Masthead homeHref={DEFAULT_FRONT_PAGE} />
  <main class="sv">
    <div class="pair">
      <h1>{el.unavailableTitle}</h1>
      <p>{el.unavailableBody}</p>
    </div>
    <div class="pair" lang="de">
      <h2>{de.unavailableTitle}</h2>
      <p>{de.unavailableBody}</p>
    </div>
    <a class="btn btn-primary" href={DEFAULT_FRONT_PAGE}>epiloYES →</a>
  </main>
</ReaderLayout>

<style>
  .sv {
    flex: 1;
    padding: calc(var(--space-8) + var(--space-4)) calc(var(--space-6) + var(--space-1));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }
  .pair p {
    margin: 0;
    max-width: 70ch;
    color: var(--ink-soft);
  }
  .pair h1,
  .pair h2 {
    font-size: 32px;
    margin: 0 0 var(--space-2);
  }
</style>
