---
import { DEFAULT_FRONT_PAGE } from '../lib/reader/axes';

// `/` carries no axes, so it cannot be a front page itself (FR-009): it
// forwards to the US1 flagship journey — Munich local + Greek national,
// read in Greek. The template below is the 302's body, for clients that
// show it instead of following the Location header.
if (Astro.url.pathname === '/') {
  return Astro.redirect(DEFAULT_FRONT_PAGE, 302);
}
---

<a href={DEFAULT_FRONT_PAGE}>epiloYES</a>
