---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import OpsLayout from '../../layouts/OpsLayout.astro';
import {
  CashbackApiError,
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../lib/cashback/api';
import { formatMoney } from '../../lib/cashback/money';
import { opsAccess } from '../../lib/cashback/ops-guard';
import { opsLanguage } from '../../lib/cashback/ops-language';
import type { WithdrawalForApproval } from '../../lib/cashback/types';
import { isSameOrigin } from '../../lib/csrf';
import { editorSession } from '../../lib/editorial/session';
import { formatItemDate } from '../../lib/reader/format';
import { cashbackStrings } from '../../i18n/cashback';

// The withdrawal approval queue — mockup 4f's "held withdrawals" panel,
// which is in fact every withdrawal (T097 #244).
//
// The mockup lists two rows and calls them held: one above a thousand
// euros, one with a changed destination. Neither is a category the system
// has. C-4 puts every withdrawal here, so the queue is the payout gate
// rather than an exception list, and approving is what records approved_by
// and submits the payout with the request-derived idempotency key.
//
// Approve takes no reason and reject requires one. That asymmetry is the
// contract's and it is right: an approval's record is the operator's name
// against the payout, and a refusal has to say something the member can
// read, because they are the one who does not get their money.
const lang = opsLanguage(Astro.url);
const t = cashbackStrings(lang);
const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let items: readonly WithdrawalForApproval[] = [];
let apiUnavailable = false;
let notice: string | null = null;
let refusal: string | null = null;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });
  const access = opsAccess(session, api.source);

  if (Astro.request.method === 'POST') {
    if (!isSameOrigin(Astro.request, Astro.url.origin)) {
      return new Response('cross-origin request refused', { status: 403 });
    }
    if (!access.mayAct) {
      return new Response('operator role required', { status: 403 });
    }
    const form = await Astro.request.formData();
    const id = String(form.get('id') ?? '');
    const action = String(form.get('action') ?? '');
    const reason = String(form.get('reason') ?? '').trim();
    try {
      if (action === 'approve') {
        await api.approveWithdrawal(id);
        notice = t.decisionRecorded;
      } else if (action === 'reject') {
        // Checked here as well as at the API, so the member-facing
        // consequence of a blank reason is not a round trip away.
        if (reason === '') {
          refusal = t.reasonRequired;
        } else {
          await api.rejectWithdrawal(id, reason);
          notice = t.decisionRecorded;
        }
      }
    } catch (error) {
      if (!(error instanceof CashbackApiError)) {
        throw error;
      }
      refusal = error.problem?.title ?? error.message;
    }
  }

  if (access.mayRead) {
    items = (await api.withdrawalsAwaitingApproval()).items;
  }
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback ops: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const access = opsAccess(session, api?.source ?? 'api');
if (access.blocked && !apiUnavailable) {
  Astro.response.status = 403;
}

// Selection — mockup 4f shows one row open beside the queue. `?id=` names
// it; otherwise the oldest row, which is the first the queue lists.
const asked = Astro.url.searchParams.get('id');
const selected: WithdrawalForApproval | null =
  items.find((item) => item.id === asked) ?? items[0] ?? null;

const rowHref = (id: string): string => {
  const params = new URLSearchParams();
  params.set('id', id);
  params.set('lang', lang);
  return `?${params.toString()}`;
};

const now = Date.now();
const ageOf = (iso: string): string =>
  t.daysOld(Math.max(0, Math.floor((now - new Date(iso).getTime()) / 86_400_000)));
---

<OpsLayout
  lang={lang}
  session={session}
  current="withdrawals"
  title={t.queueWithdrawals}
  fixtures={api?.source === 'fixture'}
  blocked={access.blocked}
  notice={notice}
  refusal={refusal}
  api={api}
  mayRead={access.mayRead}
>
  <Fragment slot="queue">
    {items.length === 0 && !access.blocked && <p class="queue-note">{t.emptyQueue}</p>}
    {
      items.map((item) => (
        <a
          href={rowHref(item.id)}
          class:list={['qrow', { on: item.id === selected?.id }]}
          aria-current={item.id === selected?.id ? 'true' : undefined}
        >
          <div class="qrow-top">
            <span class="card-kicker">{t.queueWithdrawals}</span>
            <span class="qrow-age">{ageOf(item.requested_at)}</span>
          </div>
          <div class="qrow-title">
            {formatMoney(lang, item.amount)} · {item.account_id}
          </div>
          <div class="qrow-sub">
            {t.reserved} {formatMoney(lang, item.reserved_amount)} · {item.destination.details}
          </div>
        </a>
      ))
    }
  </Fragment>

  <Fragment slot="detail">
    {
      selected === null ? (
        !access.blocked && <p class="queue-note">{t.selectRow}</p>
      ) : (
        <>
          <div class="d-head">
            <div class="d-meta">
              <span class="card-kicker">{t.queueWithdrawals}</span>
              <span class="d-rule" aria-hidden="true" />
              <span class="d-ref">
                {t.reference} <span class="mono">{selected.id}</span> · {ageOf(selected.requested_at)}
              </span>
            </div>
            <h3>
              {formatMoney(lang, selected.amount)} · {selected.account_id}
            </h3>
          </div>
          <div class="d-body">
            <div class="d-left">
              <h6>{t.theRecord}</h6>
              <dl class="record">
                <dt>{t.member}</dt>
                <dd class="strong mono">{selected.account_id}</dd>
                <dt>{t.requested}</dt>
                <dd>{formatItemDate(lang, new Date(selected.requested_at))}</dd>
                <dt>{t.amountLabel}</dt>
                <dd>{formatMoney(lang, selected.amount)}</dd>
                <dt>{t.reserved}</dt>
                <dd class="strong">{formatMoney(lang, selected.reserved_amount)}</dd>
                <dt>{t.destination}</dt>
                <dd class="mono">{selected.destination.details}</dd>
              </dl>
              <h6 class="evidence-head">{t.evidence}</h6>
              <pre class="evidence">{`request_id: ${selected.id}\ndestination_id: ${selected.destination.id}\nkind: ${selected.destination.kind}\nverified_at: ${selected.destination.verified_at ?? '—'}\nrequested_at: ${selected.requested_at}`}</pre>
            </div>
            <div class="d-right">
              <div class="d-say">
                <h6>{t.whatRecordsSay}</h6>
                <span
                  class:list={[
                    'tag',
                    selected.destination.verified_at !== null ? 'tag-accent' : 'tag-neutral',
                  ]}
                >
                  {t.withdrawalStates.awaiting_approval}
                </span>
              </div>
              <p class="assess">{t.wholeEntriesRule}</p>
              <div class="records">
                <div class="rec">
                  <span>{t.trackingLog}</span>
                  <span>{t.none}</span>
                </div>
                <div class="rec">
                  <span>{t.partnerFeed}</span>
                  <span>{t.none}</span>
                </div>
                <div class="rec">
                  <span>{t.rateTable}</span>
                  <span>{t.none}</span>
                </div>
              </div>
              <form method="post" class="act">
                <input type="hidden" name="id" value={selected.id} />
                <div class="field">
                  <label for="reason">{t.reasonLabel}</label>
                  <input class="input" id="reason" name="reason" autocomplete="off" />
                </div>
                <div class="btns">
                  <button
                    class="btn btn-primary"
                    name="action"
                    value="approve"
                    disabled={!access.mayAct}
                  >
                    {t.approve}
                  </button>
                  <button
                    class="btn btn-secondary"
                    name="action"
                    value="reject"
                    disabled={!access.mayAct}
                  >
                    {t.reject}
                  </button>
                </div>
                <p class="perm">{t.decisionIsPermanent}</p>
              </form>
            </div>
          </div>
        </>
      )
    }
  </Fragment>
</OpsLayout>

<style>
  .record {
    display: grid;
    grid-template-columns: 110px 1fr;
    row-gap: 9px;
    column-gap: 12px;
    font-size: 12.5px;
    margin: 0 0 16px;
  }
  .record dt {
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .record dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .strong {
    font-weight: 600;
  }
  .mono {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .d-left h6 {
    margin: 0 0 12px;
  }
  .d-left .evidence-head {
    margin: 0 0 10px;
  }
  .evidence {
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
    padding: 12px 14px;
    font: 11.5px/1.7 ui-monospace, Menlo, monospace;
    margin: 0 0 16px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .d-say {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
  }
  .d-say h6 {
    margin: 0;
  }
  .d-say .tag {
    font-size: 10px;
    white-space: nowrap;
  }
  .assess {
    margin: 0 0 16px;
    font-size: 13.5px;
    text-wrap: pretty;
  }
  .records {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-divider);
    font-size: 12.5px;
    margin-bottom: 18px;
  }
  .rec {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-divider);
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .rec > span:first-child {
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .rec > span:last-child {
    text-align: right;
  }
  .act {
    margin-top: auto;
  }
  .act .field {
    margin-bottom: 12px;
  }
  .btns {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .btns .btn {
    font-size: 13px;
  }
  .perm {
    margin: 0;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    text-wrap: pretty;
  }
</style>
