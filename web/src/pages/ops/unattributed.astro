---
import { API_BASE_URL, APP_ENV } from 'astro:env/server';
import OpsLayout from '../../layouts/OpsLayout.astro';
import {
  CashbackApiError,
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../lib/cashback/api';
import { formatMoney } from '../../lib/cashback/money';
import { opsAccess } from '../../lib/cashback/ops-guard';
import { opsLanguage } from '../../lib/cashback/ops-language';
import type { UnattributedTransaction } from '../../lib/cashback/types';
import { isSameOrigin } from '../../lib/csrf';
import { editorSession } from '../../lib/editorial/session';
import { formatItemDate } from '../../lib/reader/format';
import { cashbackStrings } from '../../i18n/cashback';

// Transactions the network reported that matched no click.
//
// The load-bearing detail is `attributable`, and it is served rather than
// worked out here. `entry_evidence_guard` allows an entry with a null click
// only where the network named no reference at all; a report whose reference
// matched no click can only be dismissed. So a row that cannot be attributed
// does not get an attribute button — it gets the sentence saying why, and
// the form has nothing to press that the database is going to refuse.
//
// This is the same discipline the claims spec (003) states for its own
// remedies: the API decides what is lawful, the screen renders what it
// decided.
const lang = opsLanguage(Astro.url);
const t = cashbackStrings(lang);
const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let items: readonly UnattributedTransaction[] = [];
let apiUnavailable = false;
let notice: string | null = null;
let refusal: string | null = null;

try {
  api = createCashbackApi(API_BASE_URL, { appEnv: APP_ENV, token: session.token });
  const access = opsAccess(session, api.source);

  if (Astro.request.method === 'POST') {
    if (!isSameOrigin(Astro.request, Astro.url.origin)) {
      return new Response('cross-origin request refused', { status: 403 });
    }
    if (!access.mayAct) {
      return new Response('operator role required', { status: 403 });
    }
    const form = await Astro.request.formData();
    const id = String(form.get('id') ?? '');
    const action = String(form.get('action') ?? '');
    const accountId = String(form.get('account_id') ?? '').trim();
    const reason = String(form.get('reason') ?? '').trim();
    if (reason === '') {
      refusal = t.reasonRequired;
    } else if (action === 'attribute' && accountId === '') {
      refusal = t.accountLabel;
    } else {
      try {
        if (action === 'attribute') {
          await api.attributeTransaction(id, accountId, reason);
        } else {
          await api.dismissTransaction(id, reason);
        }
        notice = t.decisionRecorded;
      } catch (error) {
        if (!(error instanceof CashbackApiError)) {
          throw error;
        }
        refusal = error.problem?.title ?? error.message;
      }
    }
  }

  if (access.mayRead) {
    items = (await api.unattributed()).items;
  }
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback ops: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const access = opsAccess(session, api?.source ?? 'api');
if (access.blocked && !apiUnavailable) {
  Astro.response.status = 403;
}
---

<OpsLayout
  lang={lang}
  session={session}
  current="unattributed"
  title={t.queueUnattributed}
  fixtures={api?.source === 'fixture'}
  blocked={access.blocked}
  notice={notice}
  refusal={refusal}
>
  <p class="hint">{t.oldestFirst}</p>
  {items.length === 0 && !access.blocked && <p class="hint">{t.emptyQueue}</p>}

  {
    items.map((item) => (
      <article class="row">
        <div class="head">
          <span class="figure">{formatMoney(lang, item.commission)}</span>
          <span class="tag tag-outline">
            {t.sale} {formatMoney(lang, item.sale)}
          </span>
          {!item.attributable && <span class="tag tag-neutral">{t.dismiss}</span>}
        </div>
        <dl>
          <dt>{t.networkReported}</dt>
          <dd class="ref">{item.external_id}</dd>
          <dt>{t.requestedAt}</dt>
          <dd>{formatItemDate(lang, new Date(item.transacted_at))}</dd>
        </dl>
        {!item.attributable && <p class="cannot">{t.notAttributable}</p>}
        <form method="post" class="decide">
          <input type="hidden" name="id" value={item.id} />
          {
            item.attributable && (
              <div class="field">
                <label for={`account-${item.id}`}>{t.accountLabel}</label>
                <input class="input" id={`account-${item.id}`} name="account_id" autocomplete="off" />
              </div>
            )
          }
          <div class="field">
            <label for={`reason-${item.id}`}>{t.reasonLabel}</label>
            <input class="input" id={`reason-${item.id}`} name="reason" required autocomplete="off" />
          </div>
          <div class="actions">
            {
              item.attributable && (
                <button
                  class="btn btn-primary"
                  name="action"
                  value="attribute"
                  disabled={!access.mayAct}
                >
                  {t.attribute}
                </button>
              )
            }
            <button class="btn btn-secondary" name="action" value="dismiss" disabled={!access.mayAct}>
              {t.dismiss}
            </button>
          </div>
          <p class="required">{t.reasonRequired}</p>
        </form>
      </article>
    ))
  }
</OpsLayout>

<style>
  .hint {
    font-size: 12.5px;
    color: var(--ink-muted);
    margin: 0 0 var(--space-4);
  }
  .row {
    border-top: 1px solid var(--color-divider);
    padding: var(--space-5) 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .figure {
    font: var(--font-heading-weight) 22px/1 var(--font-heading);
  }
  dl {
    display: grid;
    grid-template-columns: minmax(130px, auto) 1fr;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-4);
    font-size: 13px;
  }
  dt {
    color: var(--ink-muted);
  }
  dd {
    margin: 0;
  }
  .ref {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .cannot {
    margin: 0 0 var(--space-4);
    font-size: 13px;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    text-wrap: pretty;
  }
  .decide {
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    padding: var(--space-4);
    max-width: 560px;
    display: grid;
    gap: var(--space-3);
  }
  .actions {
    display: flex;
    gap: var(--space-3);
  }
  .required {
    margin: 0;
    font-size: 11.5px;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
</style>
