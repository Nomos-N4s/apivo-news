---
import Masthead from '../../../components/Masthead.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import { isSameOrigin } from '../../../lib/csrf';
import { editorSession } from '../../../lib/editorial/session';
import { editorialStrings } from '../../../lib/editorial/strings';
import { authClient, authConfigured } from '../../../lib/editorial/supabase';
import { DEFAULT_FRONT_PAGE, isReadingLanguage } from '../../../lib/reader/axes';
import { uiStrings } from '../../../lib/reader/strings';

// The editorial sign-in (T022 #25). Email and password against the
// project's Supabase Auth, with the session kept in cookies — the
// middleware reads it back on every editorial request.
//
// This is the screen that makes the approver real. Everything downstream
// of it — the named approver on an article (I-1), the editor role the
// database checks, the bearer token the editorial API verifies — starts
// with the person at this form being who they say they are, so the copy
// says plainly that the name will be recorded and that the account must
// be their own.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = editorialStrings(lang);
const reader = uiStrings(lang);
const here = `/${lang}/editor/signin`;
const queueHref = `/${lang}/editor`;
const configured = authConfigured();

let failure: string | null = null;
if (Astro.request.method === 'POST') {
  // Signing in and out both change state with the browser's cookies, so
  // both go through the same origin check as approval does.
  if (!isSameOrigin(Astro.request, Astro.url.origin)) {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  const client = authClient(Astro.request, Astro.cookies);
  if (client === null) {
    // Nothing to post to. Said out loud rather than as a failed
    // sign-in: the credentials were never wrong, they were never sent.
    failure = t.signInUnavailable;
  } else if (String(form.get('action') ?? '') === 'signout') {
    await client.auth.signOut();
    return Astro.redirect(`${here}?signedout=1`);
  } else {
    const email = String(form.get('email') ?? '').trim();
    const password = String(form.get('password') ?? '');
    const { error } = await client.auth.signInWithPassword({ email, password });
    if (error === null) {
      // Post/redirect/get: the session cookies this response carries are
      // read back by the middleware on the next request, which is the
      // one that renders the queue as this editor.
      return Astro.redirect(queueHref);
    }
    // Deliberately the same sentence whatever went wrong. Distinguishing
    // "no such account" from "wrong password" tells an attacker which
    // addresses are editors.
    failure = t.signInFailed;
  }
}

// Read after the POST branch: signing out above invalidated it.
const session = editorSession(Astro.request);
const signedOut = Astro.url.searchParams.get('signedout') !== null;
---

<ReaderLayout lang={lang} title={`epiloYES — ${t.signInTitle}`} description={reader.tagline}>
  <Masthead homeHref={DEFAULT_FRONT_PAGE} />

  <main class="page">
    <header class="head">
      <h2>{t.signInTitle}</h2>
      <p>{t.signInIntro}</p>
    </header>

    {signedOut && <p class="banner">{t.signedOutNow}</p>}
    {failure !== null && <p class="banner banner-warn">{failure}</p>}

    {
      session.authenticated ? (
        <section class="panel">
          <p class="signed-in">
            {t.signedInAs} <strong>{session.displayName}</strong> ·{' '}
            {session.role === 'editor' ? t.roleEditor : t.roleReader}
          </p>
          <p class="note">{session.email}</p>
          <div class="actions">
            <a class="btn btn-primary" href={queueHref}>
              {t.reviewQueue}
            </a>
            <form method="post" action={here}>
              <input type="hidden" name="action" value="signout" />
              <button class="btn btn-secondary" type="submit">
                {t.signOut}
              </button>
            </form>
          </div>
        </section>
      ) : (
        <section class="panel">
          <form method="post" action={here} data-tour="signin-form">
            <div class="field">
              <label for="s-email">{reader.emailLabel}</label>
              <input
                class="input"
                id="s-email"
                name="email"
                type="email"
                autocomplete="username"
                required
                disabled={!configured}
              />
            </div>
            <div class="field">
              <label for="s-pass">{reader.passwordLabel}</label>
              <input
                class="input"
                id="s-pass"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                disabled={!configured}
              />
            </div>
            <button class="btn btn-primary btn-block" type="submit" disabled={!configured}>
              {t.signIn}
            </button>
          </form>
          {/* An unconfigured deployment says so instead of offering a
              form that could only fail. */}
          {!configured && <p class="pending">{t.signInUnavailable}</p>}
        </section>
      )
    }
  </main>
</ReaderLayout>

<style>
  .page {
    flex: 1;
  }
  .head {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    border-bottom: 2px solid var(--color-divider);
  }
  .head h2 {
    font-size: 30px;
    margin: 0 0 var(--space-2);
  }
  .head p {
    margin: 0;
    font-size: 14px;
    max-width: 56ch;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
    text-wrap: pretty;
  }
  .banner {
    margin: 0;
    padding: var(--space-3) calc(var(--space-6) + var(--space-1));
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 13px;
  }
  .banner-warn {
    background: var(--color-text);
  }
  .panel {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    max-width: 46ch;
  }
  .field {
    margin-bottom: var(--space-3);
  }
  .signed-in {
    margin: 0 0 var(--space-1);
    font-size: 14px;
  }
  .note {
    margin: 0 0 var(--space-4);
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }
  .pending {
    margin: var(--space-3) 0 0;
    font-size: 11.5px;
    color: var(--color-accent-800);
    background: var(--color-accent-100);
    border-left: 2px solid var(--color-accent);
    padding: var(--space-2) var(--space-3);
    text-wrap: pretty;
  }
</style>
