---
import { API_BASE_URL } from 'astro:env/server';
import EditorChrome from '../../../components/EditorChrome.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import {
  approvalRecordLine,
  createEditorialApi,
  EditorialApiError,
  formatItemCost,
  type ApprovalOutcome,
  type QueuePage,
} from '../../../lib/editorial/api';
import { isSameOrigin } from '../../../lib/csrf';
import { editorSession } from '../../../lib/editorial/session';
import { editorialStrings, languageName } from '../../../lib/editorial/strings';
import { authConfigured } from '../../../lib/editorial/supabase';
import { findPlace, isReadingLanguage } from '../../../lib/reader/axes';
import { formatDateTime, formatItemDate, safeSourceUrl } from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// The editorial review queue — mockup 1g, the approval gate (issue #61,
// toward T022 #25). Nothing publishes without a named editor (US4,
// FR-007), so this screen is the product's only door: the original sits
// beside the translation, the spend ledger is visible before anything is
// spent (FR-006), and approval states plainly that it is permanent.
//
// Selection is a link (?item=…) and approval is a form POST, so the
// screen needs no client JavaScript.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = editorialStrings(lang);
const reader = uiStrings(lang);
const session = editorSession(Astro.request);

// With an auth provider configured, a visitor nobody signed in belongs on
// the sign-in screen: this page offers approval, and approval needs a
// named editor's own token. Without a provider there is nothing to sign
// in to, and the screen stays the fixture preview it has been.
//
// Only a GET is redirected. A POST is someone's finished work arriving
// from a session that expired mid-edit; a redirect would land on the
// sign-in page as a GET with the form's content gone, so the page
// re-renders instead with a signed-out notice that keeps what was typed.
const configured = authConfigured();
const signedOut = configured && !session.authenticated;
if (signedOut && Astro.request.method !== 'POST') {
  return Astro.redirect(`/${lang}/editor/signin`);
}

const api = createEditorialApi(API_BASE_URL, session.token);

// Approval carries the editor's intent; the database is what makes it
// real. With no editorial API the client answers recorded:false and the
// screen says so — it never claims a record it did not create.
let outcome: ApprovalOutcome | null = null;
let signedOutPost = false;
let staleItemId: string | null = null;
let staleAttribution: string | null = null;
if (Astro.request.method === 'POST') {
  // Approval is a privileged, named act. A cross-site form must never be
  // able to drive it with a logged-in editor's browser — the check is in
  // place before real approvals exist, so wiring auth cannot open the
  // hole silently.
  if (!isSameOrigin(Astro.request, Astro.url.origin)) {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  const sourceItemId = String(form.get('source_item_id') ?? '');
  const rawTranslationId = form.get('translation_id');
  const translationId =
    typeof rawTranslationId === 'string' && rawTranslationId !== '' ? rawTranslationId : null;
  // The contract requires a non-blank attribution: it becomes the
  // article's attribution block, which FR-008 renders on every item.
  const attribution = String(form.get('attribution') ?? '').trim();
  if (signedOut) {
    // No token, so nothing can be recorded — but the attribution is this
    // editor's wording, and losing it to a redirect would cost the one
    // thing on this form that was typed rather than selected.
    signedOutPost = true;
    staleItemId = sourceItemId === '' ? null : sourceItemId;
    staleAttribution = attribution === '' ? null : attribution;
  } else if (sourceItemId !== '' && attribution !== '') {
    try {
      outcome = await api.approve(sourceItemId, translationId, attribution);
    } catch (error) {
      outcome = {
        recorded: false,
        reason: error instanceof Error ? error.message : String(error),
      };
    }
  }
}

let queue: QueuePage | null = null;
let queueFailed = false;
let notProvisioned = false;
try {
  queue = await api.queue();
} catch (error) {
  if (
    session.authenticated &&
    error instanceof EditorialApiError &&
    (error.status === 401 || error.status === 403)
  ) {
    // Signed in, yet refused: the quickstart's documented first-run
    // state, where no account row was provisioned for this person. The
    // service is not down, and saying it is would send the operator
    // hunting for an outage instead of at the provisioning step.
    notProvisioned = true;
    Astro.response.status = 403;
  } else {
    queueFailed = true;
    Astro.response.status = 503;
  }
}

const items = queue?.items ?? [];
// A signed-out POST re-selects the item it was about, so the re-render
// puts the preserved attribution back into its own form.
const selectedId = Astro.url.searchParams.get('item') ?? staleItemId;
const selected = items.find((item) => item.source_item_id === selectedId) ?? items.at(0);

const here = `/${lang}/editor`;
const itemHref = (id: string): string => `${here}?item=${encodeURIComponent(id)}`;

const placeName = (slugs: readonly string[] | undefined): string => {
  const slug = slugs?.at(0);
  return slug === undefined ? '' : (findPlace(slug)?.endonym ?? slug);
};

// The attribution the article will carry (FR-008), composed from what the
// queue row states and left editable — the editor is the one who stands
// behind the wording, so it is a field, not a hidden value.
const defaultAttribution = (item: (typeof items)[number]): string => {
  const published = item.original_published_at ?? item.retrieved_at;
  return `${reader.originallyPublishedBy} ${item.source_name}, ${formatItemDate(
    lang,
    new Date(published),
  )}.`;
};
---

<ReaderLayout lang={lang} title={`epiloYES — ${t.editorial}`} description={reader.tagline}>
  {/* The chrome, rail and ledger live in EditorChrome; the ledger is a
      proposed addition, so it renders only when the response carries
      one. */}
  <EditorChrome
    lang={lang}
    session={session}
    active="queue"
    queueCount={items.length}
    spend={queue?.spend}
    authConfigured={configured}
  >
    {
      notProvisioned && (
        <div class="provision">
          <h6>{t.notProvisionedTitle}</h6>
          <p>{t.notProvisionedBody}</p>
        </div>
      )
    }
    <div class="work">
      <div class="queue">
        <div class="queue-head">
          <h6>{t.awaitingApproval}</h6>
          <span class="muted">{t.newestFirst}</span>
        </div>

        {
          items.map((item) => (
            <a
              class:list={['row', { 'row-on': item.source_item_id === selected?.source_item_id }]}
              href={itemHref(item.source_item_id)}
              aria-current={item.source_item_id === selected?.source_item_id ? 'true' : undefined}
            >
              <span class="row-meta">
                <span class="kicker">{placeName(item.places)}</span>
                <span class="muted">
                  {item.source_name} · {formatDateTime(lang, new Date(item.retrieved_at))}
                </span>
              </span>
              <span class="row-title">
                {item.headline_translated ?? item.headline_original ?? item.source_item_id}
              </span>
              <span class="row-tags">
                {item.translation_id === null ? (
                  <span class="tag tag-outline">{t.noTranslationNeeded}</span>
                ) : (
                  <>
                    <span class="tag tag-accent">
                      {(item.source_lang ?? '').toUpperCase()} → {(item.target_lang ?? '').toUpperCase()}
                    </span>
                    {typeof item.cost_microusd === 'number' && (
                      <span class="tag tag-neutral">{formatItemCost(item.cost_microusd)}</span>
                    )}
                  </>
                )}
              </span>
            </a>
          ))
        }

        {
          queue?.holds !== undefined && queue.holds.queued_untranslated > 0 && (
            <div class="hold">
              <h6>{t.queuedUntranslated}</h6>
              <p>{t.queuedUntranslatedBody(queue.holds.queued_untranslated)}</p>
            </div>
          )
        }
        {
          queue?.holds !== undefined && queue.holds.skipped_over_ceiling > 0 && (
            <p class="skip-note">{t.skippedOverCeiling(queue.holds.skipped_over_ceiling)}</p>
          )
        }
        {queueFailed && <p class="skip-note">{reader.unavailableBody}</p>}
        {/* An unprovisioned account could not read the queue at all, so
            the screen must not claim it is empty. */}
        {!queueFailed && !notProvisioned && items.length === 0 && (
          <p class="skip-note">{t.emptyQueue}</p>
        )}
      </div>

      <div class="review">
        {
          signedOutPost && (
            <div class="banner banner-warn">
              <span class="banner-label">{t.notRecordedTitle}</span>
              <span class="banner-body">
                {t.signedOutMidPost}
                {/* The queue may be unreadable without a token, and then
                    there is no form to put the wording back into — so the
                    notice itself carries it. */}
                {staleAttribution !== null && selected === undefined && ` «${staleAttribution}»`}
              </span>
              <a class="banner-link" href={`/${lang}/editor/signin`}>
                {t.signIn}
              </a>
            </div>
          )
        }
        {
          outcome !== null && (
            <div class:list={['banner', { 'banner-warn': !outcome.recorded }]}>
              <span class="banner-label">
                {outcome.recorded ? t.approvedTitle : t.notRecordedTitle}
              </span>
              <span class="banner-body">
                {outcome.recorded ? approvalRecordLine(outcome) : outcome.reason}
              </span>
            </div>
          )
        }

        {
          selected === undefined ? (
            <p class="empty-review">{t.selectAnItem}</p>
          ) : (
            <>
              <div class="review-head">
                <div class="review-meta">
                  <span class="kicker">source_item {selected.source_item_id.slice(0, 8)}</span>
                  <span class="meta-rule" aria-hidden="true" />
                  <span class="muted">
                    {t.retrievedImmutable(formatDateTime(lang, new Date(selected.retrieved_at)))}
                  </span>
                </div>
                <h3>{t.reviewBeforeApproval}</h3>
              </div>

              <div class="split">
                <section class="original">
                  <div class="col-head">
                    <h6>{t.originalIn(languageName(lang, selected.source_lang ?? ''))}</h6>
                    {safeSourceUrl(selected.source_url ?? '') !== null && (
                      <a href={safeSourceUrl(selected.source_url ?? '')} rel="external noopener">
                        {t.openSource}
                      </a>
                    )}
                  </div>
                  <div class="col-title">{selected.headline_original ?? '—'}</div>
                  <p class="col-extract">{selected.extract_original ?? '—'}</p>
                  <dl class="evidence">
                    <div>
                      <dt>original_author</dt>
                      <dd>{selected.original_author ?? '—'}</dd>
                    </div>
                    <div>
                      <dt>published_at</dt>
                      <dd>
                        {selected.original_published_at === null ||
                        selected.original_published_at === undefined
                          ? '—'
                          : formatDateTime(lang, new Date(selected.original_published_at))}
                      </dd>
                    </div>
                    <div>
                      <dt>content_hash</dt>
                      <dd class="hash">{selected.content_hash ?? '—'}</dd>
                    </div>
                    <div>
                      <dt>{t.licenceAtRetrieval}</dt>
                      <dd>{selected.licence_snapshot}</dd>
                    </div>
                  </dl>
                </section>

                <section class="translated">
                  <div class="col-head">
                    <h6 class="accent">
                      {selected.translation_id === null
                        ? t.publishedAsIs
                        : t.translationIn(languageName(lang, selected.target_lang ?? ''))}
                    </h6>
                    <span class="muted">
                      {selected.translation_id === null
                        ? t.noTranslationNeeded
                        : `${selected.model ?? '—'} · prompt ${selected.prompt_version ?? '—'}`}
                    </span>
                  </div>
                  <div class="col-title">
                    {selected.headline_translated ?? selected.headline_original ?? '—'}
                  </div>
                  <p class="col-extract">
                    {selected.extract_translated ?? selected.extract_original ?? '—'}
                  </p>
                  <p class="muted extract-note">{t.extractOnlyNote}</p>

                  <form class="approval" method="post" action={here}>
                    <input type="hidden" name="source_item_id" value={selected.source_item_id} />
                    <input
                      type="hidden"
                      name="translation_id"
                      value={selected.translation_id ?? ''}
                    />
                    <div class="field attribution-field">
                      <label for="attribution">{reader.attribution}</label>
                      <input
                        class="input"
                        id="attribution"
                        name="attribution"
                        value={
                          selected.source_item_id === staleItemId && staleAttribution !== null
                            ? staleAttribution
                            : defaultAttribution(selected)
                        }
                        required
                      />
                    </div>
                    <label class="ack">
                      <input type="checkbox" name="acknowledged" required />
                      <span class="box" aria-hidden="true" />
                      <span class="ack-text">{t.acknowledgement}</span>
                    </label>
                    <div class="actions">
                      <button class="btn btn-primary" type="submit">{t.approveAndPublish}</button>
                      <button class="btn btn-secondary" type="button" disabled>{t.reject}</button>
                      <a class="btn btn-ghost skip" href={here}>{t.skip}</a>
                    </div>
                    <p class="muted reject-note">{t.rejectNote}</p>
                  </form>
                </section>
              </div>
            </>
          )
        }
      </div>
    </div>
  </EditorChrome>
</ReaderLayout>

<style>
  /* — the unprovisioned-account guidance — */
  .provision {
    padding: var(--space-4) var(--space-6);
    border-bottom: 2px solid var(--color-divider);
    background: var(--color-accent-100);
  }
  .provision h6 {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-800);
  }
  .provision p {
    margin: 0;
    font-size: 13px;
    max-width: 90ch;
    text-wrap: pretty;
  }

  .work {
    display: grid;
    grid-template-columns: 400px 1fr;
    min-height: 0;
  }

  /* — the queue — */
  .queue {
    border-right: 1px solid var(--color-divider);
  }
  .queue-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider);
  }
  .queue-head h6 {
    margin: 0;
  }
  .muted {
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .queue-head .muted {
    margin-left: auto;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider);
    border-left: 3px solid transparent;
    text-decoration: none;
    color: var(--color-text);
  }
  .row:hover {
    background: color-mix(in srgb, var(--color-text) 4%, transparent);
  }
  .row-on {
    border-left-color: var(--color-accent);
    background: var(--color-accent-100);
  }
  .row-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .kicker {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .row-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 15.5px;
    line-height: 1.25;
    text-wrap: pretty;
  }
  .row-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .row-tags .tag {
    font-size: 10px;
  }
  .hold {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-surface);
  }
  .hold h6 {
    margin: 0 0 6px;
    font-size: 10px;
    color: var(--color-accent-700);
  }
  .hold p {
    margin: 0;
    font-size: 12.5px;
    text-wrap: pretty;
  }
  .skip-note {
    padding: var(--space-3) var(--space-4);
    margin: 0;
    font-size: 12px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    text-wrap: pretty;
  }

  /* — the review pane — */
  .review {
    display: flex;
    flex-direction: column;
  }
  .banner {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent);
    color: var(--color-bg);
    flex-wrap: wrap;
  }
  .banner-warn {
    background: var(--color-text);
  }
  .banner-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex: none;
  }
  .banner-warn .banner-label {
    color: var(--color-accent-400);
  }
  .banner-body {
    font-size: 13px;
    max-width: 80ch;
  }
  .banner-link {
    font-size: 13px;
    color: var(--color-accent-400);
  }
  .empty-review {
    padding: var(--space-8) var(--space-6);
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .review-head {
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-divider);
  }
  .review-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }
  .meta-rule {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }
  .review-head h3 {
    margin: 0;
    font-size: 23px;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
  }
  .original {
    padding: var(--space-6);
    border-right: 1px solid var(--color-divider);
    background: var(--color-surface);
  }
  .translated {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .col-head h6 {
    margin: 0;
  }
  .col-head .accent {
    color: var(--color-accent);
  }
  .col-head a {
    font-size: 11.5px;
    text-decoration: none;
  }
  .col-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 20px;
    line-height: 1.2;
    margin-bottom: var(--space-3);
    text-wrap: pretty;
  }
  .col-extract {
    font-size: 14px;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }
  .evidence {
    margin: 0;
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-3);
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11.5px;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }
  .evidence > div {
    display: flex;
    gap: var(--space-2);
  }
  .evidence dt {
    flex: none;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .evidence dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .hash {
    word-break: break-all;
  }
  .extract-note {
    margin: 0 0 var(--space-4);
  }

  /* — the approval affordance — */
  .approval {
    margin-top: auto;
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-4);
  }
  .attribution-field {
    margin-bottom: var(--space-3);
  }
  .ack {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    cursor: pointer;
  }
  .ack input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .box {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 2px;
    border: 1.5px solid var(--color-accent);
  }
  .ack:has(input:checked) .box {
    background: var(--color-accent);
  }
  .ack:has(input:focus-visible) .box {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .ack-text {
    font-size: 12.5px;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }
  .actions .btn {
    font-size: 14px;
    padding: var(--space-3) calc(var(--space-4) + 2px);
  }
  .skip {
    margin-left: auto;
    font-size: 13px;
    text-decoration: none;
  }
  .reject-note {
    margin: var(--space-3) 0 0;
  }

  @media (max-width: 1100px) {
    .work {
      grid-template-columns: 1fr;
    }
    .queue {
      border-right: 0;
      border-bottom: 2px solid var(--color-divider);
    }
    .split {
      grid-template-columns: 1fr;
    }
    .original {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
  }
  @media (max-width: 760px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .rail {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .spend {
      margin-top: var(--space-4);
    }
  }
</style>
