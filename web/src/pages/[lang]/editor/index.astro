---
import { API_BASE_URL } from 'astro:env/server';
import EditorChrome from '../../../components/EditorChrome.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import RecordNotice from '../../../components/RecordNotice.astro';
import {
  createEditorialApi,
  EditorialApiError,
  formatItemCost,
  type ApprovalOutcome,
  type QueuePage,
} from '../../../lib/editorial/api';
import {
  APPROVAL_PLACES,
  attributionDefault,
  hasApprovalEvidence,
  parseApprovalForm,
} from '../../../lib/editorial/approvalForm';
import {
  noticeForApproval,
  noticeForCorrection,
  noticeForSignedOut,
} from '../../../lib/editorial/notices';
import { isSameOrigin } from '../../../lib/csrf';
import { editorSession } from '../../../lib/editorial/session';
import { editorialStrings, languageName } from '../../../lib/editorial/strings';
import { authConfigured } from '../../../lib/editorial/supabase';
import { findPlace, isReadingLanguage } from '../../../lib/reader/axes';
import { formatDateTime, safeSourceUrl } from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// The editorial review queue — mockup 1g, the approval gate (issue #61,
// toward T022 #25). Nothing publishes without a named editor (US4,
// FR-007), so this screen is the product's only door: the original sits
// beside the translation, the spend ledger is visible before anything is
// spent (FR-006), and approval states plainly that it is permanent.
//
// Selection is a link (?item=…) and approval is a form POST, so the
// screen needs no client JavaScript.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = editorialStrings(lang);
const reader = uiStrings(lang);
const session = editorSession(Astro.request);

// With an auth provider configured, a visitor nobody signed in belongs on
// the sign-in screen: this page offers approval, and approval needs a
// named editor's own token. Without a provider there is nothing to sign
// in to, and the screen stays the fixture preview it has been.
//
// Only a GET is redirected. A POST is someone's finished work arriving
// from a session that expired mid-edit; a redirect would land on the
// sign-in page as a GET with the form's content gone, so the page
// re-renders instead with a signed-out notice that keeps what was typed.
const configured = authConfigured();
const signedOut = configured && !session.authenticated;
if (signedOut && Astro.request.method !== 'POST') {
  return Astro.redirect(`/${lang}/editor/signin`);
}

const api = createEditorialApi(API_BASE_URL, session.token);

// Approval carries the editor's intent; the database is what makes it
// real. With no editorial API the client answers recorded:false and the
// screen says so — it never claims a record it did not create.
let outcome: ApprovalOutcome | null = null;
let signedOutPost = false;
let staleItemId: string | null = null;
let staleAttribution: string | null = null;
let stalePlaces: readonly string[] | null = null;
if (Astro.request.method === 'POST') {
  // Approval is a privileged, named act. A cross-site form must never be
  // able to drive it with a logged-in editor's browser — the check is in
  // place before real approvals exist, so wiring auth cannot open the
  // hole silently.
  if (!isSameOrigin(Astro.request, Astro.url.origin)) {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  // The contract requires a non-blank attribution (it becomes the
  // article's attribution block, which FR-008 renders on every item) and
  // at least one place — the parse names which requirement a POST missed.
  const parsed = parseApprovalForm(form);
  // A POST the screen refuses — signed out, or short of a requirement —
  // must not also cost the editor their work: the attribution is the one
  // thing on this form that was typed rather than selected, and the
  // checked boxes are their judgement. The re-render puts both back.
  if (signedOut || !parsed.ok) {
    const typed = parsed.ok
      ? {
          sourceItemId: parsed.submission.sourceItemId,
          attribution: parsed.submission.attribution,
          places: parsed.submission.places,
        }
      : parsed.stale;
    staleItemId = typed.sourceItemId;
    staleAttribution = typed.attribution;
    stalePlaces = typed.places;
  }
  if (signedOut) {
    // No token, so nothing can be recorded — the banner says so and the
    // preserved fields above survive the sign-in round trip's cost.
    signedOutPost = true;
  } else if (parsed.ok) {
    try {
      const { submission } = parsed;
      outcome = await api.approve(
        submission.sourceItemId,
        submission.translationId,
        submission.attribution,
        submission.places,
      );
    } catch (error) {
      outcome = {
        recorded: false,
        reason: error instanceof Error ? error.message : String(error),
      };
    }
  } else if (parsed.refusal === 'no-place') {
    // Checkboxes cannot express "at least one of these" in plain HTML, so
    // the refusal happens here, before the API client is called: an
    // article tagged to no place can never appear on any front page, and
    // the API would answer 400 for the same reason. No record, and the
    // banner says so.
    outcome = { recorded: false, reason: t.atLeastOnePlace };
  }
}

let queue: QueuePage | null = null;
let queueFailed = false;
let notProvisioned = false;
try {
  queue = await api.queue();
} catch (error) {
  if (
    session.authenticated &&
    error instanceof EditorialApiError &&
    (error.status === 401 || error.status === 403)
  ) {
    // Signed in, yet refused: the quickstart's documented first-run
    // state, where no account row was provisioned for this person. The
    // service is not down, and saying it is would send the operator
    // hunting for an outage instead of at the provisioning step.
    notProvisioned = true;
    Astro.response.status = 403;
  } else {
    queueFailed = true;
    Astro.response.status = 503;
  }
}

const items = queue?.items ?? [];
// A signed-out or refused POST re-selects the item it was about, so the
// re-render puts the preserved attribution and places back into its form.
const selectedId = Astro.url.searchParams.get('item') ?? staleItemId;
const selected = items.find((item) => item.source_item_id === selectedId) ?? items.at(0);

const here = `/${lang}/editor`;
const itemHref = (id: string): string => `${here}?item=${encodeURIComponent(id)}`;

// The withdrawal that freed a correction candidate, newest first per the
// contract; undefined for a fresh candidate or an API predating #87.
const lastWithdrawal = selected?.withdrawals?.at(0);

// Whether the selected row carries the evidence the approval rests on.
// Against an API predating the evidence block the pane renders dashes -
// and a permanent approval must not be offered over dashes, so the
// approve button is disabled with a visible reason instead (#87).
const evidenceComplete = selected !== undefined && hasApprovalEvidence(selected);

const placeName = (slugs: readonly string[] | undefined): string => {
  const slug = slugs?.at(0);
  return slug === undefined ? '' : (findPlace(slug)?.endonym ?? slug);
};

// The attribution the article will carry (FR-008), composed from what the
// queue row states and left editable — the editor is the one who stands
// behind the wording, so it is a field, not a hidden value. The date is
// the one the feed DECLARED; when it declared none, the gap is said out
// loud rather than papered over with the retrieval date, which
// article_guard would freeze into the attribution permanently (#87).
//
// Date AND time, deliberately: the instant renders in the reader zone
// (Europe/Berlin), so a Greek item published just after midnight Athens
// time carries the previous calendar date here — with the clock beside it,
// that boundary is visible to the editor before the wording freezes,
// instead of a silently shifted date. The honest fix — preserving the
// feed's declared offset at ingestion and formatting in it — is a schema
// addition, tracked as issue #114.
const defaultAttribution = (item: (typeof items)[number]): string =>
  attributionDefault(
    item,
    {
      originallyPublishedBy: reader.originallyPublishedBy,
      publicationDateNotSupplied: t.publicationDateNotSupplied,
    },
    (iso) => formatDateTime(lang, new Date(iso)),
  );
---

<ReaderLayout lang={lang} title={`epiloYES — ${t.editorial}`} description={reader.tagline}>
  {/* The chrome, rail and ledger live in EditorChrome; the ledger is a
      proposed addition, so it renders only when the response carries
      one. The preview marker keys on the data's own provenance: fixture
      numbers must be flagged even for a genuinely signed-in editor. */}
  <EditorChrome
    lang={lang}
    session={session}
    active="queue"
    queueCount={items.length}
    spend={queue?.spend}
    previewData={queue?.fixture === true}
  >
    {
      notProvisioned && (
        <div class="provision">
          <h6>{t.notProvisionedTitle}</h6>
          <p>{t.notProvisionedBody}</p>
        </div>
      )
    }
    <div class="work">
      <div class="queue" data-tour="queue-list">
        <div class="queue-head">
          <h6>{t.awaitingApproval}</h6>
          <span class="muted">{t.newestFirst}</span>
        </div>

        {
          items.map((item, rowIndex) => (
            <a
              class:list={['row', { 'row-on': item.source_item_id === selected?.source_item_id }]}
              href={itemHref(item.source_item_id)}
              data-tour={rowIndex === 0 ? 'queue-row' : undefined}
              aria-current={item.source_item_id === selected?.source_item_id ? 'true' : undefined}
            >
              <span class="row-meta">
                <span class="kicker">{placeName(item.places)}</span>
                <span class="muted">
                  {item.source_name} · {formatDateTime(lang, new Date(item.retrieved_at))}
                </span>
              </span>
              <span
                class="row-title"
                lang={
                  item.headline_translated == null && item.headline_original != null
                    ? (item.source_lang ?? undefined)
                    : undefined
                }
              >
                {item.headline_translated ?? item.headline_original ?? item.source_item_id}
              </span>
              <span class="row-tags">
                {/* A re-queued origin is a correction, and the row says so
                    before the editor even opens it (#87). */}
                {item.correction_candidate === true && (
                  <span class="tag tag-correction">{t.correctionTag}</span>
                )}
                {item.translation_id === null ? (
                  <span class="tag tag-outline">{t.noTranslationNeeded}</span>
                ) : (
                  <>
                    <span class="tag tag-accent">
                      {(item.source_lang ?? '').toUpperCase()} → {(item.target_lang ?? '').toUpperCase()}
                    </span>
                    {typeof item.cost_microusd === 'number' && (
                      <span class="tag tag-neutral">{formatItemCost(item.cost_microusd)}</span>
                    )}
                  </>
                )}
              </span>
            </a>
          ))
        }

        {
          queue?.holds !== undefined && queue.holds.queued_untranslated > 0 && (
            <div class="hold">
              <h6>{t.queuedUntranslated}</h6>
              <p>{t.queuedUntranslatedBody(queue.holds.queued_untranslated)}</p>
            </div>
          )
        }
        {
          queue?.holds !== undefined && queue.holds.skipped_over_ceiling > 0 && (
            <p class="skip-note">{t.skippedOverCeiling(queue.holds.skipped_over_ceiling)}</p>
          )
        }
        {queueFailed && <p class="skip-note">{reader.unavailableBody}</p>}
        {/* An unprovisioned account could not read the queue at all, so
            the screen must not claim it is empty. */}
        {!queueFailed && !notProvisioned && items.length === 0 && (
          <p class="skip-note">{t.emptyQueue}</p>
        )}
      </div>

      <div class="review" data-tour="review-pane">
        {/* The notice carries the typed attribution whenever no form will:
            the queue unreadable without a token, or the posted item gone
            from it — another editor approved it meanwhile — leaving a
            different row selected whose form refills from its own row. */}
        {
          signedOutPost && (
            <RecordNotice
              notice={noticeForSignedOut(
                t,
                selected?.source_item_id === staleItemId ? null : staleAttribution,
              )}
              action={{ href: `/${lang}/editor/signin`, label: t.signIn }}
            />
          )
        }
        {
          outcome !== null && (
            <RecordNotice
              notice={noticeForApproval(outcome, t, (iso) => formatDateTime(lang, new Date(iso)))}
            />
          )
        }

        {
          selected === undefined ? (
            <p class="empty-review">{t.selectAnItem}</p>
          ) : (
            <>
              <div class="review-head">
                <div class="review-meta">
                  <span class="kicker">source_item {selected.source_item_id.slice(0, 8)}</span>
                  <span class="meta-rule" aria-hidden="true" />
                  <span class="muted">
                    {t.retrievedImmutable(formatDateTime(lang, new Date(selected.retrieved_at)))}
                  </span>
                </div>
                <h3>{t.reviewBeforeApproval}</h3>
              </div>

              {/* A re-queued origin is a correction: the withdrawal that
                  freed it is part of what the editor reviews, so it renders
                  here — when it happened and the recorded reason — rather
                  than staying an invisible backend flag (#87). */}
              {
                selected.correction_candidate === true && (
                  <RecordNotice
                    notice={noticeForCorrection(lastWithdrawal, t, (iso) =>
                      formatDateTime(lang, new Date(iso)),
                    )}
                  />
                )
              }

              <div class="split">
                <section class="original" data-tour="review-original">
                  <div class="col-head">
                    <h6>{t.originalIn(languageName(lang, selected.source_lang ?? ''))}</h6>
                    {safeSourceUrl(selected.source_url ?? '') !== null && (
                      <a href={safeSourceUrl(selected.source_url ?? '')} rel="external noopener">
                        {t.openSource}
                      </a>
                    )}
                  </div>
                  {/* The original column is written in the source language;
                      the lang attribute keeps screen readers from reading
                      German headlines with Greek pronunciation rules
                      (WCAG 3.1.2). Absent source_lang omits the attribute
                      rather than guessing. */}
                  <div class="col-title" lang={selected.source_lang ?? undefined}>
                    {selected.headline_original ?? '—'}
                  </div>
                  <p class="col-extract" lang={selected.source_lang ?? undefined}>
                    {selected.extract_original ?? '—'}
                  </p>
                  <dl class="evidence">
                    <div>
                      <dt>original_author</dt>
                      <dd>{selected.original_author ?? '—'}</dd>
                    </div>
                    <div>
                      <dt>published_at</dt>
                      <dd>
                        {selected.original_published_at === null ||
                        selected.original_published_at === undefined
                          ? '—'
                          : formatDateTime(lang, new Date(selected.original_published_at))}
                      </dd>
                    </div>
                    <div>
                      <dt>content_hash</dt>
                      <dd class="hash">{selected.content_hash ?? '—'}</dd>
                    </div>
                    <div>
                      <dt>{t.licenceAtRetrieval}</dt>
                      <dd>{selected.licence_snapshot}</dd>
                    </div>
                  </dl>
                </section>

                <section class="translated" data-tour="review-translation">
                  <div class="col-head">
                    <h6 class="accent">
                      {selected.translation_id === null
                        ? t.publishedAsIs
                        : t.translationIn(languageName(lang, selected.target_lang ?? ''))}
                    </h6>
                    <span class="muted">
                      {selected.translation_id === null
                        ? t.noTranslationNeeded
                        : `${selected.model ?? '—'} · prompt ${selected.prompt_version ?? '—'}`}
                    </span>
                  </div>
                  {/* When a field falls back to the untranslated original,
                      it keeps the original's language. */}
                  <div
                    class="col-title"
                    lang={
                      selected.headline_translated == null && selected.headline_original != null
                        ? (selected.source_lang ?? undefined)
                        : undefined
                    }
                  >
                    {selected.headline_translated ?? selected.headline_original ?? '—'}
                  </div>
                  <p
                    class="col-extract"
                    lang={
                      selected.extract_translated == null && selected.extract_original != null
                        ? (selected.source_lang ?? undefined)
                        : undefined
                    }
                  >
                    {selected.extract_translated ?? selected.extract_original ?? '—'}
                  </p>
                  <p class="muted extract-note">{t.extractOnlyNote}</p>

                  <form class="approval" method="post" action={here} data-tour="approve-form">
                    <input type="hidden" name="source_item_id" value={selected.source_item_id} />
                    <input
                      type="hidden"
                      name="translation_id"
                      value={selected.translation_id ?? ''}
                    />
                    <div class="field attribution-field">
                      <label for="attribution">{reader.attribution}</label>
                      <input
                        class="input"
                        id="attribution"
                        name="attribution"
                        value={
                          selected.source_item_id === staleItemId && staleAttribution !== null
                            ? staleAttribution
                            : defaultAttribution(selected)
                        }
                        required
                      />
                    </div>
                    {/* Where the article publishes to (FR-009). The API
                        requires at least one slug and the database refuses
                        a placeless article at commit; the server-side POST
                        handling above answers the empty selection with the
                        not-recorded banner, since plain HTML cannot express
                        "at least one of these" and this screen carries no
                        client JavaScript. Only reader-selectable places are
                        offered (APPROVAL_PLACES): a hierarchy-only tag like
                        Bavaria would satisfy the database yet leave the
                        article unreachable through the follow flow.
                        Pre-checked from the queue row's own places, when it
                        names any. */}
                    <fieldset class="field places-field">
                      <legend>{t.publishTo}</legend>
                      <div class="place-options">
                        {
                          APPROVAL_PLACES.map((place) => (
                            <label class="place-option">
                              <input
                                type="checkbox"
                                name="place"
                                value={place.slug}
                                checked={
                                  selected.source_item_id === staleItemId && stalePlaces !== null
                                    ? stalePlaces.includes(place.slug)
                                    : selected.places?.includes(place.slug)
                                }
                              />
                              <span class="box" aria-hidden="true" />
                              <span lang={place.endonymLang !== lang ? place.endonymLang : undefined}>
                                {place.endonym}
                              </span>
                            </label>
                          ))
                        }
                      </div>
                    </fieldset>
                    <label class="ack">
                      <input type="checkbox" name="acknowledged" required />
                      <span class="box" aria-hidden="true" />
                      <span class="ack-text">{t.acknowledgement}</span>
                    </label>
                    {/* Publication happens with this button — there is no
                        separate publish step to warn at — so the one-way
                        statement lives here (#121). */}
                    <p class="muted reject-note">{t.publicationOneWayNote}</p>
                    <div class="actions">
                      <button class="btn btn-primary" type="submit" disabled={!evidenceComplete}>
                        {t.approveAndPublish}
                      </button>
                      <button class="btn btn-secondary" type="button" disabled>{t.reject}</button>
                      <a class="btn btn-ghost skip" href={here}>{t.skip}</a>
                    </div>
                    {!evidenceComplete && <p class="muted reject-note">{t.evidenceIncomplete}</p>}
                    <p class="muted reject-note">{t.rejectNote}</p>
                  </form>
                </section>
              </div>
            </>
          )
        }
      </div>
    </div>
  </EditorChrome>
</ReaderLayout>

<style>
  /* — the unprovisioned-account guidance — */
  .provision {
    padding: var(--space-4) var(--space-6);
    border-bottom: 2px solid var(--color-divider);
    background: var(--color-accent-100);
  }
  .provision h6 {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-800);
  }
  .provision p {
    margin: 0;
    font-size: 13px;
    max-width: 90ch;
    text-wrap: pretty;
  }

  .work {
    display: grid;
    grid-template-columns: 400px 1fr;
    min-height: 0;
  }

  /* — the queue — */
  .queue {
    border-right: 1px solid var(--color-divider);
  }
  .queue-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider);
  }
  .queue-head h6 {
    margin: 0;
  }
  .muted {
    font-size: 11.5px;
    color: var(--ink-soft);
  }
  .queue-head .muted {
    margin-left: auto;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider);
    border-left: 3px solid transparent;
    text-decoration: none;
    color: var(--color-text);
  }
  .row:hover {
    background: color-mix(in srgb, var(--color-text) 4%, transparent);
  }
  .row-on {
    border-left-color: var(--color-accent);
    background: var(--color-accent-100);
  }
  .row-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .kicker {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-700);
  }
  .row-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 15.5px;
    line-height: 1.25;
    text-wrap: pretty;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .row-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .row-tags .tag {
    font-size: 10px;
  }
  .hold {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-surface);
  }
  .hold h6 {
    margin: 0 0 6px;
    font-size: 10px;
    color: var(--color-accent-700);
  }
  .hold p {
    margin: 0;
    font-size: 12.5px;
    text-wrap: pretty;
  }
  .skip-note {
    padding: var(--space-3) var(--space-4);
    margin: 0;
    font-size: 12px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* — the review pane — */
  .review {
    display: flex;
    flex-direction: column;
  }
  .tag-correction {
    background: var(--color-text);
    color: var(--color-accent-400);
  }
  .empty-review {
    padding: var(--space-8) var(--space-6);
    margin: 0;
    color: var(--ink-soft);
  }
  .review-head {
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-divider);
  }
  .review-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }
  .meta-rule {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }
  .review-head h3 {
    margin: 0;
    font-size: 23px;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
  }
  .original {
    padding: var(--space-6);
    border-right: 1px solid var(--color-divider);
    background: var(--color-surface);
  }
  .translated {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .col-head h6 {
    margin: 0;
  }
  .col-head .accent {
    color: var(--color-accent-700);
  }
  .col-head a {
    font-size: 11.5px;
    text-decoration: none;
  }
  .col-title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 20px;
    line-height: 1.2;
    margin-bottom: var(--space-3);
    text-wrap: pretty;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .col-extract {
    font-size: 14px;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }
  .evidence {
    margin: 0;
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-3);
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--ink-muted);
  }
  .evidence > div {
    display: flex;
    gap: var(--space-2);
  }
  .evidence dt {
    flex: none;
    color: var(--ink-soft);
  }
  .evidence dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .hash {
    word-break: break-all;
  }
