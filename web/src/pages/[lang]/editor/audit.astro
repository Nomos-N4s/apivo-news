---
import { API_BASE_URL } from 'astro:env/server';
import EditorChrome from '../../../components/EditorChrome.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import {
  createEditorialApi,
  formatItemCost,
  type ArticleProvenance,
  type WithdrawalOutcome,
} from '../../../lib/editorial/api';
import { editorSession } from '../../../lib/editorial/session';
import { editorialStrings } from '../../../lib/editorial/strings';
import { findPlace, isReadingLanguage } from '../../../lib/reader/axes';
import { formatDateTime, safeSourceUrl } from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// The provenance audit — mockup 1h (issue #67, toward T028 #31). US5 asks
// that anyone with audit access recover, in under five minutes, the source
// an item came from, the licence that applied at retrieval, the model and
// prompt that translated it, and the named person who approved it. The
// view `article_provenance` answers all of it in one query (I-5, FR-010),
// so the screen is that one query rendered.
//
// The legal basis on this screen always comes from the retrieval-time
// snapshots, never from the mutable source row — the defence rests on
// what applied at the time.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = editorialStrings(lang);
const reader = uiStrings(lang);
const session = editorSession(Astro.request);
const api = createEditorialApi(API_BASE_URL, session.token);

const here = `/${lang}/editor/audit`;

// Withdrawal ends publication and preserves every record (FR-016). Like
// approval, it is audited, so with nothing to audit into the screen must
// not suggest publication ended.
let withdrawal: WithdrawalOutcome | null = null;
let withdrawnId = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  withdrawnId = String(form.get('article_id') ?? '');
  const reason = String(form.get('reason') ?? '');
  if (withdrawnId !== '' && reason.trim() !== '') {
    try {
      withdrawal = await api.withdraw(withdrawnId, reason);
    } catch (error) {
      withdrawal = {
        recorded: false,
        reason: error instanceof Error ? error.message : String(error),
      };
    }
  }
}

const queryId = Astro.url.searchParams.get('id') ?? withdrawnId;
let record: ArticleProvenance | null = null;
let traceFailed = false;
try {
  record = await api.provenance(queryId);
} catch {
  traceFailed = true;
  Astro.response.status = 503;
}

const placeNames = (record?.places ?? [])
  .map((slug) => findPlace(slug)?.endonym ?? slug)
  .join(' · ');
const sourceHref = safeSourceUrl(record?.source_item.source_url ?? '');
const initials = (record?.approval.approver_name ?? '')
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<ReaderLayout lang={lang} title={`epiloYES — ${t.audit}`} description={reader.tagline}>
  <EditorChrome lang={lang} session={session} active="audit" note={t.readOnlyAccess}>
    <form class="trace" method="get" action={here}>
      <div class="field">
        <label for="trace-id">{t.traceLabel}</label>
        <input class="input" id="trace-id" name="id" value={record?.article_id ?? queryId} />
      </div>
      <button class="btn btn-primary" type="submit">{t.trace}</button>
    </form>

    <div class="query">
      <code>select * from article_provenance where article_id = $1</code>
      <span class="rows">{record === null ? '0 rows' : '1 row'}</span>
    </div>

    {
      withdrawal !== null && (
        <div class:list={['banner', { 'banner-warn': !withdrawal.recorded }]}>
          <span class="banner-label">
            {withdrawal.recorded ? t.withdraw : t.notRecordedTitle}
          </span>
          <span class="banner-body">{withdrawal.reason}</span>
        </div>
      )
    }

    {traceFailed && <p class="notice">{reader.unavailableBody}</p>}
    {/* An id that matched nothing is "not found"; no id at all is simply
        an empty field waiting for one. */}
    {
      !traceFailed && record === null && (
        <p class="notice">{queryId === '' ? t.traceLabel : t.traceNotFound}</p>
      )
    }

    {
      record !== null && (
        <div class="split">
          <div class="col">
            <section class="block">
              <h6>{t.publishedItem}</h6>
              <div class="headline">{record.headline}</div>
              <div class="muted">
                published_at{' '}
                {record.published_at === null
                  ? '—'
                  : formatDateTime(lang, new Date(record.published_at))}{' '}
                · {t.placesLabel} {placeNames}
              </div>
            </section>

            <section class="block">
              <h6>{t.sourceAndLicence}</h6>
              <dl class="pairs">
                <dt>source_name</dt>
                <dd class="strong">{record.source.name}</dd>
                <dt>source_feed_url</dt>
                <dd class="mono">{record.source.feed_url}</dd>
                <dt>source_url</dt>
                <dd class="mono">
                  {sourceHref === null ? (
                    record.source_item.source_url
                  ) : (
                    <a href={sourceHref} rel="external noopener">
                      {record.source_item.source_url}
                    </a>
                  )}
                </dd>
                <dt>jurisdiction</dt>
                <dd>{record.source.jurisdiction}</dd>
                <dt>retrieved_at</dt>
                <dd>{formatDateTime(lang, new Date(record.source_item.retrieved_at))}</dd>
                <dt>content_hash</dt>
                <dd class="mono">{record.source_item.content_hash}</dd>
                <dt>licence_snapshot</dt>
                <dd>{record.source_item.licence_snapshot}</dd>
                <dt>usage_rule</dt>
                <dd>
                  <span class="tag tag-accent">{record.source_item.usage_rule_snapshot}</span>
                </dd>
                <dt>permission_evidence</dt>
                <dd class="faint">
                  {record.source_item.permission_evidence_snapshot ?? '— none on record'}
                </dd>
              </dl>
              <p class="note">{t.snapshotNote}</p>
            </section>

            <section class="block">
              <h6>{t.translationLineage}</h6>
              {record.translation === null ? (
                <p class="faint no-lineage">{t.noTranslationLineage}</p>
              ) : (
                <dl class="pairs">
                  <dt>model</dt>
                  <dd>{record.translation.model}</dd>
                  <dt>prompt_version</dt>
                  <dd>{record.translation.prompt_version}</dd>
                  <dt>target_locale</dt>
                  <dd>{record.translation.target_locale}</dd>
                  <dt>generated_at</dt>
                  <dd>{formatDateTime(lang, new Date(record.translation.generated_at))}</dd>
                  {record.translation.cost_microusd !== undefined && (
                    <>
                      <dt>cost_microusd</dt>
                      <dd>
                        {record.translation.cost_microusd}{' '}
                        <span class="faint">({formatItemCost(record.translation.cost_microusd)})</span>
                      </dd>
                    </>
                  )}
                </dl>
              )}
            </section>
          </div>

          <div class="col col-right">
            <section class="block">
              <h6>{t.namedApprover}</h6>
              <div class="approver">
                <span class="avatar" aria-hidden="true">{initials}</span>
                <div>
                  <div class="strong">{record.approval.approver_name}</div>
                  <div class="muted">{record.approval.approver_email} · role editor</div>
                </div>
              </div>
              <div class="muted">
                approved_at {formatDateTime(lang, new Date(record.approval.approved_at))}
              </div>
            </section>

            {
              record.events !== undefined && record.events.length > 0 && (
                <section class="block">
                  <h6>{t.eventStream}</h6>
                  <ol class="events">
                    {record.events.map((event) => (
                      <li>
                        <span class="dot" aria-hidden="true" />
                        <div>
                          <div class="event-type">{event.type}</div>
                          <div class="muted">
                            {formatDateTime(lang, new Date(event.occurred_at))} · {event.detail}
                          </div>
                        </div>
                      </li>
                    ))}
                  </ol>
                </section>
              )
            }

            <section class="block withdraw">
              <h6>{t.withdrawTitle}</h6>
              <p class="withdraw-body">{t.withdrawBody}</p>
              {record.withdrawal !== null ? (
                <p class="faint">
                  {t.withdrawnAlready} ·{' '}
                  {formatDateTime(lang, new Date(record.withdrawal.withdrawn_at))} ·{' '}
                  {record.withdrawal.reason}
                </p>
              ) : (
                <form method="post" action={here}>
                  <input type="hidden" name="article_id" value={record.article_id} />
                  <div class="field">
                    <label for="withdraw-reason">{t.withdrawReasonLabel}</label>
                    <input class="input" id="withdraw-reason" name="reason" required />
                  </div>
                  <div class="withdraw-actions">
                    <button class="btn btn-primary" type="submit">{t.withdraw}</button>
                    <span class="muted">{t.requiresEditorRole}</span>
                  </div>
                </form>
              )}
            </section>
          </div>
        </div>
      )
    }
  </EditorChrome>
</ReaderLayout>

<style>
  .trace {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-divider);
  }
  .trace .field {
    flex: 1;
  }
  .query {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-6);
    border-bottom: 2px solid var(--color-divider);
    background: var(--color-surface);
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11.5px;
  }
  .query code {
    color: var(--ink-soft);
  }
  .rows {
    margin-left: auto;
    color: var(--color-accent-700);
  }

  .banner {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent-700);
    color: var(--color-bg);
  }
  .banner-warn {
    background: var(--color-text);
  }
  .banner-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex: none;
  }
  .banner-warn .banner-label {
    color: var(--color-accent-400);
  }
  .banner-body {
    font-size: 13px;
    max-width: 80ch;
  }
  .notice {
    margin: 0;
    padding: var(--space-8) var(--space-6);
    color: var(--ink-soft);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
  }
  .col {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-divider);
  }
  .col-right {
    border-right: 0;
  }
  .block {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-divider);
  }
  .block h6 {
    margin: 0 0 var(--space-3);
    color: var(--color-accent-700);
  }
  .headline {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 20px;
    line-height: 1.2;
    margin-bottom: var(--space-2);
    text-wrap: pretty;
  }
  .muted {
    font-size: 12px;
    color: var(--ink-soft);
  }
  .faint {
    color: var(--ink-soft);
  }
  .strong {
    font-weight: 600;
  }

  .pairs {
    margin: 0;
    display: grid;
    grid-template-columns: 132px 1fr;
    row-gap: var(--space-2);
    column-gap: var(--space-3);
    font-size: 12px;
  }
  .pairs dt {
    color: var(--ink-soft);
  }
  .pairs dd {
    margin: 0;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .mono {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11px;
    word-break: break-all;
  }
  .note {
    margin: var(--space-3) 0 0;
    font-size: 11.5px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .no-lineage {
    margin: 0;
    font-size: 12px;
  }

  .approver {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .avatar {
    width: 38px;
    height: 38px;
    flex: none;
    background: var(--color-text);
    color: var(--color-bg);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
  }

  .events {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .events li {
    display: flex;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    margin-left: 5px;
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-divider);
    position: relative;
  }
  .events li:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .dot {
    position: absolute;
    left: -5px;
    top: 4px;
    width: 9px;
    height: 9px;
    background: var(--color-accent);
  }
  .event-type {
    font-size: 12.5px;
    font-weight: 600;
  }

  .withdraw {
    background: var(--color-surface);
    border-bottom: 0;
    margin-top: auto;
  }
  .withdraw-body {
    margin: 0 0 var(--space-3);
    font-size: 12.5px;
    text-wrap: pretty;
  }
  .withdraw .field {
    margin-bottom: var(--space-3);
  }
  .withdraw-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 1000px) {
    .split {
      grid-template-columns: 1fr;
    }
    .col {
      border-right: 0;
    }
  }
</style>
