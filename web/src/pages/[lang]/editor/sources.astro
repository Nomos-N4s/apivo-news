---
import { API_BASE_URL } from 'astro:env/server';
import EditorChrome from '../../../components/EditorChrome.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import RecordNotice from '../../../components/RecordNotice.astro';
import {
  noticeForBulk,
  noticeForNothingSelected,
  noticeForRowRefusal,
  noticeForSignedOut,
  noticeForSource,
  noticeForSourceEdit,
} from '../../../lib/editorial/notices';
import {
  allSources,
  bulkCounts,
  createEditorialApi,
  runBulkAction,
  type BulkAction,
  type SourceActionOutcome,
  type SourceList,
  type SourceOutcome,
  type SourceRowOutcome,
} from '../../../lib/editorial/api';
import {
  activeFilters,
  filterOptions,
  filterQuery,
  filterSources,
  NO_FILTERS,
  parseSourceFilters,
  presentValues,
  type SourceFilters,
} from '../../../lib/editorial/sourceFilters';
import {
  BASELINE_FIELD,
  parseSourceEditForm,
  renderedBaseline,
  type SourceEditFields,
} from '../../../lib/editorial/sourceForm';
import { isSameOrigin } from '../../../lib/csrf';
import { editorSession } from '../../../lib/editorial/session';
import { editorialStrings } from '../../../lib/editorial/strings';
import { authConfigured } from '../../../lib/editorial/supabase';
import { isReadingLanguage } from '../../../lib/reader/axes';
import { formatDateTime } from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// Source management — mockup 1i (issue #70, toward T014 #17), managed
// since #118. The screen exists to make the licensing invariant visible
// rather than implicit: ingestion happens only from configured RSS/Atom
// feeds and never by scraping (FR-001); every new source is
// extract_and_link and a full-text rule is impossible without recorded
// written permission (FR-004); and repeated retrieval of identical
// content creates no duplicate (FR-014), which is why the poll cycle
// reports what the fingerprint skipped.
//
// Management follows the invariants too: deactivation is the everyday
// "remove" (history intact), deletion succeeds only where no evidence
// exists — the database's FK refuses the rest and this screen REPORTS
// each refusal in the API's own words, never converting it into a
// deactivation the editor did not choose. Edits are licensing events the
// audit stream records with old and new.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = editorialStrings(lang);
const reader = uiStrings(lang);
const session = editorSession(Astro.request);

// Configuring a source is a licensing decision on the record, so it needs
// a named editor's own token when there is an auth provider to get one
// from. Without one this stays the fixture preview.
//
// Only a GET is redirected: a POST from a session that expired mid-edit
// re-renders here with a signed-out notice and the form still filled,
// because a redirect would arrive at sign-in as a GET with it all gone.
const configured = authConfigured();
const signedOut = configured && !session.authenticated;
if (signedOut && Astro.request.method !== 'POST') {
  return Astro.redirect(`/${lang}/editor/signin`);
}

const api = createEditorialApi(API_BASE_URL, session.token);

// The filters live in the query string, so a narrowed table survives a
// POST re-render, comes back on the browser's back button, and can be
// handed to someone else as a URL.
const filters = parseSourceFilters(Astro.url.searchParams);
const editId = Astro.url.searchParams.get('edit');

/**
 * This page's own URL carrying the current filters plus the given params.
 * Every link and form action on the screen goes through here: a link that
 * built its own query string would silently drop whatever narrowing the
 * editor had chosen.
 */
function pageURL(
  params: Record<string, string> = {},
  forFilters: SourceFilters = filters,
): string {
  const query = new URLSearchParams(filterQuery(forFilters));
  for (const [key, value] of Object.entries(params)) {
    query.set(key, value);
  }
  const search = query.toString();
  return `/${lang}/editor/sources${search === '' ? '' : `?${search}`}`;
}

const here = pageURL();

let outcome: SourceOutcome | null = null;
let editOutcome: SourceActionOutcome | null = null;
let bulkAction: BulkAction | null = null;
let bulkOutcomes: readonly SourceRowOutcome[] | null = null;
let noneSelected = false;
let signedOutPost = false;
let submitted: {
  name: string;
  url: string;
  language: string;
  jurisdiction: string;
  licence_terms: string;
} | null = null;
// What an edit had on screen, kept whenever nothing was recorded so the
// re-render puts it back instead of charging the editor for retyping
// licensing details over a refusal they did not cause.
let editTyped: SourceEditFields | null = null;
if (Astro.request.method === 'POST') {
  // Every intent on this screen is a licensing record under the editor's
  // own credentials — the same privileged shape as approval, so it takes
  // the same origin check before the body is even read.
  if (!isSameOrigin(Astro.request, Astro.url.origin)) {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'add');
  if (signedOut) {
    // No token, so nothing can be recorded; the typed licensing details
    // go back into the form rather than into a redirect's void.
    signedOutPost = true;
    if (intent === 'add') {
      submitted = {
        name: String(form.get('name') ?? ''),
        url: String(form.get('url') ?? ''),
        language: String(form.get('language') ?? ''),
        jurisdiction: String(form.get('jurisdiction') ?? ''),
        licence_terms: String(form.get('licence_terms') ?? ''),
      };
    } else if (intent === 'update') {
      editTyped = parseSourceEditForm(form).typed;
    }
  } else if (intent === 'add') {
    const input = {
      name: String(form.get('name') ?? ''),
      url: String(form.get('url') ?? ''),
      language: String(form.get('language') ?? ''),
      jurisdiction: String(form.get('jurisdiction') ?? ''),
      licence_terms: String(form.get('licence_terms') ?? ''),
    };
    if (input.name.trim() !== '' && input.url.trim() !== '') {
      try {
        outcome = await api.addSource(input);
      } catch (error) {
        outcome = {
          recorded: false,
          reason: error instanceof Error ? error.message : String(error),
        };
      }
    } else {
      // A single space satisfies the browser's `required` check and this
      // trim, so the form can arrive with nothing usable in it. Saying
      // nothing at all would leave the editor looking at an unchanged
      // screen with no idea their source was never sent — and the typed
      // licensing details go back into the form, not into the void.
      outcome = { recorded: false, reason: t.sourceNeedsNameAndUrl };
      submitted = input;
    }
  } else if (intent === 'update') {
    // The row edit sends only the fields whose value differs from the one
    // the form was rendered with. Absent means unchanged — the API diffs
    // supplied values against the CURRENT row, so re-sending an untouched
    // field would revert whatever another editor altered in between and
    // put that revert into the audit stream under this editor's name.
    const edit = parseSourceEditForm(form);
    editTyped = edit.typed;
    if (edit.ok) {
      try {
        editOutcome = await api.updateSource(edit.id, edit.patch);
      } catch (error) {
        editOutcome = {
          recorded: false,
          reason: error instanceof Error ? error.message : String(error),
        };
      }
    } else if (edit.refusal === 'no-change') {
      editOutcome = { recorded: false, reason: t.sourceUnchanged };
    } else if (edit.refusal === 'no-baseline') {
      editOutcome = { recorded: false, reason: t.editFormIncomplete };
    }
    if (editOutcome?.recorded === true) {
      // The save landed, so the form's next baseline is the row the list
      // is about to be re-read as — not what was typed at it.
      editTyped = null;
    }
  } else if (intent === 'bulk') {
    // The bulk actions are a client-side loop over the per-row endpoints
    // (#118): no bulk endpoint, no transaction across rows, and therefore
    // no summary allowed to pretend otherwise — every row's own outcome
    // is kept and the refused ones render inline below.
    const action = String(form.get('bulk') ?? '');
    const ids = form.getAll('selected').map(String);
    if (action === 'activate' || action === 'deactivate' || action === 'delete') {
      if (ids.length === 0) {
        noneSelected = true;
      } else {
        bulkAction = action;
        bulkOutcomes = await runBulkAction(api, action, ids);
      }
    }
  }
}

// The whole registry, not page one: the endpoint paginates, and a screen
// whose purpose is licensing visibility must not silently lose the 21st
// source or count only what one page held. allSources follows next_cursor
// to exhaustion (bounded); if the bound is ever hit, `truncated` renders
// the explicit notice below instead of pretending the list is complete.
// It is fetched after any POST action, so the table is the state the
// actions left behind.
let page: SourceList | null = null;
let failed = false;
try {
  page = await allSources(api);
} catch {
  failed = true;
  Astro.response.status = 503;
}

const sources = page?.items ?? [];
const activeCount = sources.filter((source) => source.active).length;
// The cycle names the feeds whose last poll failed; it is what the health
// filter and the failing-first order read. An unreadable list is no list.
const failures: readonly unknown[] = page?.cycle.failures ?? [];
// Filtered and ordered in one place, over the whole walked registry.
const shown = filterSources(sources, filters, failures);
const editing = editId === null ? null : (sources.find((source) => source.id === editId) ?? null);

// Per-row refusals, keyed to the rows that still stand: a refused delete
// renders the API's words — the evidence count included — inline at its
// row, never a generic failure.
const refusedById = new Map<string, SourceActionOutcome>();
if (bulkOutcomes !== null) {
  for (const row of bulkOutcomes) {
    if (!row.outcome.recorded) {
      refusedById.set(row.id, row.outcome);
    }
  }
}
const counts = bulkOutcomes === null ? null : bulkCounts(bulkOutcomes);
const bulkLabel =
  bulkAction === 'activate'
    ? t.bulkActivate
    : bulkAction === 'deactivate'
      ? t.bulkDeactivate
      : t.bulkDelete;
const bulkSummary =
  counts === null
    ? ''
    : bulkAction === 'activate'
      ? t.bulkActivateSummary(counts.recorded, counts.refused)
      : bulkAction === 'deactivate'
        ? t.bulkDeactivateSummary(counts.recorded, counts.refused)
        : t.bulkDeleteSummary(counts.recorded, counts.refused);

// A refusal whose row is not on screen would otherwise be counted in the
// summary and explained nowhere: the list re-read can fail after the bulk
// loop has already run, and the view filter can hide a row the action
// just changed. Those refusals are named here instead, so the count in
// the summary always has its evidence somewhere on the page.
const shownIds = new Set(shown.map((source) => source.id));
const orphanedRefusals = [...refusedById.entries()]
  .filter(([id]) => !shownIds.has(id))
  .map(([id, refusal]) => ({
    id,
    // The row may be gone from the list entirely; its name is whatever the
    // pre-action list knew, and the id when even that is unavailable.
    name: sources.find((source) => source.id === id)?.name ?? id,
    refusal,
  }));

// Each control's options, with the count each would show if chosen while
// the other filters stay as they are.
const stateOptions = [
  { value: 'all', label: t.viewAll },
  { value: 'active', label: t.viewActive },
  { value: 'inactive', label: t.viewInactive },
] as const;
const healthOptions = [
  { value: 'any', label: t.filterAny },
  { value: 'healthy', label: t.healthHealthy },
  { value: 'failing', label: t.healthFailing },
  { value: 'never', label: t.healthNever },
  { value: 'unpolled', label: t.healthUnpolled },
] as const;
// The options come from what was loaded, but the filter can hold a value
// those rows do not contain — a stale link, or a value that lives beyond
// the truncation bound. Without its own option the browser would show the
// FIRST one as selected, so the control would read "all languages" while
// the table stood narrowed, and pressing Apply would silently drop the
// filter. The applied value is therefore always offered.
const withApplied = (values: readonly string[], applied: string): string[] =>
  applied === '' || values.includes(applied) ? [...values] : [...values, applied];
const languageValues = withApplied(['', ...presentValues(sources, 'language')], filters.language);
const jurisdictionValues = withApplied(
  ['', ...presentValues(sources, 'jurisdiction')],
  filters.jurisdiction,
);

const countFor = (dimension: keyof SourceFilters, values: readonly string[]) =>
  new Map(
    filterOptions(sources, filters, failures, dimension, values).map((option) => [
      option.value,
      option.count,
    ]),
  );
const stateCounts = countFor('view', stateOptions.map((option) => option.value));
const healthCounts = countFor('health', healthOptions.map((option) => option.value));
const languageCounts = countFor('language', languageValues);
const jurisdictionCounts = countFor('jurisdiction', jurisdictionValues);

// The chips name what is narrowing the table, each linking to the same
// page with that one filter dropped.
const dimensionLabels: Record<keyof SourceFilters, string> = {
  view: t.filterState,
  language: t.filterLanguage,
  jurisdiction: t.filterJurisdiction,
  health: t.filterHealth,
  search: t.filterSearch,
};
// Only the two enum dimensions have vocabularies to translate, and each
// is looked up under its OWN dimension: a shared value-keyed map would
// let a search for "never" wear the never-polled filter's label, in the
// chip, in its remove action and in the sentence whose whole job is
// naming what emptied the table. A Map also keeps the lookup off
// Object.prototype, where a search for "toString" would have found a
// function and rendered its source.
const enumLabels = new Map<string, string>([
  ['view:active', t.viewActive],
  ['view:inactive', t.viewInactive],
  ['health:healthy', t.healthHealthy],
  ['health:failing', t.healthFailing],
  ['health:never', t.healthNever],
  ['health:unpolled', t.healthUnpolled],
]);
const chips = activeFilters(filters).map((chip) => ({
  ...chip,
  dimension: dimensionLabels[chip.key],
  // A language code, a jurisdiction code or a typed search term is the
  // editor's own text: it renders as itself.
  shown: enumLabels.get(`${chip.key}:${chip.value}`) ?? chip.value,
}));
---

<ReaderLayout lang={lang} title={`epiloYES — ${t.sources}`} description={reader.tagline}>
  <EditorChrome
    lang={lang}
    session={session}
    active="sources"
    note={t.sourcesSummary(sources.length, activeCount)}
    previewData={page?.fixture === true}
  >
    {/* The typed licensing details go back into the form on the signed-out
        re-render, so the notice carries no stale text of its own. */}
    {
      signedOutPost && (
        <RecordNotice
          notice={noticeForSignedOut(t, null)}
          action={{ href: `/${lang}/editor/signin`, label: t.signIn }}
        />
      )
    }
    {outcome !== null && <RecordNotice notice={noticeForSource(outcome, t)} />}
    {editOutcome !== null && <RecordNotice notice={noticeForSourceEdit(editOutcome, t)} />}
    {noneSelected && <RecordNotice notice={noticeForNothingSelected(t)} />}
    {/* The exact arithmetic of what happened, refusals counted and named
        per row below — never a partial-success lie. */}
    {
      counts !== null && (
        <RecordNotice
          notice={noticeForBulk(
            bulkLabel,
            bulkSummary,
            counts.refused,
            // Deactivation is the one action whose consequences are widely
            // misread, so a recorded one says what it kept — but only when
            // every row was recorded. "Polling has stopped" is an
            // unqualified statement about the action, and over a mixed
            // result it would cover the rows that refused, where polling
            // carries on.
            bulkAction === 'deactivate' && counts.recorded > 0 && counts.refused === 0
              ? t.deactivationKeepsRecord
              : undefined,
          )}
        />
      )
    }
    {/* Refusals with no row left to sit beside — the list re-read failed
        after the action, or the view filter hides the row it changed.
        The summary counts them, so their words have to be somewhere. */}
    {
      orphanedRefusals.map((entry) => (
        <RecordNotice
          notice={{
            ...noticeForRowRefusal(entry.refusal, t),
            label: entry.name,
          }}
          action={
            entry.refusal.status === 409
              ? { href: pageURL({ edit: entry.id }, NO_FILTERS), label: t.deactivateInstead }
              : undefined
          }
        />
      ))
    }

    <div class="split">
      <div class="list">
        {failed && <p class="notice">{reader.unavailableBody}</p>}
        {!failed && sources.length === 0 && <p class="notice">{t.sourcesEmpty}</p>}

        {/* A GET form: the filters end up in the URL, so a narrowed table
            is shareable, survives the back button and outlives a POST
            re-render. Submitting is one button — the screen carries no
            client JavaScript, so nothing filters as you type. */}
        {
          sources.length > 0 && (
            <form
              class="filters"
              method="get"
              action={`/${lang}/editor/sources`}
              role="search"
              aria-labelledby="filters-heading"
            >
              <h6 id="filters-heading">{t.filtersHeading}</h6>
              <div class="filter-row">
                <label class="filter">
                  <span>{t.filterState}</span>
                  <select class="input" name="view">
                    {stateOptions.map((option) => (
                      <option value={option.value} selected={filters.view === option.value}>
                        {t.filterOptionCount(option.label, stateCounts.get(option.value) ?? 0)}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="filter">
                  <span>{t.filterLanguage}</span>
                  <select class="input" name="language">
                    {languageValues.map((value) => (
                      <option value={value} selected={filters.language === value}>
                        {t.filterOptionCount(
                          value === '' ? t.filterAny : value,
                          languageCounts.get(value) ?? 0,
                        )}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="filter">
                  <span>{t.filterJurisdiction}</span>
                  <select class="input" name="jurisdiction">
                    {jurisdictionValues.map((value) => (
                      <option value={value} selected={filters.jurisdiction === value}>
                        {t.filterOptionCount(
                          value === '' ? t.filterAny : value,
                          jurisdictionCounts.get(value) ?? 0,
                        )}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="filter">
                  <span>{t.filterHealth}</span>
                  <select class="input" name="health">
                    {healthOptions.map((option) => (
                      <option value={option.value} selected={filters.health === option.value}>
                        {t.filterOptionCount(option.label, healthCounts.get(option.value) ?? 0)}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="filter filter-search">
                  <span>{t.filterSearch}</span>
                  <input
                    class="input"
                    type="search"
                    name="q"
                    value={filters.search}
                    placeholder={t.filterSearchHint}
                  />
                </label>
                <button class="btn btn-secondary" type="submit">
                  {t.filterApply}
                </button>
              </div>
              {/* What the API can and cannot say about a feed's health. */}
              <p class="filter-note">{t.healthFailingNote}</p>
            </form>
          )
        }

        {
          chips.length > 0 && (
            <div class="chips">
              {chips.map((chip) => (
                <a
                  class="chip"
                  href={pageURL({}, chip.without)}
                  aria-label={t.filterRemove(chip.dimension, chip.shown)}
                >
                  {t.filterChipLabel(chip.dimension, chip.shown)}
                  <span aria-hidden="true">×</span>
                </a>
              ))}
              <a class="chip-clear" href={pageURL({}, NO_FILTERS)}>
                {t.filtersClear}
              </a>
            </div>
          )
        }

        {/* Narrowed to nothing: name what did it and offer the way back,
            rather than leaving an empty table to explain itself. */}
        {
          !failed && sources.length > 0 && shown.length === 0 && (
            <p class="notice">
              {t.filteredEmpty}{' '}
              {chips.map((chip) => t.filterChipLabel(chip.dimension, chip.shown)).join(' · ')}{' '}
              <a href={pageURL({}, NO_FILTERS)}>{t.filtersClear}</a>
            </p>
          )
        }

        {/* The bulk form wraps the table so each row's checkbox belongs to
            it; the three buttons are its submitters. The eight-column table
            scrolls sideways on narrow viewports; tabindex + role make that
            scroll reachable by keyboard (WCAG 2.1.1) and give it a name for
            screen readers. */}
        {
          shown.length > 0 && (
            <form method="post" action={here}>
              <input type="hidden" name="intent" value="bulk" />
              <div class="bulk-bar">
                {/* Hidden until the script that gives it meaning is
                    running. It has no name, is never submitted and does
                    nothing on its own; rendered as an operative checkbox
                    beside a bulk DELETE it would look armed while being
                    inert, which is the wrong surprise on that verb. Every
                    row stays individually selectable without it. */}
                <label class="select-all" id="select-all-label" hidden>
                  <input type="checkbox" id="select-all" />
                  {t.selectAll}
                </label>
                <button class="btn btn-secondary" type="submit" name="bulk" value="deactivate">
                  {t.bulkDeactivate}
                </button>
                <button class="btn btn-secondary" type="submit" name="bulk" value="activate">
                  {t.bulkActivate}
                </button>
                <button class="btn btn-secondary btn-delete" type="submit" name="bulk" value="delete">
                  {t.bulkDelete}
                </button>
              </div>
              <p class="bulk-note">{t.bulkBarNote}</p>
              <div class="table-scroll" tabindex="0" role="region" aria-label={t.sources}>
                <table class="table">
                  <thead>
                    <tr>
                      <th class="check-col" />
                      <th>{t.colSource}</th>
                      <th>{t.colFeed}</th>
                      <th>{t.colLang}</th>
                      <th>{t.colUsageRule}</th>
                      <th>{t.colLastPoll}</th>
                      <th>{t.colState}</th>
                      <th />
                    </tr>
                  </thead>
                  <tbody>
                    {shown.map((source) => {
                      // One lookup, narrowed once: the cast this replaces was
                      // the file's only unchecked assertion, and it was
                      // guarded by a different expression than the one it
                      // narrowed.
                      const refusal = refusedById.get(source.id);
                      return (
                      <>
                        <tr>
                          <td class="check-col">
                            <input
                              type="checkbox"
                              name="selected"
                              value={source.id}
                              class="row-select"
                              aria-label={t.selectRow(source.name)}
                            />
                          </td>
                          <td class="strong">{source.name}</td>
                          <td class="mono">{source.url}</td>
                          <td>{source.language}</td>
                          <td>
                            <span class="tag tag-accent">{source.usage_rule}</span>
                          </td>
                          <td class="small">
                            {source.last_polled_at === null
                              ? t.neverPolled
                              : formatDateTime(lang, new Date(source.last_polled_at))}
                          </td>
                          <td class="small">
                            {source.active ? (
                              <span class="state-active">{t.stateActive}</span>
                            ) : (
                              <span class="state-paused">{t.statePaused}</span>
                            )}
                          </td>
                          <td class="small">
                            <a href={pageURL({ edit: source.id })}>{t.editSource}</a>
                          </td>
                        </tr>
                        {refusal !== undefined && (
                          <tr class="row-refusal">
                            {/* One cell across all eight columns: a leading
                                empty cell would cut an untinted notch out of
                                the left edge of the notice's band. */}
                            <td colspan="8">
                              {/* The API's own words — a refused delete names
                                  the evidence count — followed by what the
                                  refusal means. Deactivation is offered as a
                                  way in to the row's own edit form, where the
                                  editor performs it: nothing here converts a
                                  refused delete into an action they did not
                                  choose, and the audited PATCH stays the one
                                  path that changes a source. */}
                              <RecordNotice
                                notice={noticeForRowRefusal(refusal, t)}
                                action={
                                  refusal.status === 409 && source.active
                                    ? {
                                        href: pageURL({ edit: source.id }),
                                        label: t.deactivateInstead,
                                      }
                                    : undefined
                                }
                              />
                            </td>
                          </tr>
                        )}
                      </>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </form>
          )
        }

        {/* The page bound was hit with more pages on offer: say so. A
            silently-partial table is the one option this screen's purpose
            rules out. */}
        {page?.truncated === true && <p class="notice">{t.sourcesTruncated}</p>}

        {
          page !== null && (
            <div class="cycle">
              <div>
                <h6>{t.lastPollCycle}</h6>
                <p>{t.cycleSummary(page.cycle.retrieved, page.cycle.duplicates_skipped)}</p>
              </div>
              <div>
                <h6>{t.failures}</h6>
                {page.cycle.failures.length === 0 ? (
                  <p>{t.noFailures}</p>
                ) : (
                  page.cycle.failures.map((failure) => <p>{failure}</p>)
                )}
              </div>
            </div>
          )
        }
      </div>

      {
        editing !== null ? (
          /* The action keeps `edit` in the URL, so a refusal — a held
             url, an expired session — re-renders THIS form with the
             licensing details still in it, rather than the add form with
             them gone. */
          <form class="add" method="post" action={pageURL({ edit: editing.id })}>
            <input type="hidden" name="intent" value="update" />
            <input type="hidden" name="id" value={editing.id} />
            {/* What this form is showing, carried back with the
                submission: the patch is built from the fields that
                actually differ from it, so a field another editor changed
                meanwhile is not silently reverted by an editor who never
                touched it. */}
            <input
              type="hidden"
              name={BASELINE_FIELD}
              value={renderedBaseline({
                name: editing.name,
                url: editing.url,
                licence_terms: editing.licence_terms,
                active: editing.active,
              })}
            />
            <h6>{t.editingSource(editing.name)}</h6>
            <div class="field">
              <label for="e-name">{t.publisherName}</label>
              <input
                class="input"
                id="e-name"
                name="name"
                value={editTyped?.name ?? editing.name}
                required
              />
            </div>
            <div class="field">
              <label for="e-url">{t.feedUrl}</label>
              <input
                class="input"
                id="e-url"
                name="url"
                type="url"
                value={editTyped?.url ?? editing.url}
                required
              />
            </div>
            <div class="field">
              <label for="e-terms">{t.licenceTerms}</label>
              <textarea class="input" id="e-terms" name="licence_terms" required>{editTyped?.licence_terms ?? editing.licence_terms}</textarea>
            </div>
            <label class="active-toggle">
              <input type="checkbox" name="active" checked={editTyped?.active ?? editing.active} />
              {t.activeField}
            </label>
            {/* Edits are licensing events: the audit stream records old and
                new, and the retrieval-time snapshots never move (I-4). */}
            <p class="rule-note">{t.editAudited}</p>
            <button class="btn btn-primary btn-block" type="submit">{t.saveChanges}</button>
            <a class="cancel-link" href={here}>{t.cancel}</a>
          </form>
        ) : (
          <form class="add" method="post" action={here} data-tour="sources-add">
            <input type="hidden" name="intent" value="add" />
            <h6>{t.addSource}</h6>
            <div class="field">
              <label for="s-name">{t.publisherName}</label>
              <input class="input" id="s-name" name="name" value={submitted?.name ?? ''} required />
            </div>
            <div class="field">
              <label for="s-url">{t.feedUrl}</label>
              <input
                class="input"
                id="s-url"
                name="url"
                type="url"
                placeholder="https://…"
                value={submitted?.url ?? ''}
                required
              />
            </div>
            <div class="pair">
              <div class="field">
                <label for="s-lang">{t.languageField}</label>
                <input
                  class="input"
                  id="s-lang"
                  name="language"
                  value={submitted?.language ?? 'de'}
                  required
                />
              </div>
              <div class="field">
                <label for="s-jur">{t.jurisdictionField}</label>
                <input
                  class="input"
                  id="s-jur"
                  name="jurisdiction"
                  value={submitted?.jurisdiction ?? 'DE'}
                  required
                />
              </div>
            </div>
            <div class="field">
              <label for="s-terms">{t.licenceTerms}</label>
              <textarea class="input" id="s-terms" name="licence_terms" required>{submitted?.licence_terms}</textarea>
            </div>

            {/* The usage rule is stated, not chosen: the contract does not
                accept it and the database defaults it, so offering it as a
                control would imply an editorial choice that does not exist
                (FR-004). */}
            <h6 class="rule-heading">{t.usageRuleHeading}</h6>
            <div class="rule rule-on">
              <span class="mark" aria-hidden="true" />
              <div>
                <div class="rule-title">{t.extractAndLinkTitle}</div>
                <p class="rule-body">{t.extractAndLinkBody}</p>
              </div>
            </div>
            <div class="rule rule-off">
              <span class="mark mark-off" aria-hidden="true" />
              <div>
                <div class="rule-title">{t.fullTextTitle}</div>
                <p class="rule-body">{t.fullTextBody}</p>
              </div>
            </div>
            <p class="rule-note">{t.usageRuleNotAnInput}</p>

            <button class="btn btn-primary btn-block" type="submit">{t.addSourceAndPoll}</button>
          </form>
        )
      }
    </div>
  </EditorChrome>
</ReaderLayout>

<script>
  // Progressive enhancement only: the select-all box mirrors itself into
  // the row checkboxes. Without it every row is still individually
  // selectable and every form still posts — nothing here is load-bearing.
  //
  // The control is rendered hidden and revealed here, so it exists only
  // where it works: a labelled checkbox beside a bulk delete that does
  // nothing when ticked would look armed and be inert.
  const all = document.getElementById('select-all');
  const allLabel = document.getElementById('select-all-label');
  if (all instanceof HTMLInputElement && allLabel !== null) {
    allLabel.hidden = false;
    all.addEventListener('change', () => {
      for (const box of document.querySelectorAll('input.row-select')) {
        if (box instanceof HTMLInputElement) {
          box.checked = all.checked;
        }
      }
    });
  }
</script>

