---
import { API_BASE_URL } from 'astro:env/server';
import AxisBar from '../../../components/AxisBar.astro';
import EmptyPlaceBand from '../../../components/EmptyPlaceBand.astro';
import Masthead from '../../../components/Masthead.astro';
import ProvenanceDisclosure from '../../../components/ProvenanceDisclosure.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import { createReaderApi, probeEmptyPlaces, type FrontItem } from '../../../lib/reader/api';
import {
  articlePath,
  frontPagePath,
  parseAxes,
  placeKicker,
  type Place,
} from '../../../lib/reader/axes';
import {
  formatItemDate,
  formatMastheadDate,
  formatRecency,
  safeSourceUrl,
  sourceHost,
} from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// The locale-scoped reader front page — mockup 1a: one edited page, place
// as kicker (issue #51, toward T025 #28). Both axes arrive in the URL
// (`/el/munich+greece`), are validated here, and scope the feed (FR-009);
// anything but el/de is a 404 (FR-015).
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);

const t = uiStrings(lang);
const api = createReaderApi(API_BASE_URL);

// An API hiccup must degrade into the calm 503 band below, never into an
// unhandled SSR exception: the page still renders its chrome and axes.
let items: readonly FrontItem[] = [];
let emptyPlaces: readonly Place[] = [];
let apiUnavailable = false;
try {
  items = (await api.front({ lang, places: slugs })).items;
  emptyPlaces = await probeEmptyPlaces(api, lang, places, items);
} catch {
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const lead = items.at(0);
const rest = items.slice(1);

const now = new Date();
const homeHref = frontPagePath(lang, slugs);

// Kicker: the endonym + scope label of the place that put the item on
// THIS page (the first of the item's places the reader follows), falling
// back to the item's own first place.
const kicker = (item: FrontItem): string => {
  const matched = item.places.find((candidate) => slugs.includes(candidate));
  return placeKicker(matched === undefined ? item.places : [matched], t.scopeLabels);
};

// Feed URLs are external input: only http(s) renders as a link (a
// javascript: URL must never become clickable); anything else shows the
// host as plain text.
const recordRows = (item: FrontItem): { term: string; value: string; href?: string }[] => {
  const href = safeSourceUrl(item.source_url);
  return [
    { term: t.source, value: sourceHost(item.source_url), ...(href === null ? {} : { href }) },
    { term: t.published, value: formatItemDate(lang, new Date(item.published_at)) },
    { term: t.attribution, value: item.attribution },
  ];
};

const title = `epiloYES — ${places.map((place) => place.endonym).join(' + ')}`;
---

<ReaderLayout lang={lang} title={title} description={t.tagline}>
  <Masthead homeHref={homeHref} dateText={formatMastheadDate(lang, now)}>
    <button class="btn btn-secondary sign-in" disabled title={t.signInPending}>{t.signIn}</button>
  </Masthead>

  <AxisBar lang={lang} places={places} />

  <main>
    {
      apiUnavailable && (
        <div class="unavailable">
          <h6>{t.unavailableTitle}</h6>
          <p>{t.unavailableBody}</p>
        </div>
      )
    }

    {
      lead !== undefined && (
        <article class="lead">
          {/* The mockup's lead-photograph slot, held as composition: the
              alpha is text-only (no image handling in the contract), so
              the reserved cell renders as a quiet typographic tile until
              publisher imagery is ever licensed. */}
          <figure class="lead-figure grayscale" aria-hidden="true">
            <span>{kicker(lead).split(' · ').at(0)}</span>
          </figure>
          <div class="lead-text">
            <div class="meta">
              <span class="kicker">{kicker(lead)}</span>
              <span class="meta-rule" aria-hidden="true" />
              <span class="when">{formatRecency(lang, new Date(lead.published_at), now)}</span>
            </div>
            <h1><a class="headline-link" href={articlePath(lang, slugs, lead.id)}>{lead.headline}</a></h1>
            <p class="lead-extract">{lead.extract}</p>
            <div class="lead-record">
              <p class="attribution">
                {lead.attribution}
                {safeSourceUrl(lead.source_url) !== null ? (
                  <a class="source-link" href={safeSourceUrl(lead.source_url)} rel="external noopener">
                    {sourceHost(lead.source_url)} ↗
                  </a>
                ) : (
                  <span class="source-host">{sourceHost(lead.source_url)}</span>
                )}
              </p>
              {/* The lead's attribution reads as prose directly above, so
                  its disclosure repeats only the source and published
                  rows — the grid cells, whose attribution is not visible,
                  carry all three. */}
              <ProvenanceDisclosure
                label={t.provenance}
                rows={recordRows(lead).filter((row) => row.term !== t.attribution)}
              />
            </div>
          </div>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((item) => (
            <article class="cell">
              <span class="kicker">{kicker(item)}</span>
              <h3><a class="headline-link" href={articlePath(lang, slugs, item.id)}>{item.headline}</a></h3>
              <p class="cell-extract">{item.extract}</p>
              <div class="cell-record">
                {safeSourceUrl(item.source_url) !== null ? (
                  <a class="source-link" href={safeSourceUrl(item.source_url)} rel="external noopener">
                    {sourceHost(item.source_url)} ↗
                  </a>
                ) : (
                  <span class="source-host">{sourceHost(item.source_url)}</span>
                )}
                <ProvenanceDisclosure label={t.provenance} rows={recordRows(item)} />
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      emptyPlaces.map((place) => (
        <EmptyPlaceBand title={t.emptyPlaceTitle} body={t.emptyPlaceBody(place.endonym)} />
      ))
    }
  </main>

  <footer class="reassurance">{t.reassurance}</footer>
</ReaderLayout>

<style>
  main {
    flex: 1;
  }

  /* Headlines are doorways to the article page; they read as ink until
     touched, per the mockup. */
  .headline-link {
    color: inherit;
    text-decoration: none;
  }
  .headline-link:hover {
    color: var(--color-accent);
  }

  /* — the lead: the 1a two-cell composition, photograph slot left,
     text right; the slot holds its place typographically until imagery
     is ever licensed (issue #51) — */
  .lead {
    display: grid;
    grid-template-columns: 52fr 48fr;
    border-bottom: 2px solid var(--color-divider);
  }
  .lead-figure {
    margin: 0;
    padding: calc(var(--space-6) + var(--space-1));
    border-right: 1px solid var(--color-divider);
    display: flex;
  }
  .lead-figure span {
    flex: 1;
    min-height: 330px;
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 35%, transparent);
  }
  .lead-text {
    padding: calc(var(--space-6) + var(--space-1));
    display: flex;
    flex-direction: column;
  }
  .lead-record {
    margin-top: auto;
  }
  @media (max-width: 980px) {
    .lead {
      grid-template-columns: 1fr;
    }
    .lead-figure {
      display: none;
    }
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .kicker {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .meta-rule {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }
  .when {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .lead h1 {
    font-size: clamp(28px, 3vw, 38px);
    margin: 0 0 var(--space-3);
    max-width: 28ch;
    text-wrap: pretty;
  }
  .lead-extract {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 var(--space-4);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .lead-record {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-divider);
  }
  .sign-in {
    font-size: 12.5px;
    padding: 6px var(--space-3);
  }
  .attribution {
    font-size: 12.5px;
    margin: 0 0 var(--space-3);
    max-width: 72ch;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }
  .source-link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .attribution .source-link {
    margin-left: var(--space-2);
  }
  .source-host {
    font-weight: 600;
    font-size: 12.5px;
  }

  /* — the calm degraded state: the API is away, the page is not — */
  .unavailable {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    border-bottom: 2px solid var(--color-divider);
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
  }
  .unavailable h6 {
    margin: 0 0 var(--space-1);
    color: var(--color-accent);
  }
  .unavailable p {
    margin: 0;
    font-size: 13.5px;
    max-width: 70ch;
  }

  /* — the item grid: equal cells, the rules visible — */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 2px solid var(--color-divider);
  }
  .cell {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) calc(var(--space-6) + 2px);
    border-right: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  }
  .cell:nth-child(3n) {
    border-right: 0;
  }
  .cell .kicker {
    margin-bottom: var(--space-2);
  }
  .cell h3 {
    font-size: 22px;
    margin: 0 0 var(--space-2);
    text-wrap: pretty;
  }
  .cell-extract {
    font-size: 14px;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }
  .cell-record {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .cell-record .source-link {
    font-size: 12.5px;
  }

  .reassurance {
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
    border-top: 2px solid var(--color-divider);
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell:nth-child(3n) {
      border-right: 1px solid var(--color-divider);
    }
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (max-width: 660px) {
    .axes {
      grid-template-columns: 1fr;
    }
    .axis-lang {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .cell,
    .cell:nth-child(3n),
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
</style>
