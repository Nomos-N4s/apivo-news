---
import { API_BASE_URL } from 'astro:env/server';
import EmptyPlaceBand from '../../../components/EmptyPlaceBand.astro';
import Masthead from '../../../components/Masthead.astro';
import ProvenanceDisclosure from '../../../components/ProvenanceDisclosure.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import { createReaderApi, probeEmptyPlaces, type FrontItem } from '../../../lib/reader/api';
import { findPlace, frontPagePath, parseAxes, type Place } from '../../../lib/reader/axes';
import {
  formatItemDate,
  formatMastheadDate,
  formatRecency,
  safeSourceUrl,
  sourceHost,
} from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// The locale-scoped reader front page — mockup 1a: one edited page, place
// as kicker (issue #51, toward T025 #28). Both axes arrive in the URL
// (`/el/munich+greece`), are validated here, and scope the feed (FR-009);
// anything but el/de is a 404 (FR-015).
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);

const t = uiStrings(lang);
const api = createReaderApi(API_BASE_URL);

// An API hiccup must degrade into the calm 503 band below, never into an
// unhandled SSR exception: the page still renders its chrome and axes.
let items: readonly FrontItem[] = [];
let emptyPlaces: readonly Place[] = [];
let apiUnavailable = false;
try {
  items = (await api.front({ lang, places: slugs })).items;
  emptyPlaces = await probeEmptyPlaces(api, lang, places, items);
} catch {
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const lead = items.at(0);
const rest = items.slice(1);

const now = new Date();
const homeHref = frontPagePath(lang, slugs);

// Kicker: the endonym + scope label of the place that put the item on
// THIS page (the first of the item's places the reader follows), falling
// back to the item's own first place. Slugs beyond the catalog render as
// themselves — the API may know places before this catalog does.
const kicker = (item: FrontItem): string => {
  const slug = item.places.find((candidate) => slugs.includes(candidate)) ?? item.places.at(0);
  if (slug === undefined) {
    return '';
  }
  const place = findPlace(slug);
  if (place === undefined) {
    return slug;
  }
  return `${place.endonym} · ${t.scopeLabels[place.scope]}`;
};

// Feed URLs are external input: only http(s) renders as a link (a
// javascript: URL must never become clickable); anything else shows the
// host as plain text.
const recordRows = (item: FrontItem): { term: string; value: string; href?: string }[] => {
  const href = safeSourceUrl(item.source_url);
  return [
    { term: t.source, value: sourceHost(item.source_url), ...(href === null ? {} : { href }) },
    { term: t.published, value: formatItemDate(lang, new Date(item.published_at)) },
    { term: t.attribution, value: item.attribution },
  ];
};

const title = `epiloYES — ${places.map((place) => place.endonym).join(' + ')}`;
---

<ReaderLayout lang={lang} title={title} description={t.tagline}>
  <Masthead homeHref={homeHref} dateText={formatMastheadDate(lang, now)} />

  <section class="axes" aria-label={`${t.readingLanguage} · ${t.places}`}>
    <div class="axis axis-lang">
      <h6>{t.readingLanguage}</h6>
      <div class="seg" role="group">
        <a class="seg-opt" aria-current={lang === 'el' ? 'true' : undefined} href={lang === 'el' ? undefined : frontPagePath('el', slugs)}>Ελληνικά</a>
        <a class="seg-opt" aria-current={lang === 'de' ? 'true' : undefined} href={lang === 'de' ? undefined : frontPagePath('de', slugs)}>Deutsch</a>
      </div>
    </div>
    <div class="axis axis-places">
      <h6>{t.places}</h6>
      {places.map((place) => <span class="tag tag-accent">{place.endonym}</span>)}
    </div>
  </section>

  <main>
    {
      apiUnavailable && (
        <div class="unavailable">
          <h6>{t.unavailableTitle}</h6>
          <p>{t.unavailableBody}</p>
        </div>
      )
    }

    {
      lead !== undefined && (
        <article class="lead">
          <div class="meta">
            <span class="kicker">{kicker(lead)}</span>
            <span class="meta-rule" aria-hidden="true" />
            <span class="when">{formatRecency(lang, new Date(lead.published_at), now)}</span>
          </div>
          <h1>{lead.headline}</h1>
          <p class="lead-extract">{lead.extract}</p>
          <div class="lead-record">
            <p class="attribution">
              {lead.attribution}
              {safeSourceUrl(lead.source_url) !== null ? (
                <a class="source-link" href={safeSourceUrl(lead.source_url)} rel="external noopener">
                  {sourceHost(lead.source_url)} ↗
                </a>
              ) : (
                <span class="source-host">{sourceHost(lead.source_url)}</span>
              )}
            </p>
            <ProvenanceDisclosure
              label={t.provenance}
              rows={recordRows(lead).slice(0, 2)}
            />
          </div>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((item) => (
            <article class="cell">
              <span class="kicker">{kicker(item)}</span>
              <h3>{item.headline}</h3>
              <p class="cell-extract">{item.extract}</p>
              <div class="cell-record">
                {safeSourceUrl(item.source_url) !== null ? (
                  <a class="source-link" href={safeSourceUrl(item.source_url)} rel="external noopener">
                    {sourceHost(item.source_url)} ↗
                  </a>
                ) : (
                  <span class="source-host">{sourceHost(item.source_url)}</span>
                )}
                <ProvenanceDisclosure label={t.provenance} rows={recordRows(item)} />
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      emptyPlaces.map((place) => (
        <EmptyPlaceBand title={t.emptyPlaceTitle} body={t.emptyPlaceBody(place.endonym)} />
      ))
    }
  </main>

  <footer class="reassurance">{t.reassurance}</footer>
</ReaderLayout>

<style>
  /* — the axes row: two cells, one per axis, the vertical rule between
     them doing the separating (the design argument made literal) — */
  .axes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 2px solid var(--color-divider);
  }
  .axis {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) calc(var(--space-6) + var(--space-1));
  }
  .axis-lang {
    border-right: 1px solid var(--color-divider);
  }
  .axis h6 {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    flex: none;
  }
  .seg-opt {
    color: var(--color-text);
    text-decoration: none;
  }
  .seg-opt[aria-current='true'] {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  a.seg-opt:not([aria-current='true']):hover {
    background: color-mix(in srgb, var(--color-text) 7%, transparent);
  }
  .axis-places .tag {
    font-size: 11.5px;
  }

  main {
    flex: 1;
  }

  /* — the lead: typographic (the alpha is text-only; the mockup's
     photograph slot is out of scope — issue #51) — */
  .lead {
    padding: calc(var(--space-6) + var(--space-1));
    border-bottom: 2px solid var(--color-divider);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .kicker {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .meta-rule {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }
  .when {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .lead h1 {
    font-size: clamp(28px, 4.5vw, 38px);
    margin: 0 0 var(--space-3);
    max-width: 28ch;
    text-wrap: pretty;
  }
  .lead-extract {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 var(--space-4);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .lead-record {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-divider);
  }
  .attribution {
    font-size: 12.5px;
    margin: 0 0 var(--space-3);
    max-width: 72ch;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }
  .source-link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .attribution .source-link {
    margin-left: var(--space-2);
  }
  .source-host {
    font-weight: 600;
    font-size: 12.5px;
  }

  /* — the calm degraded state: the API is away, the page is not — */
  .unavailable {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    border-bottom: 2px solid var(--color-divider);
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
  }
  .unavailable h6 {
    margin: 0 0 var(--space-1);
    color: var(--color-accent);
  }
  .unavailable p {
    margin: 0;
    font-size: 13.5px;
    max-width: 70ch;
  }

  /* — the item grid: equal cells, the rules visible — */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 2px solid var(--color-divider);
  }
  .cell {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) calc(var(--space-6) + 2px);
    border-right: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  }
  .cell:nth-child(3n) {
    border-right: 0;
  }
  .cell .kicker {
    margin-bottom: var(--space-2);
  }
  .cell h3 {
    font-size: 22px;
    margin: 0 0 var(--space-2);
    text-wrap: pretty;
  }
  .cell-extract {
    font-size: 14px;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }
  .cell-record {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .cell-record .source-link {
    font-size: 12.5px;
  }

  .reassurance {
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
    border-top: 2px solid var(--color-divider);
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell:nth-child(3n) {
      border-right: 1px solid var(--color-divider);
    }
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (max-width: 660px) {
    .axes {
      grid-template-columns: 1fr;
    }
    .axis-lang {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .cell,
    .cell:nth-child(3n),
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
</style>
