---
import { API_BASE_URL } from 'astro:env/server';
import AxisBar from '../../../components/AxisBar.astro';
import EmptyPlaceBand from '../../../components/EmptyPlaceBand.astro';
import Masthead from '../../../components/Masthead.astro';
import ProvenanceDisclosure from '../../../components/ProvenanceDisclosure.astro';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import { createReaderApi, type FrontItem } from '../../../lib/reader/api';
import { articlePath, frontPagePath, parseAxes, placeKicker } from '../../../lib/reader/axes';
import {
  formatItemDate,
  formatMastheadDate,
  formatRecency,
  sourceHost,
} from '../../../lib/reader/format';
import { uiStrings } from '../../../lib/reader/strings';

// The locale-scoped reader front page — mockup 1a: one edited page, place
// as kicker (issue #51, toward T025 #28). Both axes arrive in the URL
// (`/el/munich+greece`), are validated here, and scope the feed (FR-009);
// anything but el/de is a 404 (FR-015).
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);

const t = uiStrings(lang);
const api = createReaderApi(API_BASE_URL);
const { items } = await api.front({ lang, places: slugs });

const lead = items.at(0);
const rest = items.slice(1);
const emptyPlaces = places.filter(
  (place) => !items.some((item) => item.places.includes(place.slug)),
);

const now = new Date();
const homeHref = frontPagePath(lang, slugs);

const kicker = (item: FrontItem): string => placeKicker(item.places, t.scopeLabels);

const recordRows = (item: FrontItem): { term: string; value: string; href?: string }[] => [
  { term: t.source, value: sourceHost(item.source_url), href: item.source_url },
  { term: t.published, value: formatItemDate(lang, new Date(item.published_at)) },
  { term: t.attribution, value: item.attribution },
];

const title = `epiloYES — ${places.map((place) => place.endonym).join(' + ')}`;
---

<ReaderLayout lang={lang} title={title} description={t.tagline}>
  <Masthead homeHref={homeHref} dateText={formatMastheadDate(lang, now)} />

  <AxisBar lang={lang} places={places} />

  <main>
    {
      lead !== undefined && (
        <article class="lead">
          <div class="meta">
            <span class="kicker">{kicker(lead)}</span>
            <span class="meta-rule" aria-hidden="true" />
            <span class="when">{formatRecency(lang, new Date(lead.published_at), now)}</span>
          </div>
          <h1><a class="headline-link" href={articlePath(lang, slugs, lead.id)}>{lead.headline}</a></h1>
          <p class="lead-extract">{lead.extract}</p>
          <div class="lead-record">
            <p class="attribution">
              {lead.attribution}
              <a class="source-link" href={lead.source_url} rel="external noopener">
                {sourceHost(lead.source_url)} ↗
              </a>
            </p>
            <ProvenanceDisclosure
              label={t.provenance}
              rows={[
                { term: t.source, value: sourceHost(lead.source_url), href: lead.source_url },
                {
                  term: t.published,
                  value: formatItemDate(lang, new Date(lead.published_at)),
                },
              ]}
            />
          </div>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((item) => (
            <article class="cell">
              <span class="kicker">{kicker(item)}</span>
              <h3><a class="headline-link" href={articlePath(lang, slugs, item.id)}>{item.headline}</a></h3>
              <p class="cell-extract">{item.extract}</p>
              <div class="cell-record">
                <a class="source-link" href={item.source_url} rel="external noopener">
                  {sourceHost(item.source_url)} ↗
                </a>
                <ProvenanceDisclosure label={t.provenance} rows={recordRows(item)} />
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      emptyPlaces.map((place) => (
        <EmptyPlaceBand title={t.emptyPlaceTitle} body={t.emptyPlaceBody(place.endonym)} />
      ))
    }
  </main>

  <footer class="reassurance">{t.reassurance}</footer>
</ReaderLayout>

<style>
  main {
    flex: 1;
  }

  /* Headlines are doorways to the article page; they read as ink until
     touched, per the mockup. */
  .headline-link {
    color: inherit;
    text-decoration: none;
  }
  .headline-link:hover {
    color: var(--color-accent);
  }

  /* — the lead: typographic (the alpha is text-only; the mockup's
     photograph slot is out of scope — issue #51) — */
  .lead {
    padding: calc(var(--space-6) + var(--space-1));
    border-bottom: 2px solid var(--color-divider);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .kicker {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .meta-rule {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }
  .when {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 50%, transparent);
  }
  .lead h1 {
    font-size: clamp(28px, 4.5vw, 38px);
    margin: 0 0 var(--space-3);
    max-width: 28ch;
    text-wrap: pretty;
  }
  .lead-extract {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 var(--space-4);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .lead-record {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-divider);
  }
  .attribution {
    font-size: 12.5px;
    margin: 0 0 var(--space-3);
    max-width: 72ch;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }
  .source-link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .attribution .source-link {
    margin-left: var(--space-2);
  }

  /* — the item grid: equal cells, the rules visible — */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 2px solid var(--color-divider);
  }
  .cell {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) calc(var(--space-6) + 2px);
    border-right: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
  }
  .cell:nth-child(3n) {
    border-right: 0;
  }
  .cell .kicker {
    margin-bottom: var(--space-2);
  }
  .cell h3 {
    font-size: 22px;
    margin: 0 0 var(--space-2);
    text-wrap: pretty;
  }
  .cell-extract {
    font-size: 14px;
    margin: 0 0 var(--space-4);
    text-wrap: pretty;
  }
  .cell-record {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .cell-record .source-link {
    font-size: 12.5px;
  }

  .reassurance {
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
    border-top: 2px solid var(--color-divider);
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell:nth-child(3n) {
      border-right: 1px solid var(--color-divider);
    }
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (max-width: 660px) {
    .axes {
      grid-template-columns: 1fr;
    }
    .axis-lang {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .cell,
    .cell:nth-child(3n),
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
</style>
