---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import CashbackNav from '../../../../components/CashbackNav.astro';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import Masthead from '../../../../components/Masthead.astro';
import RateBadge from '../../../../components/RateBadge.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import { merchantPath } from '../../../../lib/cashback/paths';
import type { CatalogueItem } from '../../../../lib/cashback/types';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { cashbackStrings, languageName } from '../../../../i18n/cashback';

// The merchant catalogue — mockup 4b, bound to what GET /catalogue answers
// (T106 #253).
//
// Three things the mockup draws that are not built, each for a reason
// recorded elsewhere rather than decided here:
//
//   - **The category chips.** `category` is documented as a query parameter
//     and has nothing behind it: no table records one, and inventing a
//     taxonomy would settle four product questions in a member-facing URL.
//     Issue #414. Search over the name is what exists, so search is what is
//     offered.
//   - **The "timed for you" band.** It explains offers by a saved route and
//     reading habits. The route product does not exist here (#447) and
//     nothing records habits, so the band would be three cards of fiction
//     above the real shelf.
//   - **The in-store cards.** Card-linked offers are out of scope (#445).
//
// What the mockup gets exactly right is the sentence under the filters, and
// it is kept: placement is not for sale. Ordering follows the member's
// language and places, which is the API's own ordering.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

// The search term travels in the URL: a searched catalogue is a thing a
// member links to, and the API takes `q` as a parameter for the same reason.
const query = Astro.url.searchParams.get('q')?.trim() ?? '';

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let items: readonly CatalogueItem[] = [];
let apiUnavailable = false;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });
  items = (await api.catalogue({ lang, places: slugs, q: query === '' ? undefined : query })).items;
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);
const placeNames = places.map((place) => place.endonym).join(' · ');
---

<ReaderLayout lang={lang} title={t.catalogue} description={t.cashback} homeHref={homeHref}>
  <Masthead homeHref={homeHref} />
  <CashbackNav lang={lang} slugs={slugs} current="catalogue" />

  <main class="catalogue">
    {fixtures && <FixtureNotice title={t.cashback} body={t.fixtureNotice} />}

    <form class="filters" method="get" role="search">
      <div class="field">
        <label for="q">{t.searchLabel}</label>
        <input
          class="input"
          id="q"
          name="q"
          type="search"
          value={query}
          placeholder={t.searchPlaceholder}
        />
      </div>
      <div class="field place">
        <span class="label">{t.placeLabel}</span>
        <p class="places">{placeNames}</p>
      </div>
      <button class="btn btn-secondary" type="submit">{t.searchLabel}</button>
    </form>

    <p class="ordering">{t.placementNotForSale}</p>

    {apiUnavailable && <p class="empty" role="alert">{t.emptyQueue}</p>}

    {!apiUnavailable && items.length === 0 && <p class="empty">{t.noMerchants}</p>}

    <ul class="shelf">
      {
        items.map((item) => (
          <li class="shop">
            <div class="head">
              <h2>
                <a href={merchantPath(lang, slugs, item.slug)}>{item.name}</a>
              </h2>
              {item.rates.length > 0 && item.rates[0] !== undefined && (
                <RateBadge lang={lang} rate={item.rates[0]} />
              )}
            </div>
            {item.name_is_fallback && (
              <p class="fallback">{t.shownInLanguage(languageName(lang, item.name_language))}</p>
            )}
            {item.summary !== null && <p class="summary">{item.summary}</p>}
            {item.rates.length === 0 && <p class="no-rate">{t.noRatesToday}</p>}
            <a class="btn btn-secondary" href={merchantPath(lang, slugs, item.slug)}>
              {t.seeTerms}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</ReaderLayout>

<style>
  .catalogue {
    flex: 1;
    padding: var(--space-6) calc(var(--space-6) + var(--space-1)) 28px;
  }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
    align-items: end;
    gap: 20px;
    border: 2px solid var(--color-divider);
    padding: 20px;
  }
  .place .label {
    display: block;
    font: 600 11px/1.3 var(--font-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }
  .places {
    margin: 0;
    font-size: 15px;
  }
  .ordering {
    margin: var(--space-4) 0 var(--space-6);
    font-size: 12px;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    border-top: 1px solid var(--color-divider);
    border-left: 1px solid var(--color-divider);
  }
  .shop {
    padding: 20px;
    border-right: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
  }
  .shop h2 {
    margin: 0;
    font-size: 19px;
  }
  .shop h2 a {
    color: var(--color-text);
    text-decoration: none;
  }
  .shop h2 a:hover {
    color: var(--color-accent-700);
  }
  .fallback,
  .summary,
  .no-rate {
    margin: 0;
    font-size: 13px;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .fallback {
    font-style: italic;
  }
  .empty {
    padding: var(--space-6) 0;
    font-size: 14px;
    color: var(--ink-muted);
  }
  @media (max-width: 700px) {
    .catalogue {
      padding: 20px var(--space-4) var(--space-6);
    }
    .filters {
      grid-template-columns: 1fr;
      align-items: stretch;
    }
  }
</style>
