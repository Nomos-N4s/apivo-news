---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import CashbackNav from '../../../../components/CashbackNav.astro';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import Masthead from '../../../../components/Masthead.astro';
import RateBadge from '../../../../components/RateBadge.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import { cataloguePath, merchantPath } from '../../../../lib/cashback/paths';
import type { MerchantDetail } from '../../../../lib/cashback/types';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { formatItemDate } from '../../../../lib/reader/format';
import { cashbackStrings, languageName } from '../../../../i18n/cashback';

// One retailer — mockup 4c, whose own caption is the design argument and is
// right: the terms are the interface (T107 #254).
//
// So the page is the bands, and each band carries what it carries: the
// share the member earns, the conditions that qualify a basket, the
// exclusions that void one, and the date the band lapses. Nothing is
// summarised into a headline rate, because the thing that decides whether a
// purchase pays is the small print and hiding it behind "up to 7%" is how a
// cashback product earns its reputation.
//
// `typical_confirmation_days` renders as "we do not know" rather than as a
// number. The contract emits null and says why: nothing in the schema
// records it, and a plausible constant reads to a member as a promise about
// when they will be paid.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
const slug = Astro.params['slug'];
if (axes === null || slug === undefined || slug === '') {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let merchant: MerchantDetail | null = null;
let apiUnavailable = false;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });
  merchant = await api.merchant(slug, lang);
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

// An unknown retailer and an inactive one are one answer by contract —
// which retailers we have stopped publishing is not a page request's
// business — so the page is a 404 either way.
if (!apiUnavailable && merchant === null) {
  return Astro.rewrite('/404');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);
const clickoutFailed = Astro.url.searchParams.has('clickout');
const backHere = merchantPath(lang, slugs, slug);
---

<ReaderLayout
  lang={lang}
  title={merchant?.name ?? t.catalogue}
  description={t.cashback}
  homeHref={homeHref}
>
  <Masthead homeHref={homeHref} />
  <CashbackNav lang={lang} slugs={slugs} current="catalogue" />

  <main class="merchant">
    {fixtures && <FixtureNotice title={t.cashback} body={t.fixtureNotice} />}
    {apiUnavailable && <p class="band" role="alert">{t.emptyQueue}</p>}
    {clickoutFailed && <p class="band" role="alert">{t.clickoutFailed}</p>}

    {
      merchant !== null && (
        <>
          <p class="crumb"><a href={cataloguePath(lang, slugs)}>{t.catalogue}</a></p>

          <header class="head">
            <h1>{merchant.name}</h1>
            {merchant.name_is_fallback && (
              <p class="fallback">
                {t.shownInLanguage(languageName(lang, merchant.name_language))}
              </p>
            )}
            {merchant.summary !== null && <p class="summary">{merchant.summary}</p>}
          </header>

          <section class="rates" aria-labelledby="rates-heading">
            <h2 id="rates-heading">{t.rates}</h2>
            {merchant.rates.length === 0 && <p class="none">{t.noRatesToday}</p>}
            {
              merchant.rates.map((rate) => (
                <article class="band-row">
                  <div class="band-head">
                    <RateBadge lang={lang} rate={rate} />
                    {rate.valid_to !== null && (
                      <span class="tag tag-outline">
                        {t.validUntil} {formatItemDate(lang, new Date(rate.valid_to))}
                      </span>
                    )}
                  </div>
                  <dl>
                    <dt>{t.conditions}</dt>
                    <dd>{rate.conditions ?? '—'}</dd>
                    <dt>{t.exclusions}</dt>
                    <dd>{rate.exclusions ?? '—'}</dd>
                  </dl>
                  <form method="post" action="/api/cashback/clickout">
                    <input type="hidden" name="offer_id" value={rate.offer_id} />
                    <input type="hidden" name="back" value={backHere} />
                    <button class="btn btn-primary" type="submit">{t.shopAndEarn}</button>
                  </form>
                </article>
              ))
            }
          </section>

          <p class="note">{t.confirmationTimeUnknown}</p>
          <p class="note">{t.rateAtClick}</p>
        </>
      )
    }
  </main>
</ReaderLayout>

<style>
  .merchant {
    flex: 1;
    padding: var(--space-6) calc(var(--space-6) + var(--space-1)) 28px;
    max-width: 78ch;
  }
  .band {
    border: 2px solid var(--color-accent-700);
    background: var(--color-surface);
    padding: 20px;
    margin: 0 0 var(--space-6);
    font-size: 14px;
    text-wrap: pretty;
  }
  .crumb {
    margin: 0 0 var(--space-4);
    font-size: 13px;
  }
  .head h1 {
    margin: 0 0 var(--space-3);
  }
  .fallback {
    margin: 0 0 var(--space-3);
    font-size: 13px;
    font-style: italic;
    color: var(--ink-muted);
  }
  .summary {
    margin: 0 0 20px;
    font-size: 15px;
    text-wrap: pretty;
  }
  .rates h2 {
    font-size: 20px;
    margin: var(--space-6) 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-divider);
  }
  .band-row {
    border-bottom: 1px solid var(--color-divider);
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .band-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .band-row dl {
    display: grid;
    grid-template-columns: minmax(110px, auto) 1fr;
    gap: var(--space-2) 20px;
    margin: 0;
    font-size: 13.5px;
  }
  .band-row dt {
    color: var(--ink-muted);
  }
  .band-row dd {
    margin: 0;
    text-wrap: pretty;
  }
  .none,
  .note {
    margin: var(--space-4) 0 0;
    font-size: 12.5px;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  @media (max-width: 560px) {
    .merchant {
      padding: 20px var(--space-4) var(--space-6);
    }
    .band-row dl {
      grid-template-columns: 1fr;
      gap: 2px 20px;
    }
    .band-row dt {
      margin-top: var(--space-2);
    }
  }
</style>
