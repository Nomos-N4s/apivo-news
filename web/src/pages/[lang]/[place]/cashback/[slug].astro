---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import Masthead from '../../../../components/Masthead.astro';
import RateBadge from '../../../../components/RateBadge.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import { cataloguePath, merchantPath } from '../../../../lib/cashback/paths';
import type { MerchantDetail } from '../../../../lib/cashback/types';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { formatItemDate } from '../../../../lib/reader/format';
import { cashbackStrings, languageName } from '../../../../i18n/cashback';

// One retailer — mockup 4c, whose own caption is the design argument and is
// right: the terms are the interface (T107 #254).
//
// The composition is the mockup's, block by block: the top bar in its
// merchant variant (wordmark, rule, the way back to the catalogue), then a
// two-column page — the retailer on the left, the tracked click on the
// right. The left column is the header (photo slot beside kicker, name,
// summary, tags), the dated rate table, and the two explainers; the rail is
// the click-out, the member's history at this retailer, and where the
// money comes from.
//
// What the mockup draws and the contract does not carry is left out rather
// than invented: "partner since / ships to" on the bar (no data), the
// merchant photograph (no image on the payload — a neutral slot keeps the
// composition), the per-category rows (no categories, #414 — the table is
// the rate BANDS the API publishes, each with its conditions, exclusions
// and the date it lapses), the history figures (no per-merchant history
// endpoint — the block states that plainly), and the "report a missing
// order" link (no claims flow).
//
// `typical_confirmation_days` is null by contract and nothing here turns it
// into a number: a plausible constant reads to a member as a promise about
// when they will be paid.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
const slug = Astro.params['slug'];
if (axes === null || slug === undefined || slug === '') {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let merchant: MerchantDetail | null = null;
let apiUnavailable = false;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });
  merchant = await api.merchant(slug, lang);
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

// An unknown retailer and an inactive one are one answer by contract —
// which retailers we have stopped publishing is not a page request's
// business — so the page is a 404 either way.
if (!apiUnavailable && merchant === null) {
  return Astro.rewrite('/404');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);
const clickoutFailed = Astro.url.searchParams.has('clickout');
const backHere = merchantPath(lang, slugs, slug);

// The kicker is the two facts true of every partner on this shelf: online,
// reached by a tracked link (#445 — nothing is card-linked or in-store).
const kicker = `${t.online} · ${t.trackedLink}`;
// The click-out is one form, on the first band: a click is tracked against
// an offer, and the band a member reads first is the one the button opens.
const firstRate = merchant?.rates[0];
const trackingSteps = [t.tracking1, t.tracking2, t.tracking3] as const;
const voids = [t.void1, t.void2, t.void3] as const;
---

<ReaderLayout
  lang={lang}
  title={merchant?.name ?? t.catalogue}
  description={t.cashback}
  homeHref={homeHref}
>
  <div class="bar">
    <Masthead homeHref={homeHref}>
      <span class="rule" aria-hidden="true"></span>
      <a class="back" href={cataloguePath(lang, slugs)}>← {t.catalogue}</a>
    </Masthead>
  </div>

  <main class="merchant">
    {fixtures && <FixtureNotice title={t.cashback} body={t.fixtureNotice} />}
    {apiUnavailable && <p class="band" role="alert">{t.emptyQueue}</p>}
    {clickoutFailed && <p class="band" role="alert">{t.clickoutFailed}</p>}

    {
      merchant !== null && (
        <div class="page">
          <div class="body">
            <header class="head">
              <div class="photo-cell">
                <div class="photo grayscale" role="img" aria-label={merchant.name} />
              </div>
              <div class="head-text">
                <span class="card-kicker">{kicker}</span>
                <h1 class="name">{merchant.name}</h1>
                {merchant.summary !== null && <p class="summary">{merchant.summary}</p>}
                <div class="tags">
                  <span class="tag tag-neutral">{languageName(lang, merchant.name_language)}</span>
                  <span class="tag tag-neutral">{t.trackedLink}</span>
                </div>
              </div>
            </header>

            <section class="rates" aria-labelledby="rates-heading">
              <h6 id="rates-heading" class="accent">{t.ratesDated}</h6>
              {merchant.rates.length === 0 && <p class="none">{t.noRatesToday}</p>}
              {
                merchant.rates.length > 0 && (
                  <div class="scroll">
                    <table class="table">
                      <thead>
                        <tr>
                          <th scope="col">{t.rateColumn}</th>
                          <th scope="col">{t.validUntil}</th>
                          <th scope="col">{t.conditions}</th>
                          <th scope="col">{t.exclusions}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {merchant.rates.map((rate) => (
                          <tr>
                            <td class="rate-cell">
                              <RateBadge lang={lang} rate={rate} />
                            </td>
                            <td class="valid">
                              {rate.valid_to === null
                                ? t.none
                                : formatItemDate(lang, new Date(rate.valid_to))}
                            </td>
                            <td class="small">{rate.conditions ?? t.none}</td>
                            <td class="small">{rate.exclusions ?? t.none}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }
            </section>

            <div class="explainers">
              <section class="explainer tracking" aria-labelledby="tracking-heading">
                <h6 id="tracking-heading">{t.howTrackingWorks}</h6>
                <ol class="rows">
                  {trackingSteps.map((step, index) => (
                    <li class="row">
                      <span class="num" aria-hidden="true">{index + 1}</span>
                      <span class="row-text">{step}</span>
                    </li>
                  ))}
                </ol>
              </section>
              <section class="explainer voids" aria-labelledby="voids-heading">
                <h6 id="voids-heading">{t.whatVoids}</h6>
                <ul class="rows">
                  {voids.map((item) => (
                    <li class="row">
                      <span class="row-text">{item}</span>
                    </li>
                  ))}
                </ul>
                <p class="stated">{t.statedBefore}</p>
              </section>
            </div>
          </div>

          <aside class="rail" aria-label={t.shopAndEarn}>
            <div class="clickout">
              {
                firstRate !== undefined ? (
                  <form method="post" action="/api/cashback/clickout">
                    <input type="hidden" name="offer_id" value={firstRate.offer_id} />
                    <input type="hidden" name="back" value={backHere} />
                    <button class="btn btn-primary btn-block shop" type="submit">
                      {t.shopAtTracking(merchant.name)}
                    </button>
                    <div class="opens">{t.opensTracked}</div>
                  </form>
                ) : (
                  <p class="no-rates">{t.noRatesToday}</p>
                )
              }
            </div>

            <section class="history" aria-labelledby="history-heading">
              <h6 id="history-heading">{t.yourHistoryHere}</h6>
              <div class="history-list">
                <div class="history-row">
                  <span>{t.noHistoryHere}</span>
                </div>
              </div>
            </section>

            <section class="money" aria-labelledby="money-heading">
              <h6 id="money-heading" class="accent">{t.whereMoney}</h6>
              <p>{t.whereMoneyP(merchant.name)}</p>
            </section>
          </aside>
        </div>
      )
    }
  </main>
</ReaderLayout>

<style>
  /* — the top bar, in its merchant variant — */
  .bar :global(.brand) {
    margin-right: 0;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .bar :global(.masthead) {
    gap: 14px;
    padding: 14px 26px;
    border-bottom-width: 2px;
  }
  .rule {
    width: 1px;
    height: 16px;
    background: var(--color-divider);
  }
  .back {
    font-size: 13px;
    text-decoration: none;
    color: var(--color-text);
  }

  .merchant {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .band {
    border: 2px solid var(--color-accent-700);
    background: var(--color-surface);
    padding: 20px;
    margin: 0 0 20px;
    font-size: 14px;
    text-wrap: pretty;
  }

  /* — the two columns — */
  .page {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 420px;
    align-items: stretch;
  }
  .body {
    border-right: 1px solid var(--color-divider);
    min-width: 0;
  }

  /* — header: photo slot beside the name — */
  .head {
    display: grid;
    grid-template-columns: 300px 1fr;
    border-bottom: 1px solid var(--color-divider);
  }
  .photo-cell {
    padding: 24px 0 24px 26px;
  }
  .photo {
    width: 100%;
    height: 190px;
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
  }
  .head-text {
    padding: 24px 26px;
    min-width: 0;
  }
  .head-text .card-kicker {
    font-size: 10.5px;
  }
  .name {
    font-size: 32px;
    margin: 10px 0 10px;
  }
  .summary {
    font-size: 14px;
    margin: 0 0 14px;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tags .tag {
    font-size: 10.5px;
  }

  /* — the dated rate table — */
  .rates {
    padding: 22px 26px;
    border-bottom: 1px solid var(--color-divider);
  }
  h6 {
    margin: 0 0 12px;
  }
  h6.accent {
    color: var(--color-accent);
  }
  .scroll {
    overflow-x: auto;
  }
  .scroll th {
    white-space: nowrap;
  }
  .rate-cell {
    font-weight: 600;
    white-space: nowrap;
  }
  .valid {
    white-space: nowrap;
  }
  .small {
    font-size: 12px;
  }
  .none {
    margin: 0;
    font-size: 12.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    text-wrap: pretty;
  }

  /* — the two explainers — */
  .explainers {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .explainer {
    padding: 22px 26px;
    min-width: 0;
  }
  .tracking {
    border-right: 1px solid var(--color-divider);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-divider);
  }
  .row {
    padding: 12px 0;
    border-bottom: 1px solid var(--color-divider);
    display: flex;
    gap: 12px;
    font-size: 13px;
  }
  .num {
    font: 600 12px var(--font-heading);
    color: var(--color-accent);
    width: 16px;
    flex: none;
  }
  .row-text {
    font-size: 13px;
  }
  .stated {
    margin: 12px 0 0;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    text-wrap: pretty;
  }

  /* — the rail — */
  .rail {
    padding: 22px 24px;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  .shop {
    font-size: 15px;
    padding: 14px 16px;
    margin-top: 0;
  }
  .no-rates {
    margin: 0;
    font-size: 14px;
    text-wrap: pretty;
  }
  .opens {
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    margin-top: 8px;
  }
  .history-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-divider);
    background: var(--color-bg);
    font-size: 13px;
  }
  .history-row {
    padding: 11px 14px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .history-row + .history-row {
    border-top: 1px solid var(--color-divider);
  }
  .money {
    border-top: 2px solid var(--color-divider);
    padding-top: 16px;
  }
  .money h6 {
    margin: 0 0 8px;
  }
  .money p {
    margin: 0;
    font-size: 12px;
    text-wrap: pretty;
  }

  /* — phone: one column, the rail below — */
  @media (max-width: 660px) {
    .page {
      grid-template-columns: 1fr;
    }
    .body {
      border-right: 0;
    }
    .head {
      grid-template-columns: 1fr;
    }
    .photo-cell {
      padding: 20px 20px 0;
    }
    .head-text {
      padding: 20px;
    }
    .name {
      font-size: 28px;
    }
    .rates,
    .explainer {
      padding: 20px;
    }
    .explainers {
      grid-template-columns: 1fr;
    }
    .tracking {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .rail {
      border-top: 2px solid var(--color-divider);
      padding: 20px;
    }
  }
</style>
