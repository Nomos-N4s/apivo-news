---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import CashbackBar from '../../../../components/CashbackBar.astro';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackApiError,
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import {
  currencyDigits,
  decimalString,
  formatMoney,
  isMoney,
  parseAmountToMinor,
} from '../../../../lib/cashback/money';
import { walletPath, withdrawPath } from '../../../../lib/cashback/paths';
import type {
  PayoutDestination,
  WalletTotals,
  Withdrawal,
  WithdrawalRequest,
} from '../../../../lib/cashback/types';
import { isSameOrigin } from '../../../../lib/csrf';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { formatItemDate } from '../../../../lib/reader/format';
import { cashbackStrings } from '../../../../i18n/cashback';

// Withdrawal — mockup 4d, composed as the mockup draws it and bound to
// POST /withdrawals (T096 #243).
//
// The mockup draws three phone steps (amount → review → receipt) and, on
// the desktop, the same flow as one dialog over the dimmed wallet. That
// composition is kept. What the mockup SAYS inside it is not, and the
// differences are facts about the money rather than design preferences:
//
//   - **Every withdrawal waits for a named human.** C-4 forbids a payout
//     without one, so the API answers `awaiting_approval` whatever the
//     amount. The receipt says "recorded · awaiting a named approval", not
//     "on its way · arrived in 4 seconds". Issue #443.
//   - **There is no speed and no fee.** The contract has no field for
//     either, and payout rails are founder question Q5, undecided. The
//     "When" column and its SEPA Instant card are not drawn. Issue #442.
//   - **The reserved amount is not the requested amount.** Reservation is
//     in whole entries, oldest first, so asking for 15.00 against entries
//     of 10.00 and 20.00 reserves 30.00. The rule is stated in the review
//     before the member submits. Issue #444.
//   - **"Keep it in the wallet" is absent.** In-app spending and
//     member-to-member transfers are excluded by the founder decision of
//     2026-08-24. Issue #446.
//   - **Only one quick-pick.** "All <confirmed>" is the one amount the
//     page can vouch for; €50 and €100 are guesses about a balance.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let totals: WalletTotals | null = null;
let destinations: readonly PayoutDestination[] = [];
let history: readonly Withdrawal[] = [];
let apiUnavailable = false;

/** What the last submission produced, if there was one. */
let recorded: WithdrawalRequest | null = null;
let refusal: string | null = null;

// The step and the figures travel in the URL rather than in client state:
// the review is a page a member can go back to, and on a phone it is a
// screen of its own. The POST carries the same fields as a form body.
const query = Astro.url.searchParams;
let typedAmount: string | null = query.get('amount');
let requestedDestination: string | null = query.get('destination_id');
let step: 'amount' | 'review' | 'receipt' = query.get('step') === 'review' ? 'review' : 'amount';

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });

  if (Astro.request.method === 'POST') {
    if (!isSameOrigin(Astro.request, Astro.url.origin)) {
      return new Response('cross-origin request refused', { status: 403 });
    }
    const form = await Astro.request.formData();
    const destinationId = form.get('destination_id');
    const typed = form.get('amount');
    const currency = form.get('currency');
    typedAmount = typeof typed === 'string' ? typed : null;
    requestedDestination = typeof destinationId === 'string' ? destinationId : null;
    step = 'amount';

    if (typeof destinationId !== 'string' || destinationId === '') {
      refusal = t.destinationRequired;
    } else if (typeof typed !== 'string' || typeof currency !== 'string') {
      refusal = t.amountUnreadable;
    } else {
      const minor = parseAmountToMinor(typed, currencyDigits(lang, currency));
      if (minor === null || minor <= 0) {
        // Nothing is sent. A field read as zero is how somebody asks for
        // their balance and receives no money.
        refusal = t.amountUnreadable;
      } else {
        try {
          recorded = await api.requestWithdrawal(destinationId, minor, currency);
          step = 'receipt';
        } catch (error) {
          if (!(error instanceof CashbackApiError)) {
            throw error;
          }
          // The two balance walls share one code and differ in their
          // figures, so the sentence is built from the figures rather than
          // from the code: below the floor names the floor, beyond the
          // balance names the shortfall.
          const problem = error.problem;
          const threshold = problem?.['threshold'];
          const shortfall = problem?.['shortfall'];
          const parts: string[] = [];
          if (isMoney(threshold)) {
            parts.push(t.belowThreshold(formatMoney(lang, threshold)));
          }
          if (isMoney(shortfall)) {
            parts.push(t.shortfall(formatMoney(lang, shortfall)));
          }
          refusal =
            parts.length > 0
              ? parts.join(' ')
              : (problem?.title ?? t.emptyQueue);
        }
      }
    }
  }

  [totals, destinations, history] = await Promise.all([
    api.wallet(),
    api.destinations(),
    api.withdrawals(),
  ]);
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);
const verified = destinations.filter((destination) => destination.verified_at !== null);
const currency = totals?.confirmed.currency ?? 'EUR';
const digits = currencyDigits(lang, currency);

/** The decimal separator the member writes with — "," in German and Greek. */
const decimalMark =
  new Intl.NumberFormat(lang).formatToParts(1.1).find((part) => part.type === 'decimal')?.value ?? '.';

/** A minor-unit figure as the member would type it: "240,60". */
const typeable = (minor: number): string => decimalString(minor, digits).replace('.', decimalMark);

// The selection: the destination the URL names if it is verified, else the
// first verified one. An unverified destination is refused at withdrawal,
// so the page never pre-selects one.
const selectedDestination =
  verified.find((destination) => destination.id === requestedDestination) ?? verified[0] ?? null;

// The amount: what was typed, or the whole confirmed balance — the one
// quick-pick this page can vouch for.
const confirmedMinor = totals?.confirmed.minor ?? 0;
const amountText = typedAmount ?? typeable(confirmedMinor);
const amountMinor = parseAmountToMinor(amountText, digits);

// The review step needs figures it can read. If it cannot, it is the amount
// step again, with the refusal stated where the field is.
if (step === 'review' && (amountMinor === null || amountMinor <= 0)) {
  refusal = t.amountUnreadable;
  step = 'amount';
}
if (step === 'review' && selectedDestination === null) {
  refusal = t.destinationRequired;
  step = 'amount';
}

/** The figure the review and the primary button name. */
const amountLabel = formatMoney(lang, {
  minor: amountMinor !== null && amountMinor > 0 ? amountMinor : confirmedMinor,
  currency,
});

/** The step-1 URL that carries the figures back from the review. */
const backHref = ((): string => {
  const params = new URLSearchParams();
  params.set('amount', amountText);
  if (selectedDestination !== null) {
    params.set('destination_id', selectedDestination.id);
  }
  return `${withdrawPath(lang, slugs)}?${params.toString()}`;
})();

/** Which step the phone's progress bars have reached. */
const progress = step === 'receipt' ? 3 : step === 'review' ? 2 : 1;
---

<ReaderLayout lang={lang} title={t.withdrawTitle} description={t.cashback} homeHref={homeHref}>
  <CashbackBar
    lang={lang}
    slugs={slugs}
    current="wallet"
    aside={totals !== null ? t.verifiedPayoutsOn : undefined}
  />

  <main class:list={['withdraw', `step-${step}`]}>
    {fixtures && <FixtureNotice title={t.cashback} body={t.fixtureNotice} />}
    {apiUnavailable && <p class="band" role="alert">{t.emptyQueue}</p>}

    {
      totals !== null && (
        <div class="scene">
          {/* Desktop: the wallet's balance strip, dimmed behind the dialog. */}
          <section class="ghost" aria-hidden="true">
            <div class="ghost-cell">
              <h6>{t.confirmedWithdrawable}</h6>
              <div class="ghost-figure">{formatMoney(lang, totals.confirmed)}</div>
            </div>
            <div class="ghost-cell">
              <h6>{t.pending}</h6>
              <div class="ghost-figure muted">{formatMoney(lang, totals.pending)}</div>
            </div>
            <div class="ghost-cell">
              <h6>{t.reserved}</h6>
              <div class="ghost-figure muted">{formatMoney(lang, totals.reserved)}</div>
            </div>
            <div class="ghost-cell">
              <h6>{t.paidOut}</h6>
              <div class="ghost-figure">{formatMoney(lang, totals.paid_out)}</div>
            </div>
            <div class="ghost-cell ghost-buttons">
              <span class="btn btn-primary">{t.withdraw}</span>
              <span class="btn btn-secondary">{t.browseOffers}</span>
            </div>
          </section>

          {/* Phone: the back link and the three progress bars. */}
          {
            step !== 'receipt' && (
              <nav class="phone-bar" aria-label={t.steps}>
                <a class="phone-back" href={step === 'review' ? backHref : walletPath(lang, slugs)}>
                  ← {step === 'review' ? t.back : t.cashback}
                </a>
                <span class="progress" aria-hidden="true">
                  <span class:list={['bar', { on: progress >= 1 }]} />
                  <span class:list={['bar', { on: progress >= 2 }]} />
                  <span class:list={['bar', { on: progress >= 3 }]} />
                </span>
              </nav>
            )
          }

          {
            recorded !== null ? (
              <section class="dialog receipt" role="status" aria-label={t.receipt}>
                <div class="receipt-head">
                  <div class="receipt-kicker">{t.recorded}</div>
                  <h2>{t.awaitingNamedApproval(formatMoney(lang, recorded.reserved_amount))}</h2>
                  <p>{t.withdrawalStates[recorded.state]}</p>
                </div>
                <div class="receipt-body">
                  <h6>{t.receipt}</h6>
                  <div class="rows">
                    <div class="row">
                      <span class="k">{t.reference}</span>
                      <span class="v mono">{recorded.request_id}</span>
                    </div>
                    <div class="row">
                      <span class="k">{t.reserved}</span>
                      <span class="v">{formatMoney(lang, recorded.reserved_amount)}</span>
                    </div>
                    <div class="row">
                      <span class="k">{t.newBalance}</span>
                      <span class="v strong">
                        {formatMoney(lang, totals.confirmed)} · {t.pending} {formatMoney(lang, totals.pending)}
                      </span>
                    </div>
                  </div>
                  <p class="note-box">{t.receiptNote}</p>
                  <div class="receipt-actions">
                    <a class="btn btn-ghost" href={walletPath(lang, slugs)}>{t.backToWallet}</a>
                  </div>
                </div>
              </section>
            ) : verified.length === 0 ? (
              <section class="dialog">
                <div class="head">
                  <div>
                    <h3>{t.withdrawTitle}</h3>
                    <p class="sub">{t.withdrawIntro}</p>
                  </div>
                </div>
                <p class="band inside">{t.noVerifiedDestination}</p>
                <div class="foot">
                  <div class="foot-actions">
                    <a class="btn btn-secondary" href={walletPath(lang, slugs)}>{t.cancel}</a>
                  </div>
                </div>
              </section>
            ) : (
              <form
                class="dialog"
                method="get"
                action={withdrawPath(lang, slugs)}
                data-lang={lang}
                data-currency={currency}
                data-digits={digits}
              >
                <input type="hidden" name="step" value="review" />
                <input type="hidden" name="currency" value={currency} />

                {/* Desktop: the dialog head. Phone: the step-1 head. */}
                <div class="head">
                  <div>
                    <h3>{t.withdrawTitle}</h3>
                    <p class="sub">{t.withdrawIntro}</p>
                  </div>
                  <span class="avail">
                    {t.available} <strong>{formatMoney(lang, totals.confirmed)}</strong> · {t.pending}{' '}
                    {formatMoney(lang, totals.pending)}
                  </span>
                </div>

                {refusal !== null && <p class="band inside" role="alert">{refusal}</p>}

                <div class="body">
                  <div class="col amount-col">
                    {/* Phone: the available and pending rows. */}
                    <div class="rows avail-rows">
                      <div class="row">
                        <span>{t.available}</span>
                        <span class="v strong">{formatMoney(lang, totals.confirmed)}</span>
                      </div>
                      <div class="row dim">
                        <span>{t.pendingNotWithdrawable}</span>
                        <span>{formatMoney(lang, totals.pending)}</span>
                      </div>
                    </div>

                    <div class="field amount-field">
                      <label for="amount">{t.amountLabel}</label>
                      <input
                        class="input amount"
                        id="amount"
                        name="amount"
                        inputmode="decimal"
                        autocomplete="off"
                        value={amountText}
                        required
                      />
                    </div>
                    <div class="quick">
                      <a
                        class="btn btn-secondary quick-all"
                        href={`${withdrawPath(lang, slugs)}?amount=${encodeURIComponent(typeable(confirmedMinor))}`}
                        data-amount={typeable(confirmedMinor)}
                      >
                        {t.all} {formatMoney(lang, totals.confirmed)}
                      </a>
                    </div>

                    <h6 class="to">{t.destinationLabel}</h6>
                    <div class="dests" role="radiogroup" aria-label={t.destinationLabel}>
                      {
                        destinations.map((destination) => (
                          <label class:list={['dest', { off: destination.verified_at === null }]}>
                            <input
                              type="radio"
                              name="destination_id"
                              value={destination.id}
                              disabled={destination.verified_at === null}
                              checked={selectedDestination !== null && destination.id === selectedDestination.id}
                              data-details={destination.details}
                            />
                            <span class="mark" aria-hidden="true" />
                            <span class="dest-text">
                              <span class="dest-title mono">{destination.details}</span>
                              <span class="dest-sub">
                                {destination.verified_at === null ? t.destinationUnverified : t.verifiedPayoutsOn}
                              </span>
                            </span>
                          </label>
                        ))
                      }
                    </div>

                    {/* Phone step 1: Continue, pinned at the bottom. */}
                    <div class="continue">
                      <button class="btn btn-primary btn-block" type="submit">{t.continueLabel}</button>
                    </div>
                  </div>

                  <div class="col review-col">
                    {/* Desktop: the column's one kicker. Phone step 2: the screen's h2. */}
                    <h6 class="next-h">{t.whatHappensNext}</h6>
                    <h2 class="review-h">{t.review}</h2>
                    <div class="rows review-rows">
                      <div class="row">
                        <span class="k">{t.withdrawRow}</span>
                        <span class="v live-amount">{amountLabel}</span>
                      </div>
                      <div class="row">
                        <span class="k">{t.destinationLabel}</span>
                        <span class="v mono live-dest">{selectedDestination?.details ?? ''}</span>
                      </div>
                      <div class="row stacked">
                        <span class="k">{t.reserved}</span>
                        <span class="rule">{t.wholeEntriesRule}</span>
                      </div>
                      <div class="row">
                        <span class="k">{t.executedBy}</span>
                        <span class="v">{t.licensedPartner}</span>
                      </div>
                    </div>

                    {/* Phone step 2: the note and the confirm. */}
                    <p class="note-box phone-note">{t.approvalStep2}</p>
                    <div class="confirm">
                      <button class="btn btn-primary btn-block" type="submit" formmethod="post">
                        {t.withdraw} <span class="live-amount">{amountLabel}</span>
                      </button>
                    </div>
                  </div>
                </div>

                <div class="foot">
                  <span class="foot-note">{t.approvalStep2}</span>
                  <div class="foot-actions">
                    <a class="btn btn-secondary" href={walletPath(lang, slugs)}>{t.cancel}</a>
                    <button class="btn btn-primary" type="submit" formmethod="post">
                      {t.withdraw} <span class="live-amount">{amountLabel}</span>
                    </button>
                  </div>
                </div>
              </form>
            )
          }
        </div>
      )
    }

    {
      totals !== null && (
        <section class="history" aria-label={t.yourWithdrawals}>
          <h6>{t.yourWithdrawals}</h6>
          {history.length === 0 && <p class="empty">{t.noWithdrawals}</p>}
          {
            history.map((withdrawal) => (
              <article class="record">
                <div class="record-head">
                  <span class="record-figure">{formatMoney(lang, withdrawal.amount)}</span>
                  <span class="tag tag-neutral">{t.withdrawalStates[withdrawal.state]}</span>
                  <span class="record-date">{formatItemDate(lang, new Date(withdrawal.requested_at))}</span>
                </div>
                <div class="rows">
                  <div class="row">
                    <span class="k">{t.reserved}</span>
                    <span class="v">{formatMoney(lang, withdrawal.reserved_amount)}</span>
                  </div>
                  <div class="row">
                    <span class="k">{t.destinationLabel}</span>
                    <span class="v mono">{withdrawal.destination.details}</span>
                  </div>
                  {
                    withdrawal.decision_reason !== null && (
                      <div class="row">
                        <span class="k">{t.decisionReason}</span>
                        <span class="v">{withdrawal.decision_reason}</span>
                      </div>
                    )
                  }
                  {
                    withdrawal.payout_reference !== null && (
                      <div class="row">
                        <span class="k">{t.payoutReference}</span>
                        <span class="v mono">{withdrawal.payout_reference}</span>
                      </div>
                    )
                  }
                </div>
              </article>
            ))
          }
        </section>
      )
    }
  </main>
</ReaderLayout>

<script>
  // The dialog's live figures: the quick-pick fills the field, and the
  // review row and the primary button follow what is typed. Without
  // scripting the quick-pick is a link that reloads the step with the
  // amount, and the review step formats the figure on the server.
  const form = document.querySelector<HTMLFormElement>('form.dialog');
  const input = document.querySelector<HTMLInputElement>('#amount');
  if (form !== null && input !== null) {
    const lang = form.dataset['lang'] ?? 'en';
    const currency = form.dataset['currency'] ?? 'EUR';
    const digits = Number(form.dataset['digits'] ?? '2');
    const money = new Intl.NumberFormat(lang, { style: 'currency', currency });
    const lives = form.querySelectorAll<HTMLElement>('.live-amount');
    const dest = form.querySelector<HTMLElement>('.live-dest');

    const reflect = (): void => {
      const raw = input.value.replace(/\s/g, '').replace(/[^\d.,]/g, '');
      const at = Math.max(raw.lastIndexOf('.'), raw.lastIndexOf(','));
      const tail = at === -1 ? '' : raw.slice(at + 1);
      const isDecimal = at !== -1 && tail.length === digits;
      const whole = (isDecimal ? raw.slice(0, at) : raw).replace(/[.,]/g, '');
      if (whole === '' || (!isDecimal && at !== -1 && tail.length > 0)) {
        return;
      }
      const value = Number(`${whole}.${isDecimal ? tail : ''}` || '0');
      if (!Number.isFinite(value) || value <= 0) {
        return;
      }
      for (const live of lives) {
        live.textContent = money.format(value);
      }
    };

    input.addEventListener('input', reflect);
    form.querySelector<HTMLAnchorElement>('.quick-all')?.addEventListener('click', (event) => {
      const amount = (event.currentTarget as HTMLAnchorElement).dataset['amount'];
      if (amount !== undefined) {
        event.preventDefault();
        input.value = amount;
        reflect();
        input.focus();
      }
    });
    form.querySelectorAll<HTMLInputElement>('input[name="destination_id"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (dest !== null && radio.checked) {
          dest.textContent = radio.dataset['details'] ?? '';
        }
      });
    });
  }
</script>

<style>
  .withdraw {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0 0 28px;
  }
  .band {
    border: 2px solid var(--color-divider);
    background: var(--color-surface);
    padding: 20px;
    margin: 20px 26px 0;
    font-size: 14px;
    text-wrap: pretty;
  }
  .band.inside {
    margin: 16px 26px 0;
    border-color: var(--color-accent);
  }
  h6 {
    margin: 0 0 10px;
  }
  .mono {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11.5px;
  }

  /* — the scene: the dimmed wallet with the dialog over it — */
  .scene {
    position: relative;
    padding: 44px;
    display: grid;
    place-items: start center;
    min-height: 620px;
  }
  .scene::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-neutral-900) 45%, transparent);
    z-index: 1;
  }
  .ghost {
    position: absolute;
    inset: 0 0 auto 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-bottom: 2px solid var(--color-divider);
  }
  .ghost-cell {
    padding: 20px 24px;
    border-right: 1px solid var(--color-divider);
  }
  .ghost-cell h6 {
    margin: 0 0 8px;
  }
  .ghost-cell:last-child {
    border-right: 0;
  }
  .ghost-figure {
    font: var(--font-heading-weight) 28px/1 var(--font-heading);
    white-space: nowrap;
  }
  .ghost-figure.muted {
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .ghost-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }
  .ghost-buttons .btn {
    font-size: 13px;
  }

  /* — the dialog — */
  .dialog {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1152px;
    margin: 0;
    padding: 0;
    gap: 0;
    border-radius: 0;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 20px 26px;
    border-bottom: 2px solid var(--color-divider);
  }
  .head h3 {
    margin: 0 0 4px;
    font-size: 24px;
  }
  .sub {
    margin: 0;
    font-size: 13px;
    color: color-mix(in srgb, var(--color-text) 65%, transparent);
    text-wrap: pretty;
  }
  .avail {
    font-size: 12.5px;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    white-space: nowrap;
  }
  .avail strong {
    color: var(--color-text);
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .col {
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
  }
  .amount-col {
    border-right: 1px solid var(--color-divider);
  }

  /* left: amount, quick-pick, destination */
  .rows.avail-rows {
    display: none;
  }
  .amount-field {
    margin-bottom: 10px;
  }
  .amount {
    font: var(--font-heading-weight) 22px var(--font-heading);
    padding: 12px 14px;
  }
  .quick {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  .quick .btn {
    font-size: 12.5px;
  }
  .to {
    margin: 0 0 10px;
  }
  .dests {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dest {
