---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import CashbackNav from '../../../../components/CashbackNav.astro';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import Masthead from '../../../../components/Masthead.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackApiError,
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import {
  currencyDigits,
  formatMoney,
  isMoney,
  parseAmountToMinor,
} from '../../../../lib/cashback/money';
import { walletPath, withdrawPath } from '../../../../lib/cashback/paths';
import type {
  PayoutDestination,
  WalletTotals,
  Withdrawal,
  WithdrawalRequest,
} from '../../../../lib/cashback/types';
import { isSameOrigin } from '../../../../lib/csrf';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { formatItemDate } from '../../../../lib/reader/format';
import { cashbackStrings } from '../../../../i18n/cashback';

// Withdrawal — mockup 4d, rebuilt against POST /withdrawals (T096 #243).
//
// The mockup draws three phone steps and a desktop dialog ending in a
// receipt that reads "€199.50 is on its way · arrived at your bank in 4
// seconds". None of that is what happens, and the differences are not
// cosmetic:
//
//   - **Every withdrawal waits for a named human.** C-4 forbids a payout
//     without one, so the API answers `awaiting_approval` whatever the
//     amount. There is no straight-through path and no state in which money
//     has moved by the time this page renders. The mockup's "held only above
//     €1 000" is recorded as issue #443.
//   - **There is no speed and no fee.** The contract has no field for
//     either, and payout rails are founder question Q5, undecided. Issue
//     #442. Offering a choice this deployment cannot honour would be the
//     screen promising something nothing behind it can do.
//   - **The reserved amount is not the requested amount.** Reservation is in
//     whole entries, oldest first, so asking for 15.00 against entries of
//     10.00 and 20.00 reserves 30.00. The rule is stated before the member
//     submits, not explained afterwards. Issue #444.
//   - **"Keep it in the wallet · spend it at partners or send it home" is
//     absent.** In-app spending and member-to-member transfers are excluded
//     by the founder decision of 2026-08-24. Issue #446.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let totals: WalletTotals | null = null;
let destinations: readonly PayoutDestination[] = [];
let history: readonly Withdrawal[] = [];
let apiUnavailable = false;

/** What the last submission produced, if there was one. */
let recorded: WithdrawalRequest | null = null;
let refusal: string | null = null;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });

  if (Astro.request.method === 'POST') {
    if (!isSameOrigin(Astro.request, Astro.url.origin)) {
      return new Response('cross-origin request refused', { status: 403 });
    }
    const form = await Astro.request.formData();
    const destinationId = form.get('destination_id');
    const typed = form.get('amount');
    const currency = form.get('currency');

    if (typeof destinationId !== 'string' || destinationId === '') {
      refusal = t.destinationRequired;
    } else if (typeof typed !== 'string' || typeof currency !== 'string') {
      refusal = t.amountUnreadable;
    } else {
      const minor = parseAmountToMinor(typed, currencyDigits(lang, currency));
      if (minor === null || minor <= 0) {
        // Nothing is sent. A field read as zero is how somebody asks for
        // their balance and receives no money.
        refusal = t.amountUnreadable;
      } else {
        try {
          recorded = await api.requestWithdrawal(destinationId, minor, currency);
        } catch (error) {
          if (!(error instanceof CashbackApiError)) {
            throw error;
          }
          // The two balance walls share one code and differ in their
          // figures, so the sentence is built from the figures rather than
          // from the code: below the floor names the floor, beyond the
          // balance names the shortfall.
          const problem = error.problem;
          const threshold = problem?.['threshold'];
          const shortfall = problem?.['shortfall'];
          const parts: string[] = [];
          if (isMoney(threshold)) {
            parts.push(t.belowThreshold(formatMoney(lang, threshold)));
          }
          if (isMoney(shortfall)) {
            parts.push(t.shortfall(formatMoney(lang, shortfall)));
          }
          refusal =
            parts.length > 0
              ? parts.join(' ')
              : (problem?.title ?? t.emptyQueue);
        }
      }
    }
  }

  [totals, destinations, history] = await Promise.all([
    api.wallet(),
    api.destinations(),
    api.withdrawals(),
  ]);
} catch (error) {
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);
const verified = destinations.filter((destination) => destination.verified_at !== null);
const currency = totals?.confirmed.currency ?? 'EUR';
---

<ReaderLayout lang={lang} title={t.withdrawTitle} description={t.cashback} homeHref={homeHref}>
  <Masthead homeHref={homeHref} />
  <CashbackNav lang={lang} slugs={slugs} current="wallet" />

  <main class="withdraw">
    {fixtures && <FixtureNotice title={t.cashback} body={t.fixtureNotice} />}
    {apiUnavailable && <p class="band" role="alert">{t.emptyQueue}</p>}

    <p class="crumb"><a href={walletPath(lang, slugs)}>{t.backToWallet}</a></p>

    <h1>{t.withdrawTitle}</h1>
    <p class="intro">{t.withdrawIntro}</p>

    {
      recorded !== null && (
        <section class="recorded" role="status">
          <p class="ref">{t.requestRecorded(recorded.request_id)}</p>
          <p>{t.reservedForRequest(formatMoney(lang, recorded.reserved_amount))}</p>
          <p class="state tag tag-accent">{t.withdrawalStates[recorded.state]}</p>
        </section>
      )
    }

    {refusal !== null && <p class="band" role="alert">{refusal}</p>}

    {
      totals !== null && (
        <dl class="figures">
          <dt>{t.confirmedWithdrawable}</dt>
          <dd>{formatMoney(lang, totals.confirmed)}</dd>
          <dt>{t.pending}</dt>
          <dd class="muted">{formatMoney(lang, totals.pending)}</dd>
          <dt>{t.reserved}</dt>
          <dd class="muted">{formatMoney(lang, totals.reserved)}</dd>
          <dt>{t.payoutThreshold}</dt>
          <dd class="muted">{formatMoney(lang, totals.payout_threshold)}</dd>
        </dl>
      )
    }

    {
      verified.length === 0 ? (
        <p class="band">{t.noVerifiedDestination}</p>
      ) : (
        <form class="request" method="post" action={withdrawPath(lang, slugs)}>
          <input type="hidden" name="currency" value={currency} />

          <div class="field">
            <label for="amount">{t.amountLabel}</label>
            <input
              class="input amount"
              id="amount"
              name="amount"
              inputmode="decimal"
              autocomplete="off"
              required
            />
          </div>

          <fieldset class="destinations">
            <legend>{t.destinationLabel}</legend>
            {
              destinations.map((destination, index) => (
                <label class:list={['destination', { off: destination.verified_at === null }]}>
                  <input
                    type="radio"
                    name="destination_id"
                    value={destination.id}
                    disabled={destination.verified_at === null}
                    checked={destination.verified_at !== null && index === 0}
                  />
                  <span>
                    <span class="details">{destination.details}</span>
                    {destination.verified_at === null && (
                      <span class="unverified">{t.destinationUnverified}</span>
                    )}
                  </span>
                </label>
              ))
            }
          </fieldset>

          <p class="rule">{t.wholeEntriesRule}</p>

          <section class="next">
            <h2>{t.whatHappensNext}</h2>
            <ol>
              <li>{t.approvalStep1}</li>
              <li>{t.approvalStep2}</li>
              <li>{t.approvalStep3}</li>
            </ol>
          </section>

          <button class="btn btn-primary" type="submit">{t.withdraw}</button>
        </form>
      )
    }

    <section class="history">
      <h2>{t.yourWithdrawals}</h2>
      {history.length === 0 && <p class="empty">{t.noWithdrawals}</p>}
      {
        history.map((withdrawal) => (
          <article class="row">
            <div class="row-head">
              <span class="figure">{formatMoney(lang, withdrawal.amount)}</span>
              <span class="tag tag-neutral">{t.withdrawalStates[withdrawal.state]}</span>
            </div>
            <dl>
              <dt>{t.requestedAt}</dt>
              <dd>{formatItemDate(lang, new Date(withdrawal.requested_at))}</dd>
              <dt>{t.reserved}</dt>
              <dd>{formatMoney(lang, withdrawal.reserved_amount)}</dd>
              <dt>{t.destinationLabel}</dt>
              <dd>{withdrawal.destination.details}</dd>
              {
                withdrawal.decision_reason !== null && (
                  <>
                    <dt>{t.decisionReason}</dt>
                    <dd>{withdrawal.decision_reason}</dd>
                  </>
                )
              }
              {
                withdrawal.payout_reference !== null && (
                  <>
                    <dt>{t.payoutReference}</dt>
                    <dd class="ref">{withdrawal.payout_reference}</dd>
                  </>
                )
              }
            </dl>
          </article>
        ))
      }
    </section>
  </main>
</ReaderLayout>

<style>
  .withdraw {
    flex: 1;
    padding: var(--space-6) calc(var(--space-6) + var(--space-1)) 28px;
    max-width: 72ch;
  }
  .crumb {
    margin: 0 0 var(--space-4);
    font-size: 13px;
  }
  h1 {
    margin: 0 0 var(--space-3);
  }
  .intro {
    margin: 0 0 var(--space-6);
    font-size: 15px;
    text-wrap: pretty;
  }
  .band,
  .recorded {
    border: 2px solid var(--color-divider);
    background: var(--color-surface);
    padding: 20px;
    margin: 0 0 var(--space-6);
    font-size: 14px;
    text-wrap: pretty;
  }
  .recorded {
    border-color: var(--color-accent);
  }
  .recorded p {
    margin: 0 0 var(--space-2);
  }
  .ref {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 13px;
  }
  .figures {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3) 20px;
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-4);
    margin: 0 0 var(--space-6);
    font-size: 14px;
  }
  .figures dt {
    color: var(--ink-muted);
  }
  .figures dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
  }
  .figures dd.muted {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .amount {
    font: var(--font-heading-weight) 22px/1.2 var(--font-heading);
  }
  .destinations {
    border: 0;
    padding: 0;
    margin: 20px 0;
  }
  .destinations legend {
    font: 600 11px/1.3 var(--font-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0;
    margin-bottom: var(--space-3);
  }
  .destination {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    border: 1px solid var(--color-divider);
    padding: var(--space-4);
    margin-bottom: var(--space-2);
    cursor: pointer;
  }
  .destination.off {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .details {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 14px;
  }
  .unverified {
    display: block;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .rule {
    font-size: 13px;
    color: var(--ink-muted);
    text-wrap: pretty;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    margin: 20px 0;
  }
  .next h2,
  .history h2 {
    font-size: 18px;
    margin: var(--space-6) 0 var(--space-3);
  }
  .next ol {
    margin: 0 0 var(--space-6);
    padding-left: var(--space-6);
    font-size: 14px;
  }
  .next li {
    margin-bottom: var(--space-2);
    text-wrap: pretty;
  }
  .history {
    border-top: 2px solid var(--color-divider);
    margin-top: 28px;
  }
  .row {
    border-bottom: 1px solid var(--color-divider);
    padding: 20px 0;
  }
  .row-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .row .figure {
    font: var(--font-heading-weight) 18px/1 var(--font-heading);
  }
  .row dl {
    display: grid;
    grid-template-columns: minmax(120px, auto) 1fr;
    gap: var(--space-2) 20px;
    margin: 0;
    font-size: 13px;
  }
  .row dt {
    color: var(--ink-muted);
  }
  .row dd {
    margin: 0;
  }
  .empty {
    font-size: 14px;
    color: var(--ink-muted);
  }
  @media (max-width: 560px) {
    .withdraw {
      padding: 20px var(--space-4) var(--space-6);
    }
  }
</style>
