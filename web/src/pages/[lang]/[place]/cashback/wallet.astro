---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import CashbackNav from '../../../../components/CashbackNav.astro';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import Masthead from '../../../../components/Masthead.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import { formatMoney, formatSignedMoney } from '../../../../lib/cashback/money';
import { cataloguePath, walletPath, withdrawPath } from '../../../../lib/cashback/paths';
import type {
  EntryState,
  WalletEntry,
  WalletTotals,
} from '../../../../lib/cashback/types';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { formatItemDate } from '../../../../lib/reader/format';
import { cashbackStrings } from '../../../../i18n/cashback';

// The member's wallet and entry list — mockup 4a, bound to the contract
// rather than to the drawing (T082 #229).
//
// Four differences from the mockup, each of them a fact about the money
// rather than a design preference:
//
//   1. There is a `reserved` tile. `GET /wallet` returns five totals and
//      the mockup drew three; without reserved, a member whose withdrawal
//      is awaiting approval sees a confirmed balance that dropped for no
//      visible reason. Recorded as issue #444.
//   2. The threshold is stated. FR-050 puts a floor under a withdrawal and
//      a member who cannot reach it should learn that here, not from a 409.
//   3. No entry is card-linked. The mockup's fuel, bakery and taverna rows
//      are in-store purchases tracked by a linked card, which the
//      constitution puts out of scope and for which no evidence path
//      exists (issue #445).
//   4. A reversal is a row of its own, beside the credit it reverses, with
//      its reason. US3 scenario 2 requires both to be visible, so the
//      filter cannot hide one and there is no control that would.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

/** The filter tabs, as the mockup draws them. `undefined` is "all". */
const FILTERS: readonly { readonly key: string; readonly state: EntryState | undefined }[] = [
  { key: 'all', state: undefined },
  { key: 'pending', state: 'pending' },
  { key: 'confirmed', state: 'confirmed' },
  { key: 'paid', state: 'paid' },
];

// The filter travels in the URL rather than in client state: a filtered
// wallet is a thing a member links to and returns to, and a tab that only
// exists in memory cannot be either.
const requested = Astro.url.searchParams.get('state');
const active = FILTERS.find((filter) => filter.key === requested) ?? FILTERS[0]!;

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let totals: WalletTotals | null = null;
let entries: readonly WalletEntry[] = [];
let allCount = 0;
let apiUnavailable = false;
let participating = true;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });
  const participation = await api.participation();
  participating = participation !== null && participation.status === 'active';
  if (participating) {
    [totals, entries, allCount] = await Promise.all([
      api.wallet(),
      api.entries({ state: active.state }).then((page) => page.items),
      api.entries().then((page) => page.items.length),
    ]);
  }
} catch (error) {
  // A misconfigured deployment is otherwise silent: every page answers 503
  // and nothing says why, and the operator is the only one who can fix it.
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);

/** A filter tab's URL — the page's own path plus the state it selects. */
const filterHref = (key: string): string =>
  key === 'all' ? walletPath(lang, slugs) : `${walletPath(lang, slugs)}?state=${key}`;

/** The label for a filter key, from the catalogue. */
const filterLabel = (key: string): string =>
  ({
    all: t.filterAll,
    pending: t.filterPending,
    confirmed: t.filterConfirmed,
    paid: t.filterPaid,
  })[key] ?? key;

/** Whether a withdrawal can be asked for at all, on today's figures. */
const canWithdraw =
  totals !== null && totals.confirmed.minor >= totals.payout_threshold.minor && totals.confirmed.minor > 0;
---

<ReaderLayout
  lang={lang}
  title={t.wallet}
  description={t.cashback}
  homeHref={homeHref}
>
  <Masthead homeHref={homeHref} />
  <CashbackNav lang={lang} slugs={slugs} current="wallet" />

  <main class="wallet">
    {
      fixtures && (
        <FixtureNotice title={t.cashback} body={t.fixtureNotice} />
      )
    }

    {
      apiUnavailable && (
        <p class="band" role="alert">{t.emptyQueue}</p>
      )
    }

    {
      !apiUnavailable && !session.authenticated && !fixtures && (
        <p class="band" role="alert">{t.notParticipating}</p>
      )
    }

    {
      !apiUnavailable && !participating && (
        <section class="band">
          <p>{t.notParticipating}</p>
          <a class="btn btn-primary" href={cataloguePath(lang, slugs)}>{t.catalogue}</a>
        </section>
      )
    }

    {
      totals !== null && (
        <>
          <section class="totals" aria-label={t.wallet}>
            <div class="total">
              <h2>{t.confirmedWithdrawable}</h2>
              <p class="figure">{formatMoney(lang, totals.confirmed)}</p>
              <p class="note">{t.belowThreshold(formatMoney(lang, totals.payout_threshold))}</p>
            </div>
            <div class="total">
              <h2>{t.pending}</h2>
              <p class="figure muted">{formatMoney(lang, totals.pending)}</p>
              <p class="note">{t.pendingExplained}</p>
            </div>
            <div class="total">
              <h2>{t.reserved}</h2>
              <p class="figure muted">{formatMoney(lang, totals.reserved)}</p>
              <p class="note">{t.reservedExplained}</p>
            </div>
            <div class="total">
              <h2>{t.paidOut}</h2>
              <p class="figure muted">{formatMoney(lang, totals.paid_out)}</p>
              <div class="actions">
                {
                  canWithdraw ? (
                    <a class="btn btn-primary" href={withdrawPath(lang, slugs)}>{t.withdraw}</a>
                  ) : (
                    <a class="btn btn-secondary" href={cataloguePath(lang, slugs)}>{t.catalogue}</a>
                  )
                }
              </div>
            </div>
          </section>

          <nav class="filters" aria-label={t.entries}>
            {
              FILTERS.map((filter) => (
                <a
                  href={filterHref(filter.key)}
                  class:list={['filter', { on: filter.key === active.key }]}
                  aria-current={filter.key === active.key ? 'true' : undefined}
                >
                  {filterLabel(filter.key)}
                </a>
              ))
            }
            <span class="count">{t.entryCount(entries.length, allCount)}</span>
          </nav>

          <section class="entries" aria-label={t.entries}>
            {
              entries.length === 0 && (
                <p class="empty">{allCount === 0 ? t.noEntries : t.noEntriesInFilter}</p>
              )
            }
            {
              entries.map((entry) => (
                <details class="entry" open={entry.reversal_of_id !== null}>
                  <summary>
                    <span class="who">
                      <span class="merchant">{entry.merchant_name}</span>
                      <span class="meta">
                        {formatItemDate(lang, new Date(entry.transacted_at))}
                        {' · '}
                        {t.sale} {formatMoney(lang, entry.sale_amount)}
                      </span>
                    </span>
                    <span class="tag tag-neutral state">{t.entryStates[entry.state]}</span>
                    <span class="amount">{formatSignedMoney(lang, entry.cashback_amount)}</span>
                  </summary>
                  <div class="record">
                    <dl>
                      <dt>{t.sale}</dt>
                      <dd>{formatMoney(lang, entry.sale_amount)}</dd>
                      {
                        entry.expected_confirmation_at !== null && (
                          <>
                            <dt>{t.expectedConfirmation}</dt>
                            <dd>
                              {formatItemDate(lang, new Date(entry.expected_confirmation_at))}
                            </dd>
                          </>
                        )
                      }
                      {
                        entry.reversal_of_id !== null && (
                          <>
                            <dt>{t.reversalOf}</dt>
                            <dd class="ref">{entry.reversal_of_id}</dd>
                          </>
                        )
                      }
                      {
                        entry.reason !== null && (
                          <>
                            <dt>{t.reversalReason}</dt>
                            <dd>{entry.reason}</dd>
                          </>
                        )
                      }
                    </dl>
                    <p class="note">{t.rateAtClick}</p>
                  </div>
                </details>
              ))
            }
          </section>
        </>
      )
    }
  </main>
</ReaderLayout>

<style>
  .wallet {
    flex: 1;
    padding: var(--space-6) calc(var(--space-6) + var(--space-1)) 28px;
  }
  .band {
    border: 2px solid var(--color-divider);
    background: var(--color-surface);
    padding: 20px;
    margin: 0 0 var(--space-6);
    font-size: 14px;
  }
  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    border: 2px solid var(--color-divider);
    margin-bottom: var(--space-6);
  }
  .total {
    padding: 20px;
    border-right: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .total:last-child {
    border-right: 0;
  }
  .total h2 {
    margin: 0;
    font: 600 11px/1.3 var(--font-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .figure {
    margin: 0;
    font: var(--font-heading-weight) 30px/1 var(--font-heading);
  }
  .figure.muted {
    color: var(--ink-soft);
  }
  .note {
    margin: 0;
    font-size: 12px;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .actions {
    margin-top: auto;
    padding-top: var(--space-3);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    border-bottom: 2px solid var(--color-divider);
    margin-bottom: var(--space-2);
  }
  .filter {
    padding: var(--space-3) 20px;
    font: 600 13px/1.2 var(--font-heading);
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
  }
  .filter.on {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .count {
    margin-left: auto;
    padding: 0 var(--space-4);
    font-size: 12px;
    color: var(--ink-muted);
  }
  .entry {
    border-bottom: 1px solid var(--color-divider);
  }
  .entry summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    cursor: pointer;
  }
  .who {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .merchant {
    font-size: 15px;
    font-weight: 600;
  }
  .meta {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .amount {
    font: var(--font-heading-weight) 16px/1 var(--font-heading);
    white-space: nowrap;
  }
  .record {
    padding: 0 var(--space-2) 20px var(--space-6);
  }
  .record dl {
    display: grid;
    grid-template-columns: minmax(120px, auto) 1fr;
    gap: var(--space-2) 20px;
    margin: 0 0 var(--space-4);
    font-size: 13px;
  }
  .record dt {
    color: var(--ink-muted);
  }
  .record dd {
    margin: 0;
  }
  .ref {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
  }
  .empty {
    padding: var(--space-6) var(--space-2);
    font-size: 14px;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  @media (max-width: 560px) {
    .wallet {
      padding: 20px var(--space-4) var(--space-6);
    }
    .entry summary {
      flex-wrap: wrap;
    }
    .state {
      order: 3;
    }
    .amount {
      margin-left: auto;
    }
  }
</style>
