---
import { API_BASE_URL, APP_ENV, PUBLIC_APP_VERSION } from 'astro:env/server';
import CashbackBar from '../../../../components/CashbackBar.astro';
import FixtureNotice from '../../../../components/FixtureNotice.astro';
import ReaderLayout from '../../../../layouts/ReaderLayout.astro';
import {
  CashbackConfigurationError,
  createCashbackApi,
  type CashbackApi,
} from '../../../../lib/cashback/api';
import { formatMoney, formatSignedMoney } from '../../../../lib/cashback/money';
import { cataloguePath, walletPath, withdrawPath } from '../../../../lib/cashback/paths';
import type {
  EntryState,
  WalletEntry,
  WalletTotals,
} from '../../../../lib/cashback/types';
import { editorSession } from '../../../../lib/editorial/session';
import { frontPagePath, parseAxes } from '../../../../lib/reader/axes';
import { formatDateTime, formatItemDate } from '../../../../lib/reader/format';
import { cashbackStrings } from '../../../../i18n/cashback';

// The member's wallet and entry list — mockup 4a, composed as the mockup
// draws it and bound to the contract rather than to the drawing (T082 #229).
//
// Four differences from the mockup, each of them a fact about the money
// rather than a design preference:
//
//   1. There is a `reserved` cell. `GET /wallet` returns five totals and
//      the mockup drew three; without reserved, a member whose withdrawal
//      is awaiting approval sees a confirmed balance that dropped for no
//      visible reason. Recorded as issue #444.
//   2. The threshold is stated where a withdrawal cannot be asked for.
//      FR-050 puts a floor under a withdrawal and a member who cannot reach
//      it should learn that here, not from a 409.
//   3. No entry is card-linked. The mockup's fuel, bakery and taverna rows
//      are in-store purchases tracked by a linked card, which the
//      constitution puts out of scope and for which no evidence path
//      exists (issue #445). The first step of every entry's life is the
//      click.
//   4. A reversal is a row of its own, beside the credit it reverses, with
//      its reason. US3 scenario 2 requires both to be visible, so the
//      filter cannot hide one and there is no control that would.
//
// The "Report a problem" and "Missing a purchase?" affordances the mockup
// draws belong to the claims flow (feature 003), which is not built. The
// ghost "Share" beside them stays: it is the entry's own link, and where the
// platform can share a URL it shares that one.
const axes = parseAxes(Astro.params['lang'], Astro.params['place']);
if (axes === null) {
  return Astro.rewrite('/404');
}
const { lang, places } = axes;
const slugs = places.map((place) => place.slug);
const t = cashbackStrings(lang);

/** The filter tabs, as the mockup draws them. `undefined` is "all". */
const FILTERS: readonly { readonly key: string; readonly state: EntryState | undefined }[] = [
  { key: 'all', state: undefined },
  { key: 'pending', state: 'pending' },
  { key: 'confirmed', state: 'confirmed' },
  { key: 'paid', state: 'paid' },
];

// The filter travels in the URL rather than in client state: a filtered
// wallet is a thing a member links to and returns to, and a tab that only
// exists in memory cannot be either. The selected entry travels the same
// way, for the same reason.
const requested = Astro.url.searchParams.get('state');
const active = FILTERS.find((filter) => filter.key === requested) ?? FILTERS[0]!;
const requestedEntry = Astro.url.searchParams.get('entry');

const session = editorSession(Astro.request);

let api: CashbackApi | null = null;
let totals: WalletTotals | null = null;
let entries: readonly WalletEntry[] = [];
let allCount = 0;
let apiUnavailable = false;
let participating = true;

try {
  api = createCashbackApi(API_BASE_URL, {
    appEnv: APP_ENV,
    token: session.token,
    appVersion: PUBLIC_APP_VERSION,
  });
  const participation = await api.participation();
  participating = participation !== null && participation.status === 'active';
  if (participating) {
    [totals, entries, allCount] = await Promise.all([
      api.wallet(),
      api.entries({ state: active.state }).then((page) => page.items),
      api.entries().then((page) => page.items.length),
    ]);
  }
} catch (error) {
  // A misconfigured deployment is otherwise silent: every page answers 503
  // and nothing says why, and the operator is the only one who can fix it.
  if (error instanceof CashbackConfigurationError) {
    console.error(`cashback: ${error.message}`);
  }
  apiUnavailable = true;
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const fixtures = api?.source === 'fixture';
const homeHref = frontPagePath(lang, slugs);

/** A filter tab's URL — the page's own path plus the state it selects. */
const filterHref = (key: string): string =>
  key === 'all' ? walletPath(lang, slugs) : `${walletPath(lang, slugs)}?state=${key}`;

/** An entry row's URL — the current filter plus the entry it selects. */
const entryHref = (entry: WalletEntry): string => {
  const params = new URLSearchParams();
  if (active.key !== 'all') {
    params.set('state', active.key);
  }
  params.set('entry', entry.entry_id);
  return `${walletPath(lang, slugs)}?${params.toString()}`;
};

/** The label for a filter key, from the catalogue. */
const filterLabel = (key: string): string =>
  ({
    all: t.filterAll,
    pending: t.filterPending,
    confirmed: t.filterConfirmed,
    paid: t.filterPaid,
  })[key] ?? key;

/** Whether a withdrawal can be asked for at all, on today's figures. */
const canWithdraw =
  totals !== null && totals.confirmed.minor >= totals.payout_threshold.minor && totals.confirmed.minor > 0;

// The selected entry: the one the URL names, or the first in the list. On
// the phone the detail only opens when the URL names one — the list is the
// screen, and the entry is a screen of its own.
const explicit = entries.find((entry) => entry.entry_id === requestedEntry) ?? null;
const selected = explicit ?? entries[0] ?? null;

/** "22 Aug" — the day in a list row, in the reader's zone. */
const shortDate = (iso: string): string =>
  new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', timeZone: 'Europe/Berlin' }).format(
    new Date(iso),
  );

/** The tag class an entry's state draws with, as the mockup colours them. */
const tagClass = (state: EntryState): string =>
  ({
    pending: 'tag-outline',
    confirmed: 'tag-accent',
    paid: 'tag-neutral',
    held: 'tag-outline',
    reversed: 'tag-neutral',
    declined: 'tag-neutral',
  })[state];

/** The tag text: the state, and for a pending entry the day it should clear. */
const tagText = (entry: WalletEntry): string =>
  entry.state === 'pending' && entry.expected_confirmation_at !== null
    ? `${t.entryStates.pending} · ${shortDate(entry.expected_confirmation_at)}`
    : t.entryStates[entry.state];

const SETTLED: readonly EntryState[] = ['confirmed', 'paid'];
const VOID: readonly EntryState[] = ['reversed', 'declined'];

interface Step {
  readonly title: string;
  readonly body: string;
  readonly done: boolean;
}

/**
 * The entry's life so far, from what the entry carries: the click, the
 * dated rate (no figure — the entry does not carry one), the state it is
 * in, and the payout that follows a confirmation.
 */
const stepsFor = (entry: WalletEntry): readonly Step[] => {
  const when = formatDateTime(lang, new Date(entry.transacted_at));
  const steps: Step[] = [
    { title: `${t.tracked} · ${when}`, body: t.trackedVia, done: true },
    { title: t.rateApplied, body: t.rateSince, done: true },
  ];
  if (entry.state === 'pending') {
    steps.push({
      title:
        entry.expected_confirmation_at === null
          ? t.expectedConfirmation
          : `${t.expectedConfirmation} · ${shortDate(entry.expected_confirmation_at)}`,
      body: t.pendingExplained,
      done: false,
    });
  } else if (SETTLED.includes(entry.state)) {
    steps.push({ title: t.entryStates.confirmed, body: t.networkConfirmed, done: true });
  } else {
    steps.push({ title: t.entryStates[entry.state], body: entry.reason ?? '', done: true });
  }
  if (!VOID.includes(entry.state)) {
    steps.push({ title: t.paysOut, body: t.paysOutBatch, done: entry.state === 'paid' });
  }
  return steps;
};
---

<ReaderLayout
  lang={lang}
  title={t.wallet}
  description={t.cashback}
  homeHref={homeHref}
>
  <div class="bar">
    <CashbackBar
      lang={lang}
      slugs={slugs}
      current="wallet"
      aside={participating && !apiUnavailable ? t.verifiedPayoutsOn : undefined}
    />
  </div>

  <main class:list={['wallet', { 'entry-open': explicit !== null }]}>
    {
      fixtures && (
        <FixtureNotice title={t.cashback} body={t.fixtureNotice} />
      )
    }

    {
      apiUnavailable && (
        <p class="band" role="alert">{t.emptyQueue}</p>
      )
    }

    {
      !apiUnavailable && !session.authenticated && !fixtures && (
        <p class="band" role="alert">{t.notParticipating}</p>
      )
    }

    {
      !apiUnavailable && !participating && (
        <section class="band">
          <p>{t.notParticipating}</p>
          <a class="btn btn-primary" href={cataloguePath(lang, slugs)}>{t.catalogue}</a>
        </section>
      )
    }

    {
      totals !== null && (
        <>
          {/* Phone: the dark header block. */}
          <section class="hero" aria-label={t.wallet}>
            <div class="hero-top">
              <span class="hero-kicker">{t.cashback}</span>
              <span class="hero-status">{t.verifiedPayoutsOn}</span>
            </div>
            <p class="hero-label">{t.confirmedWithdrawable}</p>
            <p class="hero-figure">{formatMoney(lang, totals.confirmed)}</p>
            <p class="hero-pending">{t.pendingLine(formatMoney(lang, totals.pending))}</p>
            <p class="hero-more">
              {t.reserved} {formatMoney(lang, totals.reserved)} · {t.paidOut}{' '}
              {formatMoney(lang, totals.paid_out)}
            </p>
            <div class="hero-actions">
              {
                canWithdraw ? (
                  <a class="btn btn-primary" href={withdrawPath(lang, slugs)}>{t.withdraw}</a>
                ) : (
                  <span class="btn btn-primary" aria-disabled="true">{t.withdraw}</span>
                )
              }
              <a class="btn hero-browse" href={cataloguePath(lang, slugs)}>{t.browseOffers}</a>
            </div>
          </section>

          {/* Desktop: the balance strip. */}
          <section class="strip" aria-label={t.wallet}>
            <div class="cell">
              <h2>{t.confirmedWithdrawable}</h2>
              <p class="figure">{formatMoney(lang, totals.confirmed)}</p>
            </div>
            <div class="cell">
              <h2>{t.pending}</h2>
              <p class="figure muted">{formatMoney(lang, totals.pending)}</p>
            </div>
            <div class="cell">
              <h2>{t.reserved}</h2>
              <p class="figure muted">{formatMoney(lang, totals.reserved)}</p>
            </div>
            <div class="cell">
              <h2>{t.paidOut}</h2>
              <p class="figure">{formatMoney(lang, totals.paid_out)}</p>
            </div>
            <div class="cell buttons">
              {
                canWithdraw ? (
                  <a class="btn btn-primary" href={withdrawPath(lang, slugs)}>{t.withdraw}</a>
                ) : (
                  <>
                    <span class="btn btn-primary" aria-disabled="true">{t.withdraw}</span>
                    <span class="threshold">{t.belowThreshold(formatMoney(lang, totals.payout_threshold))}</span>
                  </>
                )
              }
              <a class="btn btn-secondary" href={cataloguePath(lang, slugs)}>{t.browseOffers}</a>
            </div>
          </section>

          <nav class="filters" aria-label={t.entries}>
            {
              FILTERS.map((filter) => (
                <a
                  href={filterHref(filter.key)}
                  class:list={['filter', { on: filter.key === active.key }]}
                  aria-current={filter.key === active.key ? 'true' : undefined}
                >
                  {filterLabel(filter.key)}
                </a>
              ))
            }
            <span class="count">{t.entryCount(entries.length, allCount)}</span>
          </nav>

          <div class="master">
            <section class="list" aria-label={t.entries}>
              {
                entries.length === 0 && (
                  <p class="empty">{allCount === 0 ? t.noEntries : t.noEntriesInFilter}</p>
                )
              }
              {
                entries.map((entry) => (
                  <a
                    href={entryHref(entry)}
                    class:list={[
                      'row',
                      entry.state,
                      { on: selected !== null && entry.entry_id === selected.entry_id },
                    ]}
                    aria-current={
                      selected !== null && entry.entry_id === selected.entry_id ? 'true' : undefined
                    }
                  >
                    <span class="who">
                      <span class="merchant">{entry.merchant_name}</span>
                      <span class="meta">
                        {shortDate(entry.transacted_at)} · {t.sale} {formatMoney(lang, entry.sale_amount)}
                        {entry.reversal_of_id !== null && (
                          <>
                            {' · '}
                            {t.reversalOf} <span class="ref">{entry.reversal_of_id}</span>
                          </>
                        )}
                        {entry.reason !== null && ` · ${entry.reason}`}
                      </span>
                    </span>
                    <span class:list={['tag', tagClass(entry.state), 'state']}>{tagText(entry)}</span>
                    <span class="amount">{formatSignedMoney(lang, entry.cashback_amount)}</span>
                  </a>
                ))
              }
            </section>

            <aside class:list={['detail', { explicit: explicit !== null }]} aria-label={t.selectedEntry}>
              {
                selected === null ? (
                  <p class="empty">{t.selectRow}</p>
                ) : (
                  <>
                    {/* Phone: the back bar and the big figure. */}
                    <div class="back-bar">
                      <a class="back" href={filterHref(active.key)}>← {t.backToWallet}</a>
                      <span class="back-label">{t.selectedEntry}</span>
                    </div>
                    <div class="head">
                      <p class="head-meta">
                        {selected.merchant_name} · {formatDateTime(lang, new Date(selected.transacted_at))}
                      </p>
                      <p class="head-figure">
                        {formatSignedMoney(lang, selected.cashback_amount)}
                      </p>
                      <span class:list={['tag', tagClass(selected.state), 'head-tag']}>{tagText(selected)}</span>
                    </div>

                    <div class="body">
                      {/* Desktop: the rail's own head. */}
                      <span class="card-kicker kicker">{t.selectedEntry}</span>
                      <div class="rail-title">
                        <h3>{selected.merchant_name}</h3>
                        <span class:list={['rail-amount', selected.state]}>
                          {formatSignedMoney(lang, selected.cashback_amount)}
                        </span>
                      </div>
                      <p class="rail-meta">
                        {formatDateTime(lang, new Date(selected.transacted_at))} ·{' '}
                        <span class:list={['tag', tagClass(selected.state), 'rail-tag']}>
                          {t.entryStates[selected.state]}
                        </span>
                      </p>

                      {/* Phone: the timeline. */}
                      <h2 class="life">{t.entryLife}</h2>
                      <ol class="timeline">
                        {
                          stepsFor(selected).map((step) => (
                            <li class:list={['step', { done: step.done }]}>
                              <span class="dot" aria-hidden="true"></span>
                              <div>
                                <div class="step-title">{step.title}</div>
                                {step.body !== '' && <div class="step-body">{step.body}</div>}
                              </div>
                            </li>
                          ))
                        }
                      </ol>

                      <dl class="record">
                        <div class="record-row">
                          <dt>{t.sale}</dt>
                          <dd>{formatMoney(lang, selected.sale_amount)}</dd>
                        </div>
                        <div class="record-row desk">
                          <dt>{t.tracked}</dt>
                          <dd>{formatDateTime(lang, new Date(selected.transacted_at))}</dd>
                        </div>
                        <div class="record-row">
                          <dt>{t.rateApplied}</dt>
                          <dd>{t.rateSince}</dd>
                        </div>
                        {
                          selected.state === 'pending' && (
                            <div class="record-row desk">
                              <dt>{t.expectedConfirmation}</dt>
                              <dd>
                                {selected.expected_confirmation_at === null
                                  ? t.pendingExplained
                                  : formatItemDate(lang, new Date(selected.expected_confirmation_at))}
                              </dd>
                            </div>
                          )
                        }
                        {
                          SETTLED.includes(selected.state) && (
                            <>
                              <div class="record-row desk">
                                <dt>{t.entryStates.confirmed}</dt>
                                <dd>{t.networkConfirmed}</dd>
                              </div>
                              <div class="record-row desk">
                                <dt>{t.paysOut}</dt>
                                <dd>{selected.state === 'paid' ? t.entryStates.paid : t.paysOutBatch}</dd>
                              </div>
                            </>
                          )
                        }
                        {
                          selected.reversal_of_id !== null && (
                            <div class="record-row">
                              <dt>{t.reversalOf}</dt>
                              <dd class="ref">{selected.reversal_of_id}</dd>
                            </div>
                          )
                        }
                        {
                          selected.reason !== null && (
                            <div class="record-row desk">
                              <dt>{t.reversalReason}</dt>
                              <dd>{selected.reason}</dd>
                            </div>
                          )
                        }
                        <div class="record-row">
                          <dt>{t.reference}</dt>
                          <dd class="ref">{selected.entry_id}</dd>
                        </div>
                      </dl>

                      <p class="note">{t.rateAtClick}</p>
                      <div class="actions">
                        <a class="btn btn-ghost share" href={entryHref(selected)} data-share>
                          {t.openEntry}
                        </a>
                      </div>
                    </div>
                  </>
                )
              }
            </aside>
          </div>
        </>
      )
    }
  </main>
</ReaderLayout>

<script>
  // The ghost button is the entry's own link. Where the platform can share
  // a URL, sharing it beats reloading the page the member is already on.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-share]')) {
    link.addEventListener('click', (event) => {
      if (typeof navigator.share !== 'function') {
        return;
      }
      event.preventDefault();
      void navigator.share({ url: link.href }).catch(() => undefined);
    });
  }
</script>

<style>
  .wallet {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0 0 28px;
  }
  .band {
    border: 2px solid var(--color-divider);
    background: var(--color-surface);
    padding: 20px;
    margin: 20px 28px;
    font-size: 14px;
  }

  /* — phone header block (hidden on desktop) — */
  .hero {
    display: none;
    padding: 14px 18px 18px;
    background: var(--color-text);
    color: var(--color-bg);
  }
  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .hero-kicker {
    font: 600 11px var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .hero-status {
    font-size: 11px;
    opacity: 0.7;
  }
  .hero-label {
    margin: 0 0 4px;
    font: 400 12px/1.55 var(--font-body);
    letter-spacing: 0;
    opacity: 0.7;
  }
  .hero-figure {
    margin: 0 0 6px;
    font: var(--font-heading-weight) 44px/1 var(--font-heading);
  }
  .hero-pending {
    margin: 0 0 6px;
    font-size: 12.5px;
    opacity: 0.75;
    text-wrap: pretty;
  }
  .hero-more {
    margin: 0 0 16px;
    font-size: 12px;
    opacity: 0.7;
  }
  .hero-actions {
    display: flex;
    gap: 8px;
  }
  .hero-actions .btn {
    font-size: 13px;
    padding: 10px 14px;
  }
  .hero-browse {
    border-color: color-mix(in srgb, var(--color-bg) 40%, transparent);
    color: var(--color-bg);
  }
  .btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* — desktop balance strip — */
  .strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-bottom: 2px solid var(--color-divider);
  }
  .cell {
    padding: 20px 24px;
    border-right: 1px solid var(--color-divider);
  }
  .cell:last-child {
    border-right: 0;
  }
  .cell h2 {
    margin: 0 0 8px;
    font: var(--font-heading-weight) 13px/1.12 var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .figure {
    margin: 0;
    font: var(--font-heading-weight) 28px/1 var(--font-heading);
  }
  .figure.muted {
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
  }
  .buttons .btn {
    font-size: 13px;
  }
  .threshold {
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    text-wrap: pretty;
  }

  /* — filter bar — */
  .filters {
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--color-divider);
  }
  .filter {
    border-right: 1px solid var(--color-divider);
    padding: 11px 22px;
    text-align: left;
    background: transparent;
    color: var(--color-text);
    font: 600 12.5px var(--font-heading);
    text-decoration: none;
  }
  .filter.on {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .count {
    margin-left: auto;
    padding: 0 22px;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  /* — master-detail — */
  .master {
    display: grid;
    grid-template-columns: 1fr 380px;
    flex: 1;
  }
  .list {
    border-right: 1px solid var(--color-divider);
  }
  .row {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 22px;
    border-bottom: 1px solid var(--color-divider);
    color: var(--color-text);
    text-decoration: none;
  }
  .row.on {
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-100);
  }
  .row.declined,
  .row.reversed {
    opacity: 0.55;
  }
  .who {
    flex: 1;
    min-width: 0;
  }
  .merchant {
    display: block;
    font-size: 14px;
    font-weight: 600;
  }
  .meta {
    display: block;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }
  .state {
    font-size: 10px;
    white-space: nowrap;
  }
  .amount {
    font: var(--font-heading-weight) 15px var(--font-heading);
    width: 70px;
    text-align: right;
    white-space: nowrap;
  }
  .row.confirmed .amount {
    color: var(--color-accent-700);
  }
  .ref {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11px;
    white-space: nowrap;
  }
  .empty {
    padding: 20px 22px;
    font-size: 12px;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    text-wrap: pretty;
  }

  /* — the right rail — */
  .detail {
    background: var(--color-surface);
  }
  .back-bar,
  .head,
  .life,
  .timeline {
    display: none;
  }
  .body {
    padding: 20px 24px;
  }
  .kicker {
    font-size: 10.5px;
  }
  .rail-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin: 10px 0 4px;
  }
  .rail-title h3 {
    margin: 0;
    font-size: 22px;
  }
  .rail-amount {
    font: var(--font-heading-weight) 22px var(--font-heading);
    white-space: nowrap;
  }
