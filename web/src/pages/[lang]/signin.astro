---
import { APP_ENV, BRAND_DIR } from 'astro:env/server';

import Masthead from '../../components/Masthead.astro';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { brandOnHand } from '../../lib/brand/load';
import { isSameOrigin } from '../../lib/csrf';
import { sessionOf } from '../../lib/editorial/session';
import { authClient, authConfigured } from '../../lib/editorial/supabase';
import { confirmUrl, isAccessOutcome, safeReturnPath, signInPath } from '../../lib/member/access';
import { memberStrings } from '../../lib/member/strings';
import { frontPagePath, isReadingLanguage } from '../../lib/reader/axes';
import { uiStrings } from '../../lib/reader/strings';

// Member sign-in (issues #529, #564) — the screen the design board draws,
// with one of its two paths now wired.
//
// THE EMAIL PATH WORKS. `signInWithOtp` sends a link; opening it lands on
// /auth/confirm, which exchanges it for the same @supabase/ssr cookie session
// the editorial sign-in produces. A first link creates the account, so
// signing up and signing in are the same act and there is no second screen.
//
// THE SHELL PATH DOES NOT, and its button is still genuinely `disabled` — the
// native attribute, which reaches assistive technology, not a class that
// merely looks the part. The panel beside both paths now speaks for that one
// alone: standing next to a form that works and saying neither path does
// would be the same dishonesty it was written to prevent, pointing the other
// way.
//
// What this page must still NOT do:
//
//   * No password field, and therefore no reset. The board draws none and the
//     shell note rules one out in as many words. No password is the whole
//     reason this product owns no reset screen, no strength meter and no
//     breach response for stored credentials.
//   * No prose about a mechanism that is not wired. The shell copy says it is
//     not connected; it does not describe how it will feel when it is.
//
// The POST renders rather than redirecting, deliberately. Post/redirect/get
// would cost the address the member typed, and "a link is on its way to <the
// address you typed>" is the sentence somebody who mistyped it needs to read.
// The form stays on the page under that sentence so they can correct it.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = uiStrings(lang);
const m = memberStrings(lang);
const { brand } = brandOnHand({ brandDir: BRAND_DIR, appEnv: APP_ENV });

// Under the READER'S language: DEFAULT_FRONT_PAGE is hard-coded to Greek and
// would flip a German reader's language axis (FR-009).
const home = frontPagePath(lang, ['munich', 'greece']);
// Empty rather than the front page when nobody said where they came from.
// A default here would be carried by the language switcher and by the form
// action, so a Greek reader switching to German would be handed a return
// path pointing at the Greek front page — a language axis moved by chrome
// the reader did not touch (FR-009). The fallback belongs at the one place
// that actually sends somebody somewhere.
const next = safeReturnPath(Astro.url.searchParams.get('next'), '');
const onward = next === '' ? home : next;
const configured = authConfigured();

// Outcomes that arrived by redirect — from /auth/confirm, which renders
// nothing and has no language of its own.
const arrived = Astro.url.searchParams.get('outcome');
let outcome = isAccessOutcome(arrived) ? arrived : null;
let sentTo: string | null = null;

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request, Astro.url.origin)) {
    return new Response('cross-origin sign-in refused', { status: 403 });
  }
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const client = authClient(Astro.request, Astro.cookies);
  if (client === null) {
    outcome = 'unconfigured';
  } else if (email === '') {
    outcome = 'refused';
  } else {
    // shouldCreateUser: a first link is how somebody becomes a member. The
    // alternative refuses an unknown address, which would make this a
    // sign-IN screen needing a sign-UP screen beside it, and the board draws
    // one screen on purpose.
    const { error } = await client.auth.signInWithOtp({
      email,
      options: {
        emailRedirectTo: confirmUrl(Astro.url.origin, lang, onward),
        shouldCreateUser: true,
      },
    });
    // One message for every refusal, as the editorial sign-in does: which
    // addresses are already known is not a question this page answers, and
    // the provider's own rate limit is not a reason to describe an account.
    outcome = error === null ? 'sent' : 'refused';
    sentTo = error === null ? email : null;
  }
}

// Somebody already signed in has no business on this page. Read after the
// POST branch so a sign-in completes and sends them onward in one request.
const session = sessionOf(Astro.request);
if (session.authenticated && Astro.request.method !== 'POST') {
  return Astro.redirect(onward);
}

const canSend = configured && outcome !== 'unconfigured';
// One sentence per outcome, chosen here so the template carries no logic.
// `sent` has no alert: it is a status, not a refusal, and has its own panel.
const ALERTS: Readonly<Record<string, string>> = {
  expired: m.linkExpired,
  refused: m.sendRefused,
  taken: m.addressTaken,
  unmade: m.accountNotMade,
  unconfigured: m.notConfigured,
};
const alert = outcome !== null ? (ALERTS[outcome] ?? null) : canSend ? null : m.notConfigured;
---

<ReaderLayout lang={lang} title={`${brand.name} — ${t.signIn}`} description={m.intro} homeHref={home}>
  <Masthead homeHref={home}>
    <div class="seg" role="group">
      {
        lang === 'el' ? (
          <span class="seg-opt" aria-current="true" lang="el">
            Ελληνικά
          </span>
        ) : (
          <a class="seg-opt" href={signInPath('el', { next })} lang="el">
            Ελληνικά
          </a>
        )
      }
      {
        lang === 'de' ? (
          <span class="seg-opt" aria-current="true" lang="de">
            Deutsch
          </span>
        ) : (
          <a class="seg-opt" href={signInPath('de', { next })} lang="de">
            Deutsch
          </a>
        )
      }
    </div>
  </Masthead>

  <main class="page">
    <header class="head">
      <h1>{t.signIn}</h1>
      <p>{m.intro}</p>
    </header>

    <div class="split">
      <section class="panel">
        {/* The shell path. Still disabled, still saying why. */}
        <button class="btn btn-primary btn-block" type="button" disabled>
          {m.continueWithApp}
        </button>
        <p class="fine">{m.tokenExchangeNote}</p>

        <div class="or" aria-hidden="true"><i></i>{m.orWord}<i></i></div>

        {alert !== null && <p class="alert" role="alert">{alert}</p>}

        {
          outcome === 'sent' && sentTo !== null && (
            <div class="sent" role="status">
              <p class="sent-line">{m.linkSent(sentTo)}</p>
              <p class="fine">{m.linkSentNote}</p>
            </div>
          )
        }

        {/* The email path: a real form, posting to itself, carrying the
            return path so finishing lands where the member started. */}
        <form method="post" action={signInPath(lang, { next })}>
          <div class="field">
            <label for="member-email">{t.emailLabel}</label>
            <input
              class="input"
              id="member-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              disabled={!canSend}
            />
          </div>
          <button class="btn btn-secondary btn-block" type="submit" disabled={!canSend}>
            {m.sendLink}
          </button>
        </form>
        <p class="fine">{m.emailPathNote}</p>
      </section>

      {/* Beside the path that is still owed, and no longer speaking for the
          one next to it. */}
      <aside class="owed">
        {/* A heading, not a bold span: it is the landmark by which this
            statement is reachable. */}
        <h2>{m.notWorkingTitle}</h2>
        <p>{m.notWorkingBody}</p>
      </aside>
    </div>
  </main>
</ReaderLayout>

<style>
  .page {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1)) var(--space-8);
  }

  .head {
    padding-bottom: var(--space-6);
    border-bottom: 2px solid var(--color-text);
  }

  .head h1 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .head p {
    margin: 0;
    max-width: 52ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* The board draws a 390px phone. Left alone on a desktop that is a narrow
     column with the page empty beside it, so the panel keeps its readable
     measure and the statement of what is owed moves alongside — the same
     treatment the legal notices get on their own routes. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 46ch) minmax(0, 34ch);
    gap: var(--space-8);
    align-items: start;
    padding-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .panel {
    max-width: 46ch;
  }

  .fine {
    margin: var(--space-2) 0 0;
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .or {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-6) 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .or i {
    flex: 1;
    height: 1px;
    background: var(--color-divider);
  }

  /* A refusal and a confirmation are the same shape — a ruled block the eye
     lands on before the form — and differ only in the colour of the rule,
     so neither can be mistaken for page furniture. */
  .alert,
  .sent {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--color-accent-700);
    background: var(--color-accent-100);
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-accent-800);
    text-wrap: pretty;
  }

  .sent {
    border-left-color: var(--color-text);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .sent-line {
    margin: 0;
    font-weight: 600;
  }

  .sent .fine {
    color: var(--ink-muted);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .field label {
    font-size: 13px;
    color: var(--ink-muted);
  }

  .owed {
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-100);
    border-left: 2px solid var(--color-accent-700);
  }

  .owed h2 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-800);
  }

  .owed p {
    margin: 0 0 var(--space-2);
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--color-accent-800);
    text-wrap: pretty;
  }

  .owed p:last-child {
    margin-bottom: 0;
  }

  .seg {
    margin-left: auto;
  }

  .seg-opt {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    font-size: 13px;
    color: var(--color-text);
    text-decoration: none;
  }

  .seg-opt[aria-current='true'] {
    background: var(--color-accent-700);
    color: var(--color-bg);
  }

  a.seg-opt:hover,
  a.seg-opt:focus-visible {
    background: color-mix(in srgb, var(--color-text) 7%, transparent);
  }
</style>
