---
import ConsentPanel from '../../components/ConsentPanel.astro';
import Masthead from '../../components/Masthead.astro';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import ProductTour from '../../components/ProductTour.astro';
import {
  CONSENT_PURPOSES,
  createAccountApi,
  type ConsentOutcome,
  type ConsentPurpose,
  type ConsentRecord,
} from '../../lib/account/consent';
import { signInPath } from '../../lib/member/access';
import { DEFAULT_FRONT_PAGE, isReadingLanguage, PLACE_CATALOG } from '../../lib/reader/axes';
import { uiStrings } from '../../lib/reader/strings';

// Registration and consent — mockup 1j (issue #73, toward T031 #34).
//
// US6 puts registration first on the cut list while the account and
// consent capability ships in the schema regardless, so this screen is
// deliberately plain. Its load-bearing half is the consent panel: FR-011
// requires one dated record per purpose with grant/revoke history and
// never a boolean flag, and the screen shows that literally — the history
// lists more records than there are switches.
//
// The account form renders but cannot submit. Sign-up runs through
// Supabase Auth (D7), which is not wired, so rather than posting a
// password to a handler that would discard it, the form states what is
// missing and transmits nothing.
const langSegment = Astro.params['lang'];
if (langSegment === undefined || !isReadingLanguage(langSegment)) {
  return Astro.rewrite('/404');
}
const lang = langSegment;
const t = uiStrings(lang);
const api = createAccountApi();

let outcome: ConsentOutcome | null = null;
let wasGrant = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const purpose = String(form.get('purpose') ?? '');
  const granted = String(form.get('granted') ?? '') === 'true';
  wasGrant = granted;
  if ((CONSENT_PURPOSES as readonly string[]).includes(purpose)) {
    // Once the consent endpoints exist this call crosses the network; a
    // failure must degrade, not take the page down mid-render.
    try {
      outcome = await api.setConsent(purpose as ConsentPurpose, granted);
    } catch (error) {
      outcome = {
        recorded: false,
        reason: error instanceof Error ? error.message : String(error),
      };
    }
  }
}

let history: readonly ConsentRecord[] = [];
let historyFailed = false;
try {
  history = await api.consentHistory();
} catch {
  historyFailed = true;
  Astro.response.status = 503;
}
const followed = PLACE_CATALOG.filter((place) => place.selectable);
const here = `/${lang}/register`;
---

<ReaderLayout lang={lang} title={`epiloYES — ${t.createAccount}`} description={t.tagline}>
  <Masthead homeHref={DEFAULT_FRONT_PAGE} />

  <div class="tour-slot"><ProductTour lang={lang} tour="reader" /></div>
  <main class="page">
    <header class="head">
      <h2>{t.createAccount}</h2>
      <p>{t.accountSubtitle}</p>
    </header>

    {
      outcome !== null && (
        <div class:list={['banner', { 'banner-ok': outcome.recorded }]}>
          <span class="banner-label">
            {outcome.recorded ? t.consentRecorded : t.notRecorded}
          </span>
          {/* The banner reports what actually happened. Denying a record
              that was written is the same lie as claiming one that was
              not, in the other direction. */}
          <span class="banner-body">
            {outcome.recorded
              ? wasGrant
                ? t.consentGrantedNow
                : t.consentRevokedNow
              : outcome.reason}
          </span>
        </div>
      )
    }

    <div class="split">
      <section class="account">
        {/* Three disabled fields and a "registration is not wired" sentence
            stood here until #564. The account is made by the sign-in link
            now, so the fields would be asking for what nothing reads — and
            one of them was a password, which this product has decided never
            to have. */}
        <a class="btn btn-primary btn-block" href={signInPath(lang)}>{t.signIn}</a>
        <p class="pending">{t.registrationBySignIn}</p>

        <h6>{t.placesToFollow}</h6>
        <div class="places">
          {followed.map((place) => (
            <span class="tag tag-accent" lang={place.endonymLang}>{place.endonym}</span>
          ))}
          <a class="btn btn-ghost" href={`/${lang}/setup`}>{t.editPlaces}</a>
        </div>
        <p class="note">{t.followNote}</p>

      </section>

      <section class="consent">
        <h6>{t.consentHeading}</h6>
        <ConsentPanel
          lang={lang}
          history={history}
          historyFailed={historyFailed}
          action={here}
          tourAnchor="register-consent"
        />
      </section>
    </div>
  </main>
</ReaderLayout>

<style>
  .tour-slot {
    display: flex;
    justify-content: flex-end;
    padding-inline: clamp(16px, 3vw, 56px);
  }
  .tour-slot:has(button[hidden]) {
    display: none;
  }

  .page {
    flex: 1;
  }
  .head {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    border-bottom: 2px solid var(--color-divider);
  }
  .head h2 {
    font-size: 30px;
    margin: 0 0 var(--space-2);
  }
  .head p {
    margin: 0;
    font-size: 14px;
    max-width: 56ch;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .banner {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3) calc(var(--space-6) + var(--space-1));
    background: var(--color-text);
    color: var(--color-bg);
  }
  .banner-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-400);
    flex: none;
  }
  .banner-ok {
    background: var(--color-accent-700);
  }
  .banner-ok .banner-label {
    color: var(--color-bg);
  }
  .banner-body {
    font-size: 13px;
    max-width: 80ch;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .account {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    border-right: 1px solid var(--color-divider);
  }
  .account .field {
    margin-bottom: var(--space-3);
  }
  .account h6 {
    margin: var(--space-4) 0 var(--space-2);
  }
  .places {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .places .tag {
    font-size: 11.5px;
  }
  .note {
    margin: 0 0 var(--space-4);
    font-size: 11.5px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .pending {
    margin: var(--space-3) 0 0;
    font-size: 11.5px;
    color: var(--color-accent-800);
    background: var(--color-accent-100);
    border-left: 2px solid var(--color-accent);
    padding: var(--space-2) var(--space-3);
    text-wrap: pretty;
  }

  .consent {
    padding: var(--space-6) calc(var(--space-6) + var(--space-1));
    background: var(--color-surface);
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
    .account {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
  }
</style>
