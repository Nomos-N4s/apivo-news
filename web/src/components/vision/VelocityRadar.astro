<script>
  // Dynamic Horizon Scope Switcher
  interface ScopeMetrics {
    commits: string;
    commitsSub: string;
    prs: string;
    prsSub: string;
    loc: string;
    locSub: string;
    tests: string;
    testsSub: string;
    coverage: string;
    coverageSub: string;
    gates: string;
    gatesSub: string;
    velocitySub: string;
    qualitySub: string;
  }

  const scopeData: Record<string, ScopeMetrics> = {
    all: {
      commits: '1,575+',
      commitsSub: 'Continuous trunk iterations',
      prs: '648',
      prsSub: 'Strict branch review & squash',
      loc: '245,062',
      locSub: 'Lines of code (1,120 files)',
      tests: '364',
      testsSub: 'Unit, integration & property tests',
      coverage: '90.0%',
      coverageSub: 'Enforced on all Go modules',
      gates: '20 / 20',
      gatesSub: 'All GitHub checks 100% green',
      velocitySub: 'Throughput across 6 architectural release milestones',
      qualitySub: 'Evolution from early baseline to 364 dedicated test suites'
    },
    quarter: {
      commits: '482',
      commitsSub: 'Delivered in H2 sprint cycles',
      prs: '168',
      prsSub: 'Trunk PRs merged with 0 regressions',
      loc: '+42,390',
      locSub: 'Net additions (Cashback & Security)',
      tests: '128 New',
      testsSub: 'Coverage expanded across 4 domains',
      coverage: '92.4%',
      coverageSub: 'Exceeds strict 90% gate',
      gates: '20 / 20',
      gatesSub: 'Zero broken builds in main',
      velocitySub: 'H2 Focus: Double-entry ledger, clickouts & security context',
      qualitySub: 'Accelerated test expansion for financial transaction safety'
    },
    sprint: {
      commits: '68',
      commitsSub: 'Active sprint iterations',
      prs: '24',
      prsSub: 'Peer-reviewed PRs this cycle',
      loc: '+6,420',
      locSub: 'Test hardening & vision board',
      tests: '42 Hardened',
      testsSub: 'Account context & middleware tests',
      coverage: '94.1%',
      coverageSub: 'Hardened module coverage',
      gates: '20 / 20',
      gatesSub: 'All 20 CI jobs green on PR 648',
      velocitySub: 'Current Focus: Platform test hardening & co-founder vision',
      qualitySub: 'Compulsory human gate and immutable audit verification'
    }
  };

  const horizonBtns = document.querySelectorAll<HTMLButtonElement>('.horizon-btn');
  const valKpiCommits = document.getElementById('val-kpi-commits');
  const subKpiCommits = document.getElementById('sub-kpi-commits');
  const valKpiPrs = document.getElementById('val-kpi-prs');
  const subKpiPrs = document.getElementById('sub-kpi-prs');
  const valKpiLoc = document.getElementById('val-kpi-loc');
  const subKpiLoc = document.getElementById('sub-kpi-loc');
  const valKpiTests = document.getElementById('val-kpi-tests');
  const subKpiTests = document.getElementById('sub-kpi-tests');
  const valKpiCoverage = document.getElementById('val-kpi-coverage');
  const subKpiCoverage = document.getElementById('sub-kpi-coverage');
  const valKpiGates = document.getElementById('val-kpi-gates');
  const subKpiGates = document.getElementById('sub-kpi-gates');
  const chartVelocitySub = document.getElementById('chart-velocity-sub');
  const chartQualitySub = document.getElementById('chart-quality-sub');

  horizonBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      horizonBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const scope = btn.getAttribute('data-scope') || 'all';
      const data = scopeData[scope];
      if (!data) return;

      if (valKpiCommits) valKpiCommits.textContent = data.commits;
      if (subKpiCommits) subKpiCommits.textContent = data.commitsSub;
      if (valKpiPrs) valKpiPrs.textContent = data.prs;
      if (subKpiPrs) subKpiPrs.textContent = data.prsSub;
      if (valKpiLoc) valKpiLoc.textContent = data.loc;
      if (subKpiLoc) subKpiLoc.textContent = data.locSub;
      if (valKpiTests) valKpiTests.textContent = data.tests;
      if (subKpiTests) subKpiTests.textContent = data.testsSub;
      if (valKpiCoverage) valKpiCoverage.textContent = data.coverage;
      if (subKpiCoverage) subKpiCoverage.textContent = data.coverageSub;
      if (valKpiGates) valKpiGates.textContent = data.gates;
      if (subKpiGates) subKpiGates.textContent = data.gatesSub;
      if (chartVelocitySub) chartVelocitySub.textContent = data.velocitySub;
      if (chartQualitySub) chartQualitySub.textContent = data.qualitySub;
    });
  });

  // Real-time GitHub Telemetry Hydration
  const btnSyncTelemetry = document.getElementById('btn-sync-telemetry');
  const telemetrySyncTime = document.getElementById('telemetry-sync-time');
  const syncIcon = document.getElementById('sync-icon');

  async function syncRealtimeMetrics(showVisualIndicator = false) {
    if (!telemetrySyncTime) return;
    if (showVisualIndicator && syncIcon) {
      syncIcon.style.display = 'inline-block';
      syncIcon.style.transition = 'transform 0.8s ease';
      syncIcon.style.transform = 'rotate(360deg)';
      telemetrySyncTime.textContent = 'Querying live GitHub API...';
    }

    try {
      const res = await fetch('/api/metrics.json');
      if (!res.ok) throw new Error('Telemetry endpoint returned ' + res.status);
      const data = await res.json();

      if (data?.repo?.latestPrNumber && valKpiPrs) {
        valKpiPrs.textContent = String(data.repo.latestPrNumber);
      }

      if (data?.ci?.gatesPassed && valKpiGates) {
        valKpiGates.textContent = data.ci.gatesPassed;
      }

      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      telemetrySyncTime.textContent = 'Live GitHub API: ' + timeStr + (data?.meta?.isLive ? ' (Realtime)' : ' (Cached)');

      if (data?.languages?.breakdown) {
        const b = data.languages.breakdown;
        if (b['Go']) {
          const goSeg = document.querySelector<SVGCircleElement>('.donut-segment[data-lang*="Go"]');
          if (goSeg) goSeg.setAttribute('data-loc', b['Go'].bytes.toLocaleString() + ' bytes (' + b['Go'].percentage + '%)');
        }
      }

      if (Array.isArray(data?.recentCommits) && data.recentCommits.length > 0) {
        const streamList = document.getElementById('activity-stream-list');
        if (streamList) {
          const itemsHtml = data.recentCommits.map((c: any) => `
            <div class="stream-item" data-stream-type="${c.type}">
              <div class="stream-item-top">
                <span class="stream-item-badge ${c.badgeClass}">${c.badge}</span>
                <span class="stream-hash">${c.sha} • ${c.author}</span>
              </div>
              <div class="stream-subject">${c.message}</div>
              <div class="stream-desc">Live commit from GitHub • ${new Date(c.date).toLocaleDateString()}</div>
            </div>
          `).join('');
          streamList.innerHTML = itemsHtml;
        }
      }
    } catch (err) {
      console.warn('Realtime telemetry fallback:', err);
      telemetrySyncTime.textContent = 'Local Telemetry Active (Node Node)';
    } finally {
      if (showVisualIndicator && syncIcon) {
        setTimeout(() => {
          syncIcon.style.transform = 'rotate(0deg)';
        }, 800);
      }
    }
  }

  syncRealtimeMetrics(false);

  btnSyncTelemetry?.addEventListener('click', () => {
    syncRealtimeMetrics(true);
  });

  // SVG Chart Tooltips
  function setupChartTooltips(containerId: string, tooltipId: string) {
    const container = document.getElementById(containerId);
    const tooltip = document.getElementById(tooltipId);
    if (!container || !tooltip) return;

    const targets = container.querySelectorAll<SVGCircleElement>('.chart-dot-target');
    targets.forEach((dot) => {
      dot.addEventListener('mouseenter', () => {
        const info = dot.getAttribute('data-info');
        if (!info) return;
        tooltip.innerHTML = info;
        tooltip.classList.add('visible');

        const rect = container.getBoundingClientRect();
        const dotRect = dot.getBoundingClientRect();
        const left = dotRect.left - rect.left + dotRect.width / 2;
        const top = dotRect.top - rect.top;
        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';
      });

      dot.addEventListener('mouseleave', () => {
        tooltip.classList.remove('visible');
      });
    });
  }

  setupChartTooltips('container-chart-1', 'tooltip-chart-1');
  setupChartTooltips('container-chart-2', 'tooltip-chart-2');

  // SVG Donut Hover Interactions
  const donutSegments = document.querySelectorAll<SVGCircleElement>('.donut-segment');
  const donutCenterVal = document.getElementById('donut-center-val');
  const donutCenterSub = document.getElementById('donut-center-sub');

  donutSegments.forEach((seg) => {
    seg.addEventListener('mouseenter', () => {
      const lang = seg.getAttribute('data-lang');
      const loc = seg.getAttribute('data-loc');
      if (donutCenterVal && lang) donutCenterVal.textContent = lang.split(' ')[0] ?? '';
      if (donutCenterSub && loc) donutCenterSub.textContent = loc;
    });

    seg.addEventListener('mouseleave', () => {
      if (donutCenterVal) donutCenterVal.textContent = '245K';
      if (donutCenterSub) donutCenterSub.textContent = 'Total LoC';
    });
  });

  // Stream Filtering
  const streamFilterBtns = document.querySelectorAll<HTMLButtonElement>('.stream-filter-btn');
  const streamItems = document.querySelectorAll<HTMLElement>('.stream-item');

  streamFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      streamFilterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      streamItems.forEach((item) => {
        const itemType = item.getAttribute('data-stream-type');
        if (filter === 'all' || filter === itemType) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
