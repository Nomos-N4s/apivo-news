---
// ExecutiveDomains: Dual-domain strategic comparison (News & Cashback), steppers, and founder milestones
---

<div class="executive-module-container">
  <!-- Domain Navigation Filter -->
  <nav class="tabs-bar" role="tablist">
    <button class="tab-btn active" data-target="all" role="tab" id="tab-all">
      <span>🌐</span> Unified Ecosystem
    </button>
    <button class="tab-btn" data-target="news" role="tab" id="tab-news">
      <span>📰</span> Domain 1: News Platform
    </button>
    <button class="tab-btn" data-target="cashback" role="tab" id="tab-cashback">
      <span>💳</span> Domain 2: Cashback &amp; Commerce
    </button>
  </nav>

  <!-- 2-Column Domain Grid -->
  <div class="domain-grid">
    <!-- DOMAIN 1: NEWS -->
    <section class="domain-column" data-domain="news">
      <div class="domain-header news">
        <h2 class="domain-title">
          <span class="news-accent-icon">📰</span>
          News &amp; Editorial Engine
        </h2>
        <span class="domain-tag news">News Domain</span>
      </div>

      <!-- Feature 1: Dual-Axis Architecture -->
      <article class="feature-box">
        <div class="feature-title">
          <span>🎯</span>
          Independent Language &amp; Place Axes
        </div>
        <p class="feature-desc">
          Readers select their language (e.g. Greek /el or German /de) independently of their geography (e.g. Munich or Athens). A Greek reader living in Munich gets German-focused local diaspora news translated into natural Greek.
        </p>
        <div class="code-pill">
          /el/munich+greece &mdash; Greek language, Munich + Greece composite place
        </div>
      </article>

      <!-- Feature 2: Legal Invariants -->
      <article class="feature-box">
        <div class="feature-title">
          <span>⚖️</span>
          Zero-Copyright-Liability Architecture
        </div>
        <p class="feature-desc">
          Platform never crawls unpermitted full text. Ingests strictly licensed publisher RSS/Atom feeds, preserves immutable body snapshots, and enforces a mandatory human editor approval gate before publication.
        </p>
        <div class="invariants-list">
          <div class="inv-item">
            <span class="inv-badge green">I-1 Gate</span>
            <span class="inv-text">Compulsory named human signoff before any article goes live</span>
          </div>
          <div class="inv-item">
            <span class="inv-badge green">I-2 / I-3</span>
            <span class="inv-text">Immutable source snapshot; zero data overwrite in Postgres</span>
          </div>
          <div class="inv-item">
            <span class="inv-badge amber">I-4 Law</span>
            <span class="inv-text">Bounded text extract (&lt; 280 characters) to honor copyright fair-use</span>
          </div>
        </div>
      </article>

      <!-- Feature 3: Monetization -->
      <article class="feature-box">
        <div class="feature-title">
          <span>💶</span>
          Audience &amp; Revenue Synergy
        </div>
        <p class="feature-desc">
          High-frequency diaspora engagement. News serves as the high-trust top-of-funnel daily touchpoint that funnels community readers naturally into local diaspora merchant offers.
        </p>
      </article>
    </section>

    <!-- DOMAIN 2: CASHBACK -->
    <section class="domain-column" data-domain="cashback">
      <div class="domain-header cashback">
        <h2 class="domain-title">
          <span class="cashback-accent-icon">💳</span>
          Cashback &amp; Commerce Platform
        </h2>
        <span class="domain-tag cashback">Cashback Domain</span>
      </div>

      <!-- Feature 1: The Model -->
      <article class="feature-box">
        <div class="feature-title">
          <span>🔄</span>
          The Closed-Loop Community Economy
        </div>
        <p class="feature-desc">
          Diaspora members shop at participating Greek retailers, travel services, and regional specialty markets in Germany and Greece. Affiliate commission is split transparently: <strong>70% returned to member</strong>, <strong>30% retained as platform margin</strong>.
        </p>
        <div class="split-bar-wrap">
          <div class="split-segment member">70% Member Payout</div>
          <div class="split-segment platform">30% Apivo Platform</div>
        </div>
      </article>

      <!-- Feature 2: Financial Invariants -->
      <article class="feature-box">
        <div class="feature-title">
          <span>🏛️</span>
          Blnk Double-Entry Financial Invariants
        </div>
        <p class="feature-desc">
          All financial movements recorded in Blnk double-entry ledger. Zero balance ambiguity. Member earnings move through strictly guarded lifecycle states: Pending hold (return window), Confirmed, and Paid out.
        </p>
        <div class="invariants-list">
          <div class="inv-item">
            <span class="inv-badge green">C-1 Ledger</span>
            <span class="inv-text">Zero-sum balance equation verified across all member accounts</span>
          </div>
          <div class="inv-item">
            <span class="inv-badge green">C-2 Return</span>
            <span class="inv-text">Automatic 30-day merchant return window hold before payout release</span>
          </div>
          <div class="inv-item">
            <span class="inv-badge amber">C-4 &amp; C-5</span>
            <span class="inv-text">Dual-operator signoff on manual SEPA bank wire payouts</span>
          </div>
        </div>
      </article>

      <!-- Feature 3: Operational Reality -->
      <article class="feature-box">
        <div class="feature-title">
          <span>⚡</span>
          Signed Clickout Engine (HMAC Anti-Tamper)
        </div>
        <p class="feature-desc">
          Members click out to merchants via signed HMAC URLs. Prevents referral hijacking and guarantees accurate attribution back to member balance upon network conversion callback.
        </p>
      </article>
    </section>
  </div>

  <!-- Interactive Steppers -->
  <section class="stepper-section">
    <div class="domain-header">
      <h2 class="domain-title">
        <span>⚙️</span> Interactive Architecture Walkthroughs
      </h2>
      <div class="env-badge">Step-by-step Execution Engine</div>
    </div>

    <div class="steppers-grid">
      <!-- Stepper 1: News Editorial Lifecycle -->
      <div class="stepper-card" id="news-stepper">
        <div class="stepper-title">
          <span class="news-accent-icon">📰</span>
          News Lifecycle: From Licensed Feed to Reader
        </div>
        <div class="steps-container">
          <div class="step active" data-step="1">
            <div class="step-num">1</div>
            <div class="step-body">
              <div class="step-label">Feed Ingestion</div>
              <div class="step-desc">Go poller fetches licensed RSS/Atom feeds respecting robots.txt crawl delays.</div>
            </div>
          </div>
          <div class="step" data-step="2">
            <div class="step-num">2</div>
            <div class="step-body">
              <div class="step-label">Immutable Snapshot (I-2)</div>
              <div class="step-desc">Raw content snapshotted in Postgres. Database triggers forbid UPDATE or DELETE.</div>
            </div>
          </div>
          <div class="step" data-step="3">
            <div class="step-num">3</div>
            <div class="step-body">
              <div class="step-label">Model-Agnostic LLM Translation</div>
              <div class="step-desc">Cloudflare Workers AI / Ollama translates headline and excerpt between Greek and German.</div>
            </div>
          </div>
          <div class="step" data-step="4">
            <div class="step-num">4</div>
            <div class="step-body">
              <div class="step-label">Named Human Approval Gate (I-1)</div>
              <div class="step-desc">Compulsory editorial gate: Staff editor must approve before publish. Zero unreviewed AI copy.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stepper 2: Cashback Lifecycle -->
      <div class="stepper-card" id="cashback-stepper">
        <div class="stepper-title">
          <span class="cashback-accent-icon">💳</span>
          Cashback Lifecycle: From Clickout to Bank Payout
        </div>
        <div class="steps-container">
          <div class="step active" data-step="1">
            <div class="step-num">1</div>
            <div class="step-body">
              <div class="step-label">Signed Clickout</div>
              <div class="step-desc">Member clicks merchant deal. Go issues HMAC signed redirect token to prevent fraud.</div>
            </div>
          </div>
          <div class="step" data-step="2">
            <div class="step-num">2</div>
            <div class="step-body">
              <div class="step-label">Network Conversion Callback</div>
              <div class="step-desc">Affiliate network (Awin/local) fires webhook. Idempotent deduplication guarantees no double-credit.</div>
            </div>
          </div>
          <div class="step" data-step="3">
            <div class="step-num">3</div>
            <div class="step-body">
              <div class="step-label">Blnk Double-Entry Hold (C-2)</div>
              <div class="step-desc">Commission credited as Pending hold during 30-day merchant goods return window.</div>
            </div>
          </div>
          <div class="step" data-step="4">
            <div class="step-num">4</div>
            <div class="step-body">
              <div class="step-label">Manual SEPA Bank Payout (C-4/C-5)</div>
              <div class="step-desc">Confirmed balances above €5 paid via manual SEPA wire with dual-operator approval.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Co-Founder Strategic Decisions -->
  <section class="decisions-section">
    <div class="domain-header">
      <h2 class="domain-title">
        <span>🚀</span> Immediate Co-Founder Milestones &amp; Decisions
      </h2>
      <div class="env-badge">Active Horizon</div>
    </div>

    <div class="decisions-grid">
      <div class="decision-card">
        <h4>1. German Commercial Entity</h4>
        <p>
          Finalize commercial corporate entity (GmbH/UG) for affiliate network contracting and SEPA merchant agreements.
        </p>
        <span class="decision-pill">Corporate &amp; Legal</span>
      </div>

      <div class="decision-card">
        <h4>2. Publisher Feed Licensing</h4>
        <p>
          Formalize commercial reuse agreements with Greek national publishers and Munich regional news outlets for bounded extracts.
        </p>
        <span class="decision-pill">Legal / Editorial</span>
      </div>

      <div class="decision-card">
        <h4>3. Corporate Bank Account</h4>
        <p>
          Designate operating business bank account for manual SEPA payout disbursements to early beta members.
        </p>
        <span class="decision-pill">Finance &amp; Ops</span>
      </div>
    </div>
  </section>
</div>

<style>
  :root {
    --bg-main: rgb(6, 9, 19);
    --bg-surface: rgb(12, 18, 34);
    --bg-card: rgb(19, 28, 49);
    --bg-card-hover: rgb(25, 37, 64);
    --border-subtle: rgb(30, 45, 77);
    --border-bright: rgb(45, 65, 109);
    --text-primary: rgb(248, 250, 252);
    --text-secondary: rgb(148, 163, 184);
    --text-muted: rgb(100, 116, 139);
    --accent-news: rgb(0, 210, 180);
    --accent-news-glow: rgba(0, 210, 180, 0.15);
    --accent-cashback: rgb(245, 158, 11);
    --accent-cashback-glow: rgba(245, 158, 11, 0.15);
    --accent-platform: rgb(139, 92, 246);
    --status-live: rgb(16, 185, 129);
    --status-warn: rgb(245, 158, 11);
    --status-info: rgb(56, 189, 248);
  }

  .executive-module-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .tabs-bar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: rgb(255, 255, 255);
    border-color: var(--border-bright);
  }

  .tab-btn.active {
    background: var(--bg-card);
    color: rgb(255, 255, 255);
    border-color: var(--status-info);
  }

  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .domain-grid {
      grid-template-columns: 1fr;
    }
  }

  .domain-column {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .domain-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .domain-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgb(255, 255, 255);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .domain-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .domain-tag.news {
    background: var(--accent-news-glow);
    color: var(--accent-news);
  }

  .domain-tag.cashback {
    background: var(--accent-cashback-glow);
    color: var(--accent-cashback);
  }

  .feature-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .feature-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: rgb(255, 255, 255);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .feature-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .code-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    background: rgba(0, 0, 0, 0.4);
    color: rgb(0, 210, 180);
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    margin-top: 0.75rem;
    border: 1px solid rgba(0, 210, 180, 0.2);
  }

  .invariants-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .inv-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.775rem;
  }

  .inv-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.675rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .inv-badge.green {
    background: rgba(16, 185, 129, 0.15);
    color: var(--status-live);
  }

  .inv-badge.amber {
    background: rgba(245, 158, 11, 0.15);
    color: var(--status-warn);
  }

  .inv-text {
    color: var(--text-secondary);
  }

  .split-bar-wrap {
    display: flex;
    margin-top: 0.75rem;
    border-radius: 6px;
    overflow: hidden;
    height: 28px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 28px;
    text-align: center;
  }

  .split-segment.member {
    flex: 7;
    background: rgb(245, 158, 11);
    color: rgb(6, 9, 19);
  }

  .split-segment.platform {
    flex: 3;
    background: rgb(56, 189, 248);
    color: rgb(6, 9, 19);
  }

  /* Steppers */
  .stepper-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 2rem;
  }

  .steppers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .stepper-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .stepper-title {
    font-size: 1rem;
    font-weight: 700;
    color: rgb(255, 255, 255);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }

  .step {
    display: flex;
    gap: 1rem;
    cursor: pointer;
    padding: 0.75rem;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .step:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .step.active {
    background: rgba(255, 255, 255, 0.06);
    border-left: 3px solid var(--status-info);
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-surface);
    border: 1px solid var(--border-bright);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step.active .step-num {
    background: var(--status-info);
    color: rgb(6, 9, 19);
    border-color: var(--status-info);
  }

  .step-body {
    flex: 1;
  }

  .step-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(255, 255, 255);
    margin-bottom: 0.25rem;
  }

  .step-desc {
    font-size: 0.775rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Decisions */
  .decisions-section {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 2rem;
  }

  .decisions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .decision-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .decision-card h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: rgb(255, 255, 255);
    margin-bottom: 0.5rem;
  }

  .decision-card p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .decision-pill {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(139, 92, 246, 0.15);
    color: rgb(167, 139, 250);
  }
</style>

<script>
  // Tab Filtering for Executive Domains
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const domainSections = document.querySelectorAll<HTMLElement>('.domain-column');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const target = tab.getAttribute('data-target');

      domainSections.forEach((sec) => {
        const domain = sec.getAttribute('data-domain');
        if (target === 'all' || target === domain) {
          sec.style.display = 'flex';
        } else {
          sec.style.display = 'none';
        }
      });
    });
  });

  // Interactive Steppers
  function setupStepper(stepperId: string) {
    const stepper = document.getElementById(stepperId);
    if (!stepper) return;
    const steps = stepper.querySelectorAll<HTMLElement>('.step');

    steps.forEach((step) => {
      step.addEventListener('click', () => {
        steps.forEach((s) => s.classList.remove('active'));
        step.classList.add('active');
      });
    });
  }

  setupStepper('news-stepper');
  setupStepper('cashback-stepper');
</script>

