---
import Masthead from './Masthead.astro';
import type { ReadingLanguage } from '../lib/reader/axes';
import { frontPagePath } from '../lib/reader/axes';
import { cataloguePath, walletPath } from '../lib/cashback/paths';
import { cashbackStrings } from '../i18n/cashback';

// The cashback top bar — mockups 4a/4b: the wordmark, a vertical rule, the
// section links with the current one underlined in accent, and a muted line
// on the right (who is signed in, or how many partners the catalogue has).
//
// The wordmark comes from Masthead, which is where the product name already
// lives and is budgeted by the brand-literal lint; this component adds no
// literal of its own. Directory and Routes, which the mockup lists, are not
// products in this repository and are not linked (#447).
interface Props {
  lang: ReadingLanguage;
  slugs: readonly string[];
  current: 'catalogue' | 'wallet' | 'merchant';
  /** The muted line at the right edge. */
  aside?: string | undefined;
}

const { lang, slugs, current, aside } = Astro.props;
const t = cashbackStrings(lang);
const homeHref = frontPagePath(lang, slugs);
const links = [
  { key: 'news', href: homeHref, label: t.news, on: false },
  { key: 'catalogue', href: cataloguePath(lang, slugs), label: t.cashback, on: current === 'catalogue' || current === 'merchant' },
  { key: 'wallet', href: walletPath(lang, slugs), label: t.wallet, on: current === 'wallet' },
] as const;
---

<Masthead homeHref={homeHref}>
  <span class="rule" aria-hidden="true"></span>
  <nav class="links section-links" aria-label={t.cashback}>
    {links.map((link) => (
      <a href={link.href} class:list={['link', { on: link.on }]} aria-current={link.on ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  {aside !== undefined && aside !== '' && <span class="aside">{aside}</span>}
</Masthead>

<style>
  /*
   * The mockup's bar, applied to the shared masthead from here so every
   * cashback page gets the same one: 18px between wordmark, rule and links,
   * a 22px wordmark, 14px 26px padding. Set once on the masthead through
   * :global rather than restated in each page - two of the four pages had
   * tightened it and two had not, which is how the bar came to differ by
   * two hundred pixels between the catalogue and the wallet.
   */
  :global(.masthead:has(.section-links)) {
    gap: 18px;
    padding: 14px 26px;
  }
  :global(.masthead:has(.section-links) .brand) {
    font-size: 22px;
    letter-spacing: -0.03em;
  }
  .rule { width: 1px; height: 16px; background: var(--color-divider); }
  .links { display: flex; gap: 18px; font-size: 13.5px; }
  .link { color: var(--color-text); text-decoration: none; padding-bottom: 2px; border-bottom: 2px solid transparent; white-space: nowrap; }
  .link.on { color: var(--color-accent); font-weight: 600; border-bottom-color: var(--color-accent); }
  .aside { margin-left: auto; font-size: 12px; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
  /*
   * The mockup's phone frames carry no section links at all - each phone
   * screen has its own back link. Three links beside the wordmark do not fit
   * 390px without wrapping one of them mid-phrase, so on a phone they become
   * a row of their own under the wordmark, and the rule and aside go.
   */
  @media (max-width: 660px) {
    :global(.masthead:has(.section-links)) { flex-wrap: wrap; row-gap: 10px; padding: 12px 18px; }
    .rule { display: none; }
    .aside { display: none; }
    .links { flex-basis: 100%; gap: 16px; font-size: 13px; }
  }
</style>
