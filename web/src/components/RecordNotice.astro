---
import type { RecordNoticeModel } from '../lib/editorial/notices';

// The one shape every behaviour explanation takes (#121): a label, what
// happened (or refused to, or is about to be reviewed), and the frozen
// facts echoed from the response beneath. Tones map to live-region roles:
// a recorded outcome is a status, a refusal (nothing written) is an
// alert, and pre-action context is a note.
interface Props {
  notice: RecordNoticeModel;
  /**
   * An adjacent action offered beside the words — offered, never
   * performed (e.g. the way back to sign-in after an expired session).
   */
  action?: { href: string; label: string } | undefined;
}

const { notice, action } = Astro.props;
const role =
  notice.tone === 'refused' ? 'alert' : notice.tone === 'recorded' ? 'status' : 'note';
---

<div class:list={['record-notice', `tone-${notice.tone}`]} role={role}>
  <span class="label">{notice.label}</span>
  <span class="body">{notice.body}</span>
  {
    notice.record.length > 0 && (
      <span class="record">
        {notice.record.map((line) => (
          <span class="record-line">{line}</span>
        ))}
      </span>
    )
  }
  {
    action !== undefined && (
      <a class="action" href={action.href}>
        {action.label}
      </a>
    )
  }
</div>

<style>
  .record-notice {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-6);
  }
  .tone-recorded {
    background: var(--color-accent-700);
    color: var(--color-bg);
  }
  .tone-refused {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .tone-context {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
    color: var(--color-text);
  }
  .label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    flex: none;
  }
  .tone-refused .label {
    color: var(--color-accent-400);
  }
  .tone-context .label {
    background: var(--color-text);
    color: var(--color-accent-400);
    padding: 2px var(--space-2);
  }
  .body {
    font-size: 13px;
    max-width: 80ch;
  }
  .record {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11.5px;
  }
  .tone-context .record {
    color: var(--ink-muted);
  }
  .action {
    font-size: 13px;
    color: var(--color-accent-400);
  }
  .tone-context .action {
    color: var(--color-accent-700);
  }
</style>
