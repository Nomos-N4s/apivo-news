---
import { PUBLIC_APP_VERSION } from 'astro:env/server';
import type { ReadingLanguage } from '../lib/reader/axes';
import { DEFAULT_FRONT_PAGE } from '../lib/reader/axes';
import { OPS_PATHS } from '../lib/cashback/paths';
import { sessionOf } from '../lib/editorial/session';
import { uiStrings } from '../lib/reader/strings';

// The footer every screen shares. Beyond closing the page, it carries the
// two statements this product owes its readers: what the licence permits
// (passed as `note` on reader pages) and where the legal notices live.
//
// The imprint and privacy notice are legally owed, not decorative — a
// German-facing service needs an Impressum (TMG §5) and a GDPR privacy
// notice. Their places were held here as dead text for a month, named as
// still owed, because the pages did not exist; they exist now and this
// line links them (issue #64). The "still owed" string went with them —
// a catalogue key nothing renders is copy nobody maintains.
interface Props {
  lang: ReadingLanguage;
  note?: string | undefined;
  /**
   * Where the brand leads. Pages that hold both axes pass their own
   * front page, so the footer never quietly changes the reader's
   * language or followed places; screens with no axes of their own fall
   * back to the flagship journey.
   */
  homeHref?: string | undefined;
}

const { lang, note, homeHref } = Astro.props;
const home = homeHref ?? DEFAULT_FRONT_PAGE;
const t = uiStrings(lang);
const year = new Date().getUTCFullYear();

// The deployed release version (issue #119), handed to the container by the
// release pipeline. Absent means this deployment was not cut by a release
// tag, and the footer stays silent about it — rendering a placeholder would
// claim a release that never happened.
//
// Blank is the same statement as absent: `--var PUBLIC_APP_VERSION:` reaches
// the container as an empty string, and whitespace survives a copy-paste
// into the dashboard. Both said the same thing as unset — nothing — but only
// unset rendered nothing; the empty value rendered a dangling "·" separator
// with no version after it. Trim first, then decide, so a deployment that
// cannot name its version shows no version rather than punctuation.
// The operator way in (#447 follow-up). Nothing linked /ops from anywhere:
// an operator typed the URL, which is the failure the editorial link above
// was added to fix.
//
// Read from the request rather than taken as a prop, because the session is
// already resolved once per request by the middleware and threading a role
// through every layout and page would be five call sites that can disagree.
// `sessionOf` fails closed — an unresolved request answers "nobody is
// signed in" — so on a plain reader page, where the middleware deliberately
// resolves no identity to keep a crawler's 403 off the auth path, this is
// simply false and no link is drawn.
const isOperator = sessionOf(Astro.request).role === 'operator';

const trimmedVersion = PUBLIC_APP_VERSION?.trim();
const version = trimmedVersion === undefined || trimmedVersion === '' ? undefined : trimmedVersion;
---

<footer class="site-footer">
  {note !== undefined && <p class="note">{note}</p>}
  <div class="row">
    <a class="brand" href={home}>epilo<span class="brand-yes">YES</span></a>
    <span class="tag tag-neutral alpha">{t.alphaLabel}</span>
    <a class="about" href={`/${lang}/about`}>{t.aboutLabel}</a>
    {/* Reuses `about`'s class deliberately: it already carries the row's one
        label size and the 24px touch-target floor. A new class with no
        font-size is how `.editorial` came to render at 15px beside 11.5px
        siblings. */}
    <a class="about" href={`/${lang}/faq`}>{t.faqLabel}</a>
    {/* The way in for editorial staff. The sign-in control on the front
        page is the READER's, and it is a disabled placeholder for a
        capability still on the cut list — so until this link existed, the
        only route to the editorial screens was typing the URL. Here rather
        than in the masthead because it is for the few, not the many. */}
    <a class="editorial" href={`/${lang}/editor/signin`}>{t.editorialLabel}</a>
    {
      isOperator && (
        <a class="editorial" href={`${OPS_PATHS.unattributed}?lang=${lang}`}>
          {t.operationsLabel}
        </a>
      )
    }
    <p class="legal">
      <a href={`/${lang}/impressum`}>{t.imprint}</a>
      <span aria-hidden="true">·</span>
      <a href={`/${lang}/privacy`}>{t.privacy}</a>
      <span aria-hidden="true">·</span>
      <a href={`/${lang}/contact`}>{t.contact}</a>
    </p>
    <span class="copy">
      © {year} epiloYES{version !== undefined && <span class="version">· {version}</span>}
    </span>
  </div>
</footer>

<style>
  .editorial {
    font-size: var(--footer-label);
    color: var(--color-text);
    opacity: 0.7;
    /* 24px touch-target floor, same treatment as the brand (SC 2.5.8). */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .editorial:hover,
  .editorial:focus-visible {
    opacity: 1;
  }

  .site-footer {
    border-top: 2px solid var(--color-divider);
    /* Three roles, three sizes, declared once. The row had five: the
       wordmark at 15px, labels at 11.5px, the version at 10.5px, the alpha
       tag at 10px — and `.editorial`, which never set a size at all and so
       inherited the body's 15px, rendering as large as the wordmark beside
       its 11.5px siblings. A local token means the next item added to this
       row cannot quietly introduce a sixth. */
    --footer-label: 11.5px;
    --footer-fine: 10px;
  }
  .note {
    margin: 0;
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
    border-bottom: 1px solid var(--color-divider);
    font-size: var(--footer-label);
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    /* 24px touch-target floor without moving the text (SC 2.5.8). */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .brand-yes {
    color: var(--color-accent);
  }
  .alpha {
    font-size: var(--footer-fine);
  }
  .about {
    font-size: var(--footer-label);
    /* 24px touch-target floor, same treatment as the brand (SC 2.5.8). */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .legal {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--footer-label);
    color: var(--ink-soft);
  }
  .copy {
    margin-left: auto;
    font-size: var(--footer-label);
    color: var(--ink-soft);
  }
  .version {
    font-family: var(--font-mono, monospace);
    font-size: var(--footer-fine);
  }
</style>
