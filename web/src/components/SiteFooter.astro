---
import { PUBLIC_APP_VERSION } from 'astro:env/server';
import type { ReadingLanguage } from '../lib/reader/axes';
import { DEFAULT_FRONT_PAGE } from '../lib/reader/axes';
import { uiStrings } from '../lib/reader/strings';

// The footer every screen shares. Beyond closing the page, it carries the
// two statements this product owes its readers: what the licence permits
// (passed as `note` on reader pages) and where the legal notices live.
//
// The imprint and privacy notice are legally owed, not decorative — a
// German-facing service needs an Impressum (TMG §5) and a GDPR privacy
// notice — so their places are held and named as still owed rather than
// linked to pages that do not exist (issue #64).
interface Props {
  lang: ReadingLanguage;
  note?: string | undefined;
  /**
   * Where the brand leads. Pages that hold both axes pass their own
   * front page, so the footer never quietly changes the reader's
   * language or followed places; screens with no axes of their own fall
   * back to the flagship journey.
   */
  homeHref?: string | undefined;
}

const { lang, note, homeHref } = Astro.props;
const home = homeHref ?? DEFAULT_FRONT_PAGE;
const t = uiStrings(lang);
const year = new Date().getUTCFullYear();

// The deployed release version (issue #119), handed to the container by the
// release pipeline. Absent means this deployment was not cut by a release
// tag, and the footer stays silent about it — rendering a placeholder would
// claim a release that never happened.
const version = PUBLIC_APP_VERSION;
---

<footer class="site-footer">
  {note !== undefined && <p class="note">{note}</p>}
  <div class="row">
    <a class="brand" href={home}>epilo<span class="brand-yes">YES</span></a>
    <span class="tag tag-neutral alpha">{t.alphaLabel}</span>
    <a class="about" href={`/${lang}/about`}>{t.aboutLabel}</a>
    <p class="legal">
      <span>{t.imprint}</span>
      <span aria-hidden="true">·</span>
      <span>{t.privacy}</span>
      <span aria-hidden="true">·</span>
      <span>{t.contact}</span>
      <em>— {t.legalPending}</em>
    </p>
    <span class="copy">
      © {year} epiloYES{version !== undefined && <span class="version">· {version}</span>}
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--color-divider);
  }
  .note {
    margin: 0;
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
    border-bottom: 1px solid var(--color-divider);
    font-size: 11.5px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-4) calc(var(--space-6) + var(--space-1));
  }
  .brand {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    /* 24px touch-target floor without moving the text (SC 2.5.8). */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .brand-yes {
    color: var(--color-accent);
  }
  .alpha {
    font-size: 10px;
  }
  .about {
    font-size: 11.5px;
    /* 24px touch-target floor, same treatment as the brand (SC 2.5.8). */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .legal {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: 11.5px;
    color: var(--ink-soft);
  }
  .legal em {
    font-style: normal;
    color: var(--ink-soft);
  }
  .copy {
    margin-left: auto;
    font-size: 11.5px;
    color: var(--ink-soft);
  }
  .version {
    font-family: var(--font-mono, monospace);
    font-size: 10.5px;
  }
</style>
