---
import '../styles/modernist.css';
import type { ReadingLanguage } from '../lib/reader/axes';

// The shell every reader page shares: the document, the Modernist
// stylesheet, and the page frame. The frame runs the full viewport width —
// the mockups' 1280 canvas was the design surface, not a cap (founder
// direction 2026-08-15); text measures are bounded per element with ch
// widths, so wide screens gain grid, not unreadable lines.
interface Props {
  lang: ReadingLanguage;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="frame">
      <slot />
    </div>
  </body>
</html>

<style>
  .frame {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
</style>
