# Where each environment answers. Committed, and the ONLY place these are
# written down.
#
# Nothing here is a secret — a public base URL is public by construction —
# and putting it in git rather than in a settings screen is the same rule
# this repository already holds for its deployment configuration: a value
# that lives only in a dashboard is a value with no history, no review and no
# diff when it changes. Two things read this file:
#
#   .github/workflows/release.yml   to know where to probe a release, and to
#                                   refuse a production release while there
#                                   is no production
#   scripts/env_status.sh           to answer "what is actually running
#                                   where", for anyone or anything without a
#                                   shell on a host
#
# An empty value means that environment does not exist yet. That is a real
# state and the tooling treats it as one, rather than as a misconfiguration:
# there is no production host today, and a final semver tag is refused for
# exactly that reason until APIVO_PROD_URL is filled in.
#
# The three domains available cover every environment as subdomains of one of
# them, which leaves the other two free to be whatever they should be rather
# than being spent one per environment.

# Every push to main, within about a minute of the images being published.
APIVO_QA_URL=

# Release candidates only: v0.2.0-rc.1 and friends.
APIVO_STAGING_URL=

# Final semver tags, behind an approval gate.
#
# EMPTY ON PURPOSE. There is no production VPS, no production Supabase
# project and no production DNS record. Filling this in is the last step of
# provisioning that host, and it is what makes a final release possible —
# see docs/ENVIRONMENTS.md.
APIVO_PROD_URL=

# The suffix per-pull-request previews are served under, so a preview lives at
# pr-142.<this>. Empty means previews are not served; CI still publishes their
# images and says so, and no host picks them up.
#
# The origin certificate must cover *.<this>. A Cloudflare Origin Certificate
# takes a wildcard alongside the other names, so this costs no ACME and no DNS
# token on the host.
APIVO_PREVIEW_DOMAIN=
