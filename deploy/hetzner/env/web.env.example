# /etc/apivo/<env>/web.env — 0640 root:root
#
# The Astro server's configuration, read by the Docker daemon as the web
# service's `env_file`.
#
# Neither key here is a credential. The anon key identifies the Supabase
# project and grants nothing on its own — the database's row-level policies
# and the api's JWT verification are what grant anything. The file is 0640
# rather than 0600 only because nothing in it needs to be tighter, not
# because anything in it is public property.
#
# HOST, PORT, API_BASE_URL and PUBLIC_APP_VERSION are absent on purpose:
# compose sets them. API_BASE_URL in particular is derived from APIVO_ENV so
# that an environment cannot be pointed at another environment's API by a
# typo in a file — on this deployment it is a private hop across the compose
# network by container name, http://apivo-<env>-api:8080.

# ---------------------------------------------------------------------------
# Supabase Auth for the editorial sign-in. The matching half of the api's
# JWKS_URL: the web signs the editor in, the api verifies the token that
# sign-in produced. Point both at the SAME project, and at this
# environment's own project — never at another environment's.
#
# Left EMPTY the sign-in page says the deployment has no auth configured and
# the editorial screens keep their fixture preview. That is a legitimate
# state for QA before an editorial change is being worked on, and it is a
# misconfiguration anywhere else.
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# BRAND_DIR - the directory holding this deployment's brand definition
# (ADR-0004), read by the web for the legal notices (the entity, the
# address, the jurisdiction, the support mailboxes) and for the terms a
# member accepts when they opt into cashback. The same directory and the
# same file the api reads: docker-compose.yml mounts
# /etc/apivo/<env>/brand into this container at /etc/apivo/brand, read-only,
# so the only value that is ever right here is the container path, and only
# once the file exists:
#
#   BRAND_DIR=/etc/apivo/brand
#
# Empty, the web renders the repository's fixture brand in development and
# REFUSES to in production mode, which every Apivo environment runs: the
# legal pages and the opt-in answer an error rather than print a fictional
# company as the provider identification. Set it when api.env's BRAND_DIR
# is set, to the same value.
# ---------------------------------------------------------------------------
BRAND_DIR=
