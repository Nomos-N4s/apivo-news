# /etc/apivo/<env>/stack.env — 0640 root:root
#
# The STRUCTURAL configuration of one environment: which channel it tracks,
# which compose files describe it, how much of the host it may use. Sourced
# by the reconciler and used for compose interpolation.
#
# This file is NOT where application secrets go. DATABASE_URL and the
# translation credential live in api.env, which the Docker daemon reads
# directly (`env_file:`) so those values never enter the reconciler's process
# environment nor `docker compose config` output. The one exception below is
# APIVO_PG_PASSWORD, which compose must interpolate into the QA Postgres
# container's own environment — a throwaway credential for a database that
# holds nothing but fixtures and is on a network marked `internal: true`.
#
# provision.sh writes a filled-in copy of this file. Copy the block for the
# environment you are provisioning.

# ---------------------------------------------------------------------------
# Which environment this is. Drives every container name, network name and
# volume name in the compose files, so it must match the directory this file
# lives in and the systemd unit instance (apivo-reconcile@qa -> qa).
# ---------------------------------------------------------------------------
APIVO_ENV=qa

# ---------------------------------------------------------------------------
# What this environment TRACKS. The reconciler resolves this tag to a digest
# on every tick and rolls forward when the digest changes.
#
#   qa        every push to main
#   staging   release-candidate tags (v0.2.0-rc.1)
#   prod      final semver tags (v0.2.0)
#
# The publish workflow moves these tags; nothing else may. A tag is what an
# environment tracks, a digest is what it runs — see docs/ENVIRONMENTS.md.
# ---------------------------------------------------------------------------
APIVO_CHANNEL=qa
APIVO_REGISTRY=ghcr.io/nomos-n4s/apivo-news

# ---------------------------------------------------------------------------
# Which compose files describe this environment. Colon-separated, absolute,
# and read by docker compose itself (COMPOSE_FILE is its own variable).
#
#   qa                 docker-compose.yml:docker-compose.local-db.yml
#   staging and prod   docker-compose.yml
#
# The difference is the whole difference between QA and the rest: QA runs a
# Postgres container on this host, the others reach their own Supabase EU
# project.
#
# Appending docker-compose.cashback.yml adds the Blnk ledger and Redis
# (ADR-0002) and turns the cashback routes on. Listing that file IS the
# decision to run cashback here — there is no second switch in api.env, on
# purpose, because two switches for one thing disagree eventually:
#
#   /opt/apivo/compose/docker-compose.yml:/opt/apivo/compose/docker-compose.local-db.yml:/opt/apivo/compose/docker-compose.cashback.yml
#
# Add it only once the environment has a `blnk` role and schema in its
# database and BLNK_DATA_SOURCE_DNS is filled in (deploy/hetzner/env/blnk.env.example).
# ---------------------------------------------------------------------------
COMPOSE_FILE=/opt/apivo/compose/docker-compose.yml:/opt/apivo/compose/docker-compose.local-db.yml

# There is deliberately NO public-URL key here. An earlier draft carried
# APIVO_PUBLIC_URL and nothing ever read it: scripts/env_status.sh takes the
# public base URLs from deploy/hetzner/environments.env, which is committed
# and reviewable, not from a file that exists only on the host. A key that
# looks authoritative and is read by nothing is worse than no key, because
# editing it looks like a fix.

# ---------------------------------------------------------------------------
# QA's Postgres container ONLY. Absent in staging and prod, where the whole
# local-db overlay is absent too. Generated by provision.sh; it protects
# fixture data on an internal network and is not worth rotating on a
# schedule, but it must not be a value anybody typed from memory.
# ---------------------------------------------------------------------------
APIVO_PG_PASSWORD=generated-by-provision.sh
APIVO_PG_DB=apivo
APIVO_PG_USER=apivo

# ---------------------------------------------------------------------------
# What this environment may take from the host. Two environments share the
# pre-production VPS, so these are not decoration: without them a runaway
# translation loop in QA starves Staging on the same box, and the first
# symptom is a staging release that fails its probe for no visible reason.
#
# The defaults below suit a CX32-class Hetzner box (4 vCPU / 8 GB) carrying
# QA and Staging together. Production, alone on its own host, can be given
# more.
# ---------------------------------------------------------------------------
APIVO_API_CPUS=1.0
APIVO_API_MEMORY=768M
APIVO_WEB_CPUS=1.0
APIVO_WEB_MEMORY=512M
APIVO_PG_CPUS=1.0
APIVO_PG_MEMORY=768M

# The cashback overlay's containers. Absent unless this environment lists
# docker-compose.cashback.yml above, where every one of these has the default
# shown. Three more containers on a box that already carries two environments
# is exactly the situation these limits exist for: without them a Blnk queue
# backlog in QA starves Staging on the same host, and the first symptom is a
# staging release failing its probe for no visible reason.
#
# Redis is given the least of the three deliberately — it is a queue and a
# cache with no persistence, and it is configured to REFUSE writes rather than
# evict when full, so a low ceiling surfaces as an error somebody sees.
APIVO_BLNK_CPUS=1.0
APIVO_BLNK_MEMORY=512M
APIVO_BLNK_WORKER_CPUS=1.0
APIVO_BLNK_WORKER_MEMORY=512M
APIVO_REDIS_CPUS=0.5
APIVO_REDIS_MEMORY=256M
# Redis's own ceiling, which must stay comfortably under APIVO_REDIS_MEMORY:
# the container limit kills the process, the Redis limit returns an error.
APIVO_REDIS_MAXMEMORY=192mb

# Log rotation for every container in this environment. A VPS has a finite
# disk and nothing sweeping it; unbounded json-file logging is the most
# common way a small host runs out of space, and it takes every environment
# on the box down together.
APIVO_LOG_MAX_SIZE=10m
APIVO_LOG_MAX_FILE=3
