# The edge's two files. One Caddy per host, in front of every environment on
# it, so these live at /etc/apivo/edge/ rather than under an environment.
#
# ===========================================================================
# /etc/apivo/edge/stack.env — 0640 root:root
#
# Sourced before `docker compose` runs against the edge stack.
# ===========================================================================

# Which role this host plays. The only difference between the two is which
# overlay attaches Caddy to which environment networks, and which Caddyfile
# provision.sh installs.
#
#   preprod   QA + Staging (the VPS that exists today)
#   prod      production, alone (no such host yet)
APIVO_HOST_ROLE=preprod

COMPOSE_FILE=/opt/apivo/compose/docker-compose.edge.yml:/opt/apivo/compose/docker-compose.edge.preprod.yml

APIVO_EDGE_CPUS=1.0
APIVO_EDGE_MEMORY=256M
APIVO_LOG_MAX_SIZE=10m
APIVO_LOG_MAX_FILE=3

# ===========================================================================
# /etc/apivo/edge/caddy.env — 0640 root:root
#
# Read by the Caddy container. These are the site addresses in the Caddyfile.
# Caddy REFUSES TO START on an unset {$VAR} in a site address, which is the
# failure mode to want: a proxy that cannot name what it serves must not
# start and serve something nobody meant.
#
# Three domains are available. Subdomains of one of them cover every
# environment, so the other two are free to be whatever they should be —
# brand protection, a redirect, or the eventual reader-facing name — rather
# than being spent one-per-environment.
# ===========================================================================

# --- on a preprod host ---
APIVO_QA_HOST=qa.example.com
APIVO_STAGING_HOST=staging.example.com

# --- on a prod host (unset the two above) ---
# The apex serves; the other name redirects to it. Pick which way round and
# then never revisit it: a site that answers on two names is a site with two
# canonical URLs, and search engines and cookie scopes both notice.
#APIVO_PROD_HOST=example.com
#APIVO_PROD_ALT_HOST=www.example.com
