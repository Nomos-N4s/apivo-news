// Cloudflare Containers configuration (plan Phase A, issue #8).
//
// The containers are the deployment artefact: the same images that run under
// compose and Kubernetes run here, unchanged. Nothing Cloudflare-specific
// enters application code — the one piece of glue the platform requires (a
// Worker whose Durable Object classes host the containers) lives in
// deploy/cloudflare/worker.js, next to the other deployment artefacts.
//
// Topology (specs/001-epiloyes-alpha/contracts/http-api.md): the Astro web
// container is the only public HTTP surface. The Go API container is never
// routed from the Worker's public fetch handler — it is addressable solely
// through its Durable Object binding, i.e. from Worker code, not from the
// internet.
//
// Secrets — set with `npx wrangler secret put <NAME>`, delivered to the
// Worker environment and handed to the container at start (see
// deploy/cloudflare/worker.js). No secret value is ever committed.
//
//   DATABASE_URL   Supabase (EU region) Postgres connection string for the
//                  Go API.
//
// Later phases add, through the same mechanism with no config change: the
// translation-provider API key and the Supabase Auth keys for the web SSR.
//
// Non-secret vars — plain configuration in "vars" below, handed to the API
// container by deploy/cloudflare/worker.js:
//
//   JWKS_URL       The auth provider's JWKS endpoint, e.g.
//                  https://<project>.supabase.co/auth/v1/.well-known/jwks.json
//                  NOT a secret: it names where PUBLIC keys are published.
//                  Required for the editorial endpoints — left EMPTY the API
//                  starts and serves readers normally, logs an ERROR line
//                  naming the consequence, and every /api/v1/editorial/ route
//                  answers 404.
//   JWT_AUDIENCE   Optional. When set, tokens must additionally carry this
//                  aud claim (Supabase access tokens carry "authenticated").
//                  Only meaningful alongside a non-empty JWKS_URL — setting
//                  it alone fails startup, by design.
//
// Both ship EMPTY on purpose. A placeholder hostname is a real value to the
// binary, so it would select the fail-fast verifier path and a fresh deploy
// would crash-loop until someone edited it; empty means exactly "not
// configured yet", and nothing in between can fake a configuration.
{
	"name": "apivo-news",
	"main": "deploy/cloudflare/worker.js",
	"compatibility_date": "2026-08-01",
	"vars": {
		"JWKS_URL": "",
		"JWT_AUDIENCE": ""
	},
	"containers": [
		{
			// Go API, built from the repo-root Dockerfile (T001). Internal
			// only: no public route exists to this container.
			"name": "apivo-api",
			"class_name": "ApiContainer",
			"image": "./Dockerfile",
			"instance_type": "basic",
			// Alpha scale (hundreds of readers): one instance each, exactly
			// like compose. No horizontal-scale work in alpha.
			"max_instances": 1,
			// GDPR residency: run only in EU regions (EEUR/WEUR).
			"constraints": {
				"jurisdiction": "eu"
			}
		},
		{
			// Astro web frontend (T002) — the single public surface, carrying
			// the D6 crawler gate inside the artefact.
			"name": "apivo-web",
			"class_name": "WebContainer",
			"image": "./web/Dockerfile",
			"instance_type": "basic",
			"max_instances": 1,
			"constraints": {
				"jurisdiction": "eu"
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "API", "class_name": "ApiContainer" },
			{ "name": "WEB", "class_name": "WebContainer" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ApiContainer", "WebContainer"] }
	]
}
